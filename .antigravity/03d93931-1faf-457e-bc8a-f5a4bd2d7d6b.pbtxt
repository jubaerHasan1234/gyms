    end_line: 99
    content: "import React from \'react\';\n\n/**\n * ShapePatternSvg reproduces the exact decorative droplet / bowl capsule patterns\n * from the uploaded screenshot.\n *\n * Each droplet in the prompt is a horizontal half-capsule / bowl:\n * - Straight flat top edge\n * - Smooth downward rounded semicircular curve\n * - Width ~ 16px, Height ~ 8px\n *\n * Coordinates match the columns directly beneath Follow On: [f] [IG] [X] [in]\n */\nconst ShapePatternSvg: React.FC = () => {\n  // Exact bowl droplet path: flat top horizontal, rounded semicircle bowl at the bottom\n  const renderBowl = (x: number, y: number, key: string, fill = \"#585B62\") => (\n    <path\n      key={key}\n      d={`M ${x} ${y} h 16 q 1 0 1 1 v 0.5 c 0 6.5 -8 6.5 -8 6.5 s -8 0 -8 -6.5 v -0.5 q 0 -1 1 -1 z`}\n      fill={fill}\n      opacity={0.88}\n    />\n  );\n\n  /**\n   * Exact positions from the prompt image:\n   * Col 1 (beneath \"Follow On:\"):\n   *   y: 8, y: 22\n   * Col 2 (between Follow On and \'f\'):\n   *   y: 15, y: 29\n   * Col 3 (aligned with \'f\' lower):\n   *   y: 24\n   * Col 4 (beneath \'f\'):\n   *   y: 5, y: 33, y: 47\n   * Col 5 (beneath \'IG\'):\n   *   y: 1, y: 15, y: 43, y: 57\n   * Col 6 (beneath \'X\'):\n   *   y: 10, y: 20, y: 47, y: 61\n   * Col 7 (beneath \'in\'):\n   *   y: 10, y: 31, y: 47, y: 61\n   */\n  const droplets = [\n    // Column 1 (below Follow On)\n    { x: 4, y: 9 },\n    { x: 4, y: 22 },\n\n    // Column 2 (offset)\n    { x: 26, y: 16 },\n    { x: 26, y: 29 },\n\n    // Column 3 (further down)\n    { x: 48, y: 24 },\n\n    // Column 4 (under \'f\')\n    { x: 70, y: 7 },\n    { x: 70, y: 34 },\n    { x: 70, y: 47 },\n\n    // Column 5 (under \'IG\')\n    { x: 92, y: 2 },\n    { x: 92, y: 15 },\n    { x: 92, y: 43 },\n    { x: 92, y: 56 },\n\n    // Column 6 (under \'X\')\n    { x: 114, y: 10 },\n    { x: 114, y: 20 },\n    { x: 114, y: 47 },\n    { x: 114, y: 60 },\n\n    // Column 7 (under \'in\')\n    { x: 136, y: 10 },\n    { x: 136, y: 30 },\n    { x: 136, y: 47 },\n    { x: 136, y: 60 },\n  ];\n\n  return (\n    <div className=\"absolute inset-0 pointer-events-none z-10 overflow-hidden select-none\">\n      {/* Top-Left Pattern inside Black Hero (below social row) matching exact uploaded screenshot */}\n      <svg\n        className=\"absolute pointer-events-none\"\n        style={{\n          top: \"23.8%\",\n          left: \"7.2%\",\n          width: \"15.5cqw\",\n          height: \"8.5cqw\",\n        }}\n        viewBox=\"0 0 160 74\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n      >\n        {droplets.map((d, i) => renderBowl(d.x, d.y, `bowl-${i}`))}\n      </svg>\n    </div>\n  );\n};\n\nexport default ShapePatternSvg;\n"
    raw_content: "import React from \'react\';\n\n/**\n * ShapePatternSvg reproduces the exact decorative droplet / bowl capsule patterns\n * from the uploaded screenshot.\n *\n * Each droplet in the prompt is a horizontal half-capsule / bowl:\n * - Straight flat top edge\n * - Smooth downward rounded semicircular curve\n * - Width ~ 16px, Height ~ 8px\n *\n * Coordinates match the columns directly beneath Follow On: [f] [IG] [X] [in]\n */\nconst ShapePatternSvg: React.FC = () => {\n  // Exact bowl droplet path: flat top horizontal, rounded semicircle bowl at the bottom\n  const renderBowl = (x: number, y: number, key: string, fill = \"#585B62\") => (\n    <path\n      key={key}\n      d={`M ${x} ${y} h 16 q 1 0 1 1 v 0.5 c 0 6.5 -8 6.5 -8 6.5 s -8 0 -8 -6.5 v -0.5 q 0 -1 1 -1 z`}\n      fill={fill}\n      opacity={0.88}\n    />\n  );\n\n  /**\n   * Exact positions from the prompt image:\n   * Col 1 (beneath \"Follow On:\"):\n   *   y: 8, y: 22\n   * Col 2 (between Follow On and \'f\'):\n   *   y: 15, y: 29\n   * Col 3 (aligned with \'f\' lower):\n   *   y: 24\n   * Col 4 (beneath \'f\'):\n   *   y: 5, y: 33, y: 47\n   * Col 5 (beneath \'IG\'):\n   *   y: 1, y: 15, y: 43, y: 57\n   * Col 6 (beneath \'X\'):\n   *   y: 10, y: 20, y: 47, y: 61\n   * Col 7 (beneath \'in\'):\n   *   y: 10, y: 31, y: 47, y: 61\n   */\n  const droplets = [\n    // Column 1 (below Follow On)\n    { x: 4, y: 9 },\n    { x: 4, y: 22 },\n\n    // Column 2 (offset)\n    { x: 26, y: 16 },\n    { x: 26, y: 29 },\n\n    // Column 3 (further down)\n    { x: 48, y: 24 },\n\n    // Column 4 (under \'f\')\n    { x: 70, y: 7 },\n    { x: 70, y: 34 },\n    { x: 70, y: 47 },\n\n    // Column 5 (under \'IG\')\n    { x: 92, y: 2 },\n    { x: 92, y: 15 },\n    { x: 92, y: 43 },\n    { x: 92, y: 56 },\n\n    // Column 6 (under \'X\')\n    { x: 114, y: 10 },\n    { x: 114, y: 20 },\n    { x: 114, y: 47 },\n    { x: 114, y: 60 },\n\n    // Column 7 (under \'in\')\n    { x: 136, y: 10 },\n    { x: 136, y: 30 },\n    { x: 136, y: 47 },\n    { x: 136, y: 60 },\n  ];\n\n  return (\n    <div className=\"absolute inset-0 pointer-events-none z-10 overflow-hidden select-none\">\n      {/* Top-Left Pattern inside Black Hero (below social row) matching exact uploaded screenshot */}\n      <svg\n        className=\"absolute pointer-events-none\"\n        style={{\n          top: \"23.8%\",\n          left: \"7.2%\",\n          width: \"15.5cqw\",\n          height: \"8.5cqw\",\n        }}\n        viewBox=\"0 0 160 74\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n      >\n        {droplets.map((d, i) => renderBowl(d.x, d.y, `bowl-${i}`))}\n      </svg>\n    </div>\n  );\n};\n\nexport default ShapePatternSvg;\n"
    num_lines: 100
    num_bytes: 2568
  }
}
