    end_line: 36
    content: "import React from \'react\';\n\ninterface DropletPatternProps {\n  className?: string;\n  rows?: number;\n  cols?: number;\n  opacity?: number;\n}\n\n/**\n * Droplet / seed capsule grid pattern seen in the Figma design.\n */\nexport const DropletPattern: React.FC<DropletPatternProps> = ({\n  className = \'\',\n  rows = 4,\n  cols = 5,\n  opacity = 0.5,\n}) => {\n  return (\n    <div \n      className={`inline-grid gap-x-2 gap-y-1.5 select-none pointer-events-none ${className}`}\n      style={{\n        gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`,\n        opacity,\n      }}\n      aria-hidden=\"true\"\n    >\n      {Array.from({ length: rows * cols }).map((_, i) => (\n        <div\n          key={i}\n          className=\"w-1.5 h-2.5 rounded-full bg-current transform rotate-[-5deg]\"\n        />\n      ))}\n    </div>\n  );\n};\n"
    raw_content: "import React from \'react\';\n\ninterface DropletPatternProps {\n  className?: string;\n  rows?: number;\n  cols?: number;\n  opacity?: number;\n}\n\n/**\n * Droplet / seed capsule grid pattern seen in the Figma design.\n */\nexport const DropletPattern: React.FC<DropletPatternProps> = ({\n  className = \'\',\n  rows = 4,\n  cols = 5,\n  opacity = 0.5,\n}) => {\n  return (\n    <div \n      className={`inline-grid gap-x-2 gap-y-1.5 select-none pointer-events-none ${className}`}\n      style={{\n        gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`,\n        opacity,\n      }}\n      aria-hidden=\"true\"\n    >\n      {Array.from({ length: rows * cols }).map((_, i) => (\n        <div\n          key={i}\n          className=\"w-1.5 h-2.5 rounded-full bg-current transform rotate-[-5deg]\"\n        />\n      ))}\n    </div>\n  );\n};\n"
    num_lines: 37
    num_bytes: 808
  }
}
