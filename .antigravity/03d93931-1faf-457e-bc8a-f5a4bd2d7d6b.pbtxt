    content: "import React from \"react\";\n\n/**\n * VerticalDroplet:\n * D-shaped half capsule matching the reference screenshot:\n * Curved round LEFT side, straight vertical RIGHT side.\n */\ninterface DropletProps {\n  cx: number;\n  cy: number;\n  width?: number;\n  height?: number;\n  color?: string;\n}\n\nexport const VerticalDroplet: React.FC<DropletProps> = ({\n  cx,\n  cy,\n  width = 6,\n  height = 14,\n  color = \"#D1D5DB\",\n}) => {\n  const r = width;\n  return (\n    <path\n      d={`M ${cx + width} ${cy}\n          A ${r} ${height / 2} 0 0 0 ${cx + width} ${cy + height}\n          Z`}\n      fill={color}\n    />\n  );\n};\n\n/**\n * DropletSvgPattern:\n * Exact 4-column pattern from user screenshot:\n * Row 1 (top):       col3, col4\n * Row 2:             col2, col3\n * Row 3:             col2, col4\n * Row 4 (bottom):    col1, col2, col3\n */\nexport const DropletSvgPattern: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => (\n  <svg\n    className={`h-[48px] sm:h-[56px] md:h-[62px] w-[54px] sm:w-[62px] md:w-[70px] overflow-visible ${className}`}\n    viewBox=\"0 0 68 76\"\n    fill=\"none\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n  >\n    {/* Column 1 (x: 2) - bottom only */}\n    <VerticalDroplet cx={2} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 2 (x: 18) - rows 2, 3, 4 */}\n    <VerticalDroplet cx={18} cy={18} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={18} cy={36} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={18} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 3 (x: 34) - rows 1, 2, 4 */}\n    <VerticalDroplet cx={34} cy={0} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={34} cy={18} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={34} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 4 (x: 50) - rows 1, 3 */}\n    <VerticalDroplet cx={50} cy={0} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={50} cy={36} width={5.5} height={14} color={color} />\n  </svg>\n);\n\n/**\n * ProductDropletsOverlay:\n * Pure decorative droplet component containing JUST TWO ELEMENTS:\n * 1. Left side droplet (positioned right after the title)\n * 2. Right side droplet (positioned at the right edge)\n *\n * Exactly matches the reference design.\n */\nexport interface ProductDropletsOverlayProps {\n  color?: string;\n  className?: string;\n}\n\nexport const ProductDropletsOverlay: React.FC<ProductDropletsOverlayProps> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  return (\n    <div\n      className={`w-full relative [container-type:inline-size] flex items-end justify-between pointer-events-none select-none overflow-visible ${className}`}\n    >\n      {/* 1. Left Side Droplet - reduced margin on mobile, expanding up to desktop */}\n      <div \n        className=\"flex-shrink-0 -mb-1\"\n        style={{\n          marginLeft: \"clamp(24px, 16cqw, 230px)\",\n        }}\n      >\n        <DropletSvgPattern color={color} />\n      </div>"
    raw_content: "import React from \"react\";\n\n/**\n * VerticalDroplet:\n * D-shaped half capsule matching the reference screenshot:\n * Curved round LEFT side, straight vertical RIGHT side.\n */\ninterface DropletProps {\n  cx: number;\n  cy: number;\n  width?: number;\n  height?: number;\n  color?: string;\n}\n\nexport const VerticalDroplet: React.FC<DropletProps> = ({\n  cx,\n  cy,\n  width = 6,\n  height = 14,\n  color = \"#D1D5DB\",\n}) => {\n  const r = width;\n  return (\n    <path\n      d={`M ${cx + width} ${cy}\n          A ${r} ${height / 2} 0 0 0 ${cx + width} ${cy + height}\n          Z`}\n      fill={color}\n    />\n  );\n};\n\n/**\n * DropletSvgPattern:\n * Exact 4-column pattern from user screenshot:\n * Row 1 (top):       col3, col4\n * Row 2:             col2, col3\n * Row 3:             col2, col4\n * Row 4 (bottom):    col1, col2, col3\n */\nexport const DropletSvgPattern: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => (\n  <svg\n    className={`h-[48px] sm:h-[56px] md:h-[62px] w-[54px] sm:w-[62px] md:w-[70px] overflow-visible ${className}`}\n    viewBox=\"0 0 68 76\"\n    fill=\"none\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n  >\n    {/* Column 1 (x: 2) - bottom only */}\n    <VerticalDroplet cx={2} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 2 (x: 18) - rows 2, 3, 4 */}\n    <VerticalDroplet cx={18} cy={18} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={18} cy={36} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={18} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 3 (x: 34) - rows 1, 2, 4 */}\n    <VerticalDroplet cx={34} cy={0} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={34} cy={18} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={34} cy={54} width={5.5} height={14} color={color} />\n\n    {/* Column 4 (x: 50) - rows 1, 3 */}\n    <VerticalDroplet cx={50} cy={0} width={5.5} height={14} color={color} />\n    <VerticalDroplet cx={50} cy={36} width={5.5} height={14} color={color} />\n  </svg>\n);\n\n/**\n * ProductDropletsOverlay:\n * Pure decorative droplet component containing JUST TWO ELEMENTS:\n * 1. Left side droplet (positioned right after the title)\n * 2. Right side droplet (positioned at the right edge)\n *\n * Exactly matches the reference design.\n */\nexport interface ProductDropletsOverlayProps {\n  color?: string;\n  className?: string;\n}\n\nexport const ProductDropletsOverlay: React.FC<ProductDropletsOverlayProps> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  return (\n    <div\n      className={`w-full relative [container-type:inline-size] flex items-end justify-between pointer-events-none select-none overflow-visible ${className}`}\n    >\n      {/* 1. Left Side Droplet - reduced margin on mobile, expanding up to desktop */}\n      <div \n        className=\"flex-shrink-0 -mb-1\"\n        style={{\n          marginLeft: \"clamp(24px, 16cqw, 230px)\",\n        }}\n      >\n        <DropletSvgPattern color={color} />\n      </div>\n\n      {/* 2. Right Side Droplet - aligned to the rightmost edge */}\n      <div className=\"flex-shrink-0 -mb-1\">\n        <DropletSvgPattern color={color} />\n      </div>\n    </div>\n  );\n};\n\nexport default ProductDropletsOverlay;\n"
