      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"DirectoryPath\":{\"type\":\"string\",\"description\":\"The path to the directory to list contents of. This must be an absolute path starting with /.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"DirectoryPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "list_dir"
    }
    tools {
      name: "delete_dir"
      description: "Delete a directory. Follow these rules:\n1. ONLY use this tool to delete directories that exist. Always first confirm that the directory exists before calling this tool.\n2. Be extremely careful when using this tool as directory deletion is irreversible.\n3. Use force=false to delete only empty directories (safer).\n4. Use force=true to recursively delete all contents (dangerous - use with caution)."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"DirectoryPath\":{\"type\":\"string\",\"description\":\"The path to the directory to delete. This must be an absolute path starting with /.\"},\"Force\":{\"type\":\"boolean\",\"description\":\"If true, recursively delete all files and subdirectories. If false, only delete empty directories, and error if the directory is not empty. Defaults to false.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"DirectoryPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "delete_dir"
    }
    tools {
      name: "move"
      description: "Move a file or directory to a new path. This operation can be used to rename files/directories or move them to different locations. Any parent directories of the destination path will be created for you if they do not already exist. The source path must exist and the destination path must not exist."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"SourcePath\":{\"type\":\"string\",\"description\":\"The path to the source file or directory to move. This must be an absolute path starting with /.\"},\"DestinationPath\":{\"type\":\"string\",\"description\":\"The path to the destination location. This must be an absolute path starting with /.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"SourcePath\",\"DestinationPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "move"
    }
    tools {
      name: "view_file"
      description: "Text file usage:\n\t\t\t- The lines of the file are 1-indexed\n\t\t\t- You can view at most 1600 lines at a time\n\t\t\t- Specify StartLine and EndLine to view the lines of the file using slice notation:\n\t\t\t  - Omit both to view the entire file, or the first 1600 lines of the file, whichever is smaller.\n\t\t\t  - Specify StartLine only to view the remaining lines of the file, or the next 1600 lines, whichever is smaller\n\t\t\t  - Specify EndLine only to view the remaining preceding lines of the file, or the previous 1600 lines, whichever is smaller\n\t\t\t  - Specify both to view a precise line range. This range must be smaller than 1600 lines or only the first 1600 lines of the range will be shown."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"AbsolutePath\":{\"type\":\"string\",\"description\":\"The path to the file to view. This must be an absolute path starting with /.\"},\"StartLine\":{\"type\":\"integer\",\"description\":\"Optional. Startline to view, 1-indexed, inclusive. When specified, this value must be less than or equal to EndLine.\"},\"EndLine\":{\"type\":\"integer\",\"description\":\"Optional. Endline to view, 1-indexed, inclusive. When specified, this value must be greater than or equal to StartLine.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"AbsolutePath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "view_file"
    }
    tools {
      name: "compile_applet"
      description: "Checks if the AI Studio applet builds successfully. This tool calls the build\n\t\tsystem; if the build succeeds, it returns a message indicating success. If the build fails, it\n\t\tprovides an error message and detailed build output logs to help identify and fix issues. Use\n\t\tthis tool after making code changes to verify correct applet compilation."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "compile_applet"
    }
    tools {
      name: "install_applet_dependencies"
      description: "Install all dependencies from package.json. This runs npm install to populate the node_modules directory.\n\nUse this tool:\n- Before compiling the applet for the first time\n- After adding new dependencies\n- When you see build errors about missing packages (e.g., \"vite: not found\")\n\nIf the installation fails, you will receive an error message explaining what went wrong."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "install_applet_dependencies"
    }
    tools {
      name: "install_applet_package"
      description: "Install npm packages to the applet. This adds the packages to package.json and installs them.\n\nIMPORTANT: You MUST call this tool BEFORE writing any import statements for the packages.\nYou MAY parallelize this with code edits (\'write_to_file\', \'replace_file_content\'), but you MUST NOT run \'compile_applet\' or \'restart_dev_server\' until installation completes.\n\nUse this tool when you need to add new dependencies that aren\'t already in package.json.\n\nNOTE: providing the \'IsDevDependency: true\' argument will install the packages as dev dependencies (using the -D flag in npm install).\n\nExample: To install lodash, call this tool with PackageNames: [\"lodash\"]\nExample: To install multiple packages, call this tool with PackageNames: [\"lodash\", \"axios\"]\nExample: To install typescript as a dev dependency, call this tool with PackageNames: [\"typescript\"], IsDevDependency: true\n\nIf the installation fails, you will receive an error message explaining what went wrong."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"PackageNames\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"The names of the npm packages to install (e.g., [\'lodash\', \'react-router\'])\"},\"IsDevDependency\":{\"type\":\"boolean\",\"description\":\"Whether to install as dev dependencies using -D flag. Set to true for build tools like typescript, eslint, or @types/* packages. Defaults to false.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"PackageNames\",\"toolSummary\",\"toolAction\"]}"
      original_name: "install_applet_package"
    }
    tools {
      name: "restart_dev_server"
      description: "Restarts the Node.js development server. Use this tool when:\n- The dev server appears stale, unresponsive, or stuck\n- After updating the \"dev\" script in package.json\n- After changing server configuration or environment setup\n- When error messages suggest the server is in a bad state\nThis tool stops the current dev server process and starts a fresh one."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "restart_dev_server"
    }
    tools {
      name: "search_web"
      description: "Performs a web search for a given query. Returns a summary of relevant information along with URL citations."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"type\":\"string\"},\"domain\":{\"type\":\"string\",\"description\":\"Optional domain to recommend the search prioritize\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"query\",\"toolSummary\",\"toolAction\"]}"
      original_name: "search_web"
    }
    tools {
      name: "generate_image"
      description: "Generate an image or edit existing images based on a text prompt. The resulting image will be saved as an artifact for use. You can use this tool to generate user interfaces and iterate on a design with the USER for an application or website that you are building. When creating UI designs, generate only the interface itself without surrounding device frames (laptops, phones, tablets, etc.) unless the user explicitly requests them. You can also use this tool to generate assets for use in an application or website."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"Prompt\":{\"type\":\"string\",\"description\":\"The text prompt to generate an image for or the edit instructions.\"},\"ImagePaths\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"Optional absolute paths to the images to use in generation. You can pass in images here if you would like to edit, combine, or use as references. You can pass in artifact images and any images in the file system. Note: you cannot pass in more than 3 images.\"},\"ImageName\":{\"type\":\"string\",\"description\":\"Name of the generated image to save. Should be all lowercase with underscores, describing what the image contains. Maximum 3 words. Example: \'login_page_mockup\'\"},\"AspectRatio\":{\"type\":\"string\",\"description\":\"Optional aspect ratio for the generated image. Supported values: \'1:1\', \'2:3\', \'3:2\', \'3:4\', \'4:3\', \'9:16\', \'16:9\'. Default is \'1:1\'.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"Prompt\",\"ImageName\",\"toolSummary\",\"toolAction\"]}"
      original_name: "generate_image"
    }
    tools {
      name: "lint_applet"
      description: "Validates the codebase for syntax errors, missing imports, and other fatal issues that would prevent execution. Use this tool when:\n- You want to quickly verify that the code has no syntax errors\n- You want to check for missing imports or other fatal issues\n- After making code changes to ensure no breaking changes were introduced\nThis tool runs \'npm run lint\' in the applet directory and returns any errors found."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "lint_applet"
    }
    tools {
      name: "set_up_firebase"
      description: "This will provision a Firebase Firestore database for persistent data storage and Firebase Authentication. When Firestore is requested, this tool bootstraps initial database schemas (firebase-blueprint.json) and security rules (firestore.rules). Note: This is NOT sufficient for Google Workspace applications access; if the app requires access to Google Workspace (Calendar, Sheets, Gmail, etc.), you must prefer the other tool (set_up_oauth). CRITICAL: The agent MUST NOT call this tool until it has read the associated skill: \'firebase-integration\' (located in /skills/system_skills/firebase-skill/SKILL.md) to understand the intermediate blueprint representation, security rules generation, and ESLint validation workflows. You should always explicitly specify the products you want to provision in \'requestedProducts\' (e.g., \'firestore\' for database/auth, \'ai_logic\' for Gemini/AI features) instead of relying on defaults.\n\nThe Firebase setup process always follows these steps:\n\t- When Firebase setup is requested, call this tool with \'userConfirmedTermsAcceptedInUI: false\', and STOP THE CONVERSATION immediately. This opens the Firebase setup UI for the user to accept the proposal. Do NOT assume they will approve.\n\t- Wait for a message indicating the user accepted or declined.\n\t\t- If they accept, call this tool again with \'userConfirmedTermsAcceptedInUI: true\' (along with the required \'platform\' and any optional \'firestoreRegion\' or \'databaseId\').\n\t\t- If they decline, do not call this tool again or implement Firebase!\n\t- **CRITICAL**: You must always call this tool first with \'userConfirmedTermsAcceptedInUI: false\', then STOP and wait for the accept or decline message, then call it again with \'userConfirmedTermsAcceptedInUI: true\'. Failing to follow these steps will breach the user\'s trust and break the application.\n\nWhen this tool is called with \'userConfirmedTermsAcceptedInUI: true\', this tool will provision the Firestore database and Authentication."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"userConfirmedTermsAcceptedInUI\":{\"type\":\"boolean\",\"description\":\"Set to true if the user accepted Firebase terms in the Firebase setup UI. Set to false to show the Firebase setup UI first. Defaults to false.\"},\"FirebaseProjectID\":{\"type\":\"string\",\"description\":\"Optional Firebase project ID to use for the app. Defaults to empty.\"},\"firestoreRegion\":{\"type\":\"string\",\"description\":\"Optional. The ID of the cloud region to provision the Firestore database in. Only takes effect when \'userConfirmedTermsAcceptedInUI: true\'. Defaults to empty.\"},\"databaseId\":{\"type\":\"string\",\"description\":\"Optional. The ID to use for the Firestore database. Only takes effect when \'userConfirmedTermsAcceptedInUI: true\'. Defaults to empty.\"},\"platform\":{\"type\":\"string\",\"description\":\"Required. The platform target for Firebase setup. Must be \'web\' or \'android\'.\"},\"androidConfig\":{\"properties\":{\"packageName\":{\"type\":\"string\",\"description\":\"Required. The Android package name to use (e.g. \'com.example.app\').\"},\"sha1Certificate\":{\"type\":\"string\",\"description\":\"Required. The SHA1 certificate hash from key credentials.\"},\"sha256Certificate\":{\"type\":\"string\",\"description\":\"Required. The SHA256 certificate hash from key credentials.\"}},\"additionalProperties\":false,\"type\":\"object\",\"description\":\"Optional. Platform-specific configurations when target platform is android.\"},\"requestedProducts\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"Optional. The Firebase products to provision. Allowed values: \'firestore\', \'ai_logic\'. Note that \'ai_logic\' is NOT supported on \'web\' platform. If not specified, defaults to \'firestore\'.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"platform\",\"toolSummary\",\"toolAction\"]}"
      original_name: "set_up_firebase"
    }
    tools {
      name: "deploy_firebase"
      description: "Deploys firestore.rules to the user\'s Firebase project specified in their firebase-applet-config.json or firebase_applet_config.xml file.\n\nUse this tool if any of the following happen:\n - The user requests to deploy their app to Firebase\n - Changes are made to the firestore.rules file\n\n Only use this tool if the user has already set up Firebase for their app using the set_up_firebase tool,\n you can check this by looking for the presence of a firebase-applet-config.json or firebase_applet_config.xml file.\n"
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "deploy_firebase"
    }
    tools {
      name: "rpc_action"
      description: "Performs an action on an integration service (e.g. Firebase, Cloud SQL).\n\nIMPORTANT: This tool MUST only be used when an Integration Skill\'s guidelines explicitly instruct you to call it. Do NOT call this tool speculatively or based on your own judgement. The Integration Skill documentation specifies the exact service_name, method_name, and arguments schema to use.\n\nHow to use:\n\t- Identify the Integration Skill that applies to the user\'s request.\n\t- Follow the skill\'s guidelines to determine the correct service_name, method_name, and arguments.\n\t- Call this tool with those exact parameters.\n\t- If the tool returns an error, analyze the error message. Some errors are recoverable (e.g. incorrect parameters, transient failures) \342\200\224 fix the issue and retry. For non-recoverable errors, report the issue to the user."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"service_name\":{\"type\":\"string\",\"description\":\"The integration service to call (e.g. firebase, cloudsql).\"},\"method_name\":{\"type\":\"string\",\"description\":\"The method to invoke on the service (e.g. ProvisionFirebase).\"},\"arguments\":{\"type\":\"object\",\"description\":\"A JSON object of method-specific arguments. Refer to Integration Skill docs for the schema.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"service_name\",\"method_name\",\"toolSummary\",\"toolAction\"]}"
      original_name: "rpc_action"
    }
    tools {
      name: "set_up_oauth"
      description: "Initiates the OAuth setup flow to integrate Google Workspace applications (including Google Calendar, Sheets, Drive, Gmail, Docs, Slides, Forms, Chat, and Contacts) or access external APIs on behalf of the user. Call this tool when the applet needs OAuth credentials. Provide the applet ID and the list of OAuth scopes required by the applet.\n\nThe OAuth setup process always follows these steps:\n\t- When OAuth is requested, call this tool with \'userConfirmedInUI: false\', and STOP THE CONVERSATION immediately. This opens the OAuth setup UI for the user to accept the proposal. Do NOT assume they will approve.\n\t- Wait for a message indicating the user accepted or declined\n\t\t- If they accept, call this tool again with \'userConfirmedInUI: true\'\n\t\t- If they decline, do not call this tool again or implement OAuth!\n\t- **CRITICAL**: You must always call this tool first with \'userConfirmedInUI: false\', then STOP and wait for the accept or decline message, then call it again with \'userConfirmedInUI: true\'. Failing to follow these steps will breach the user\'s trust and break the application.\n\nWhen this tool is called with \'userConfirmedInUI: true\', this tool will:\n\t- Create a new OAuth client (or retrieve the current client)\n\nWhen \'userConfirmedInUI: true\', the OAuth client will be created in the same Cloud project as the AI Studio applet, which is the default behavior. The user may specify a different Cloud project ID to use for provisioning via the \'ProjectID\' argument.\n\nThis tool can be called multiple times if the user requests it. Calling it again with \'userConfirmedInUI: false\' will show the OAuth setup UI again, and calling it again with \'userConfirmedInUI: true\' will update the OAuth client configuration."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"userConfirmedInUI\":{\"type\":\"boolean\",\"description\":\"Set to true if the user agreed to the OAuth setup.\"},\"scopes_to_add\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"The OAuth scopes required by the applet.\"},\"project_id\":{\"type\":\"string\",\"description\":\"The Cloud project ID to use for the OAuth client.\"},\"project_number\":{\"type\":\"integer\",\"description\":\"The Cloud project number to use for the OAuth brand. If provided, skips the project lookup.\"},\"title\":{\"type\":\"string\",\"description\":\"The title of the step to show to the user, should come in the form of \'Use \\u003cProduct name related to the scope that is being requested\\u003e to \\u003ctask the user is trying to accomplish\\u003e\'. Must be short, no longer than 40 characters.\"},\"brand_name\":{\"type\":\"string\",\"description\":\"The name of the brand to display to users on the OAuth consent screen. Optional.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"scopes_to_add\",\"title\",\"toolSummary\",\"toolAction\"]}"
      original_name: "set_up_oauth"
    }
    tools {
      name: "remove_oauth"
      description: "Removes specified OAuth scopes from an applet\'s configuration.\nCall this tool when you are modifying the applet\'s code to remove or stop using specific OAuth scopes.\nYou MUST call this tool to keep the stored configuration in sync with your code changes.\nDo NOT use this tool if you are only adding scopes."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"scopes_to_remove\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"The OAuth scopes to remove from the applet.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"scopes_to_remove\",\"toolSummary\",\"toolAction\"]}"
      original_name: "remove_oauth"
    }
    tools {
      name: "show_aistudio_ui"
      description: "Requests the user to interact with a specific AI Studio UI component.\nCall this tool ONLY when explicitly instructed to call it (e.g. by system instructions or skills).\nDo NOT call this tool based on general conversation topics.\nAfter calling this tool, you must STOP and wait for the user to respond."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"arguments\":{\"description\":\"Key-value pairs specific to the UI type.\",\"type\":\"object\"},\"ui_type\":{\"description\":\"The type of AI Studio UI to show.\",\"enum\":[\"paid_model_flow\",\"cloudsql_setup\",\"firebase_setup\",\"google_maps_setup\"],\"type\":\"string\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"ui_type\",\"toolSummary\",\"toolAction\"]}"
      original_name: "show_aistudio_ui"
    }
    tools {
      name: "run_command"
      description: "PROPOSE a command to run on behalf of the user. Operating System: linux. Shell: bash.\n**NEVER PROPOSE A cd COMMAND**.\nIf you have this tool, note that you DO have the ability to run commands directly on the USER\'s system.\nMake sure to specify CommandLine exactly as it should be run in the shell.\nIf the step doesn\'t return the command output, it means that the command was sent to the background as a task. You will receive messages with the command\'s output as it runs. To interact with a running command, use the manage_task tool. Use `send_input` to send stdin, `kill` to terminate the command, and `status` to check current status. IMPORTANT: Do NOT poll or loop on `status` to wait for completion. The system will automatically notify you with a message when the command finishes. Simply proceed with other work or stop calling tools after launching a command.\nCommands will be run with PAGER=cat. You may want to limit the length of output for commands that usually rely on paging and may contain very long output (e.g. git log, use git log -n <N>)."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"Cwd\":{\"type\":\"string\",\"description\":\"The current working directory for the command\"},\"WaitMsBeforeAsync\":{\"type\":\"integer\",\"description\":\"This specifies the number of milliseconds to wait after starting the command before sending it to the background. If you want the command to complete execution synchronously, set this to a large enough value that you expect the command to complete in that time under ordinary circumstances. If you\'re starting an interactive or long-running command, set it to a large enough value that it would cause possible failure cases to execute synchronously (e.g. 500ms). Keep the value as small as possible, with a maximum of 10000ms.\"},\"CommandLine\":{\"type\":\"string\",\"description\":\"The exact command line string to execute.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"Cwd\",\"WaitMsBeforeAsync\",\"CommandLine\",\"toolSummary\",\"toolAction\"]}"
      original_name: "run_command"
    }
    tools {
      name: "manage_task"
      description: "Manage background tasks. Use this tool to list running tasks or interact with tasks that were sent to the background.\n\nActions:\n- \'list\': List all currently running background tasks\n- \'kill\': Cancel the task\'s execution\n- \'status\': Check the task\'s current status and log file location\n- \'send_input\': Send input to a running task\n\nWhen mentioning tasks to the user, avoid using full task IDs and start timestamps; keep them human-readable."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"Action\":{\"type\":\"string\",\"enum\":[\"list\",\"kill\",\"status\",\"send_input\"],\"description\":\"The action to perform: \'list\' (list all running tasks), \'kill\' (cancel the task), \'status\' (check the task status and log URI), \'send_input\' (send input to a running task).\"},\"TaskId\":{\"type\":\"string\",\"description\":\"The task ID to manage. Required when Action is \'kill\', \'status\', or \'send_input\'.\"},\"Input\":{\"type\":\"string\",\"description\":\"The input to send to the task. Required when Action is \'send_input\'.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"Action\",\"toolSummary\",\"toolAction\"]}"
      original_name: "manage_task"
    }
    tools {
      name: "schedule"
      description: "Schedule a one-shot timer or a recurring cron job that sends notifications in the background.\n\n**NOTE**: This tool call returns immediately and does not pause execution. To wait for the timer to fire, you must stop calling tools to end your turn.\n\nModes:\n1. **One-shot timer**: Set a timer for a specified duration that will notify you with your Prompt when it expires. You can control early termination behavior using TimerCondition:\n\n- \'never\' (default): The timer will always fire after the specified duration, unless explicitly cancelled.\nUsage: Use when setting unconditional timers that should always fire after DurationSeconds, unless explicitly cancelled.\n- \'any\': The timer will be cancelled early if ANY message from any sender is received before the duration.\nUsage: Useful when multiple background tasks are running and you want to wait for any update, but with some guarantee that you won\'t be idle forever in case they are all stuck.\n- <sender-id>: The timer will be cancelled early if a message is received from that specific sender ID.\nUsage: Use when you\'re waiting for an update from a specific subagent or task, but want to set some limit on how long to wait.\n\nNOTE: When a timer is cancelled early, no separate cancellation notification is sent \342\200\224 the message that satisfied the condition is itself your wakeup, and the timer\'s tool step result records the cancellation.\n\nNOTE: You cannot have multiple concurrently active timers that would early terminate on the same sender ID.\nFor example, if you already have a liveness timer set with \"any\", you cannot set another timer with \"any\" or any other condition.\nIf you already have a timer set with early termination on \"task-123\", you cannot set another timer with \"task-123\" or \"any\".\nYou should rely on the existing timer, or cancel and replace it if needed.\n\nExamples:\n\nScenario: User asks explicitly for a reminder in 10 minutes.\nArgs: DurationSeconds=600, Prompt=\"Remind the user\", TimerCondition=\"never\"\nComments: TimerCondition=\"never\" is appropriate since this timer is unrelated to other ongoing tasks.\n\nScenario: You just ran a command as \"task-123\". You already set a notification on it for 5 minutes, and it just notified you that it\'s still running. After checking the output, you want to set a new reminder to check on it in 10 minutes if it still hasn\'t finished.\nArgs: DurationSeconds=600, Prompt=\"Check on the command status\", TimerCondition=\"task-123\"\nComments: TimerCondition=\"task-123\" is appropriate since the timer is not needed if the command finishes ahead of time.\n\nScenario: You just spawned 10 subagents, and you want to check in on progress after 5 minutes if you haven\'t heard back from any of them.\nArgs: DurationSeconds=300, Prompt=\"Check in on the subagents\' progress\", TimerCondition=\"any\"\nComments: TimerCondition=\"any\" is appropriate since you are not waiting for any specific subagent.\n\nScenario: You are running a command that you\'re sure will terminate, and you want to wait for it to finish.\nArgs: N/A\nComments: A timer is not needed at all in this scenario and will wastefully generate extra messages. Stop calling tools to end your turn instead.\n\n2. **Recurring cron**: Set CronExpression to a standard 5-field cron expression (e.g., \'*/5 * * * *\' for every 5 minutes). Each time the cron triggers, a notification with your Prompt is sent. The cron runs as a background task. Optionally set MaxIterations to limit the number of triggers.\n\nExamples:\n- Poll deployment status every 5 minutes: CronExpression=\"*/5 * * * *\", Prompt=\"Check deployment status and report progress\"\n- Run a health check every hour, up to 3 times: CronExpression=\"0 * * * *\", MaxIterations=3, Prompt=\"Run the health check script and report results\"\n\nGeneral Reminders:\n- You must specify exactly one of DurationSeconds or CronExpression.\n- Always provide a Prompt describing what the notification should say.\n- Never run a background \'sleep\' command to set a timer, use this tool instead.\n- To cancel a running timer or cron schedule, use the manage_task tool with the task ID returned by this tool."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"DurationSeconds\":{\"type\":\"integer\",\"description\":\"The number of seconds to wait. Use for one-shot timers. Mutually exclusive with CronExpression.\"},\"CronExpression\":{\"type\":\"string\",\"description\":\"A standard cron expression (5 fields: minute hour day-of-month month day-of-week). Use for recurring schedules. Mutually exclusive with DurationSeconds. Example: \'*/5 * * * *\' for every 5 minutes.\"},\"MaxIterations\":{\"type\":\"integer\",\"description\":\"Optional. Maximum number of times the cron schedule will fire before stopping. Only applicable when CronExpression is set. Defaults to unlimited.\"},\"TimerCondition\":{\"type\":\"string\",\"description\":\"Optional. Controls when a one-shot timer should early terminate upon receiving a message. Options: \'never\' (default, timer unconditionally waits until expiry), \'any\' (timer cancels if any message is received), or a specific sender ID (timer cancels only if a message is received from that specific subagent conversation ID or background task ID). Only applicable when DurationSeconds is set.\"},\"Prompt\":{\"type\":\"string\",\"description\":\"The message content to include in the notification when the timer fires or cron triggers. This is sent to the agent as a high-priority message.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing the specific task. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'Git status check\', \'Test execution\', \'Code search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word phrase in -ing form describing the specific action. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Checking git status\', \'Running tests\', \'Searching code\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"Prompt\",\"toolSummary\",\"toolAction\"]}"
      original_name: "schedule"
    }
