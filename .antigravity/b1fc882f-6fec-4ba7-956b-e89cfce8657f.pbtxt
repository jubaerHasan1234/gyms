    content: "import React from \"react\";\nimport { Check } from \"lucide-react\";\n\nexport interface NewsletterSuccessViewProps {\n  email: string;\n  onReset: () => void;\n}\n\nexport const NewsletterSuccessView: React.FC<NewsletterSuccessViewProps> = ({\n  email,\n  onReset,\n}) => {\n  return (\n    <div className=\"w-full max-w-[200px] sm:max-w-[210px] md:max-w-[220px] lg:max-w-xs mx-auto bg-neutral-900 border border-neutral-700/80 rounded-full py-1 sm:py-1 px-2.5 sm:px-2.5 flex items-center justify-between gap-1.5 text-left animate-fadeIn\">\n      <div className=\"flex items-center gap-1 sm:gap-1\">\n        <span className=\"w-4 h-4 sm:w-4 sm:h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0\">\n          <Check className=\"w-2.5 h-2.5\" />\n        </span>\n        <div>\n          <p className=\"text-[9.5px] sm:text-[9.5px] font-semibold text-white\">\n            Welcome!\n          </p>\n          <p className=\"text-[8px] sm:text-[8px] text-neutral-400 truncate max-w-[100px] sm:max-w-none\">\n            Check <span className=\"text-neutral-200\">{email}</span>\n          </p>\n        </div>\n      </div>\n      <button\n        onClick={onReset}\n        className=\"text-[8.5px] sm:text-[8.5px] text-neutral-400 hover:text-white underline underline-offset-2 shrink-0 transition-colors\"\n      >\n        Change\n      </button>\n    </div>\n  );\n};\n\nexport default NewsletterSuccessView;\n"
