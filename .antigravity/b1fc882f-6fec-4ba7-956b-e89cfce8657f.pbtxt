ve inline-block whitespace-nowrap\">\n              <span>newsletter</span>\n              <NewsletterUnderlineSwoosh />\n            </span>\n          </h2>\n\n          {/* Subtitle / Description Paragraph */}\n          <p className=\"font-normal text-neutral-300 mx-auto text-[11px] sm:text-xs md:text-sm lg:text-base max-w-xl mb-5 sm:mb-7 md:mb-8 leading-relaxed\">\n            Join our community of fitness enthusiasts and athletes! By subscribing to\n            our newsletter, you\'ll receive expert training tips, nutrition guides,\n            exclusive discounts, and the latest news on upcoming events.\n          </p>\n\n          {/* Subscription Form / Status */}\n          {status === \"success\" ? (\n            <div className=\"w-full max-w-md mx-auto\">\n              <NewsletterSuccessView email={email} onReset={handleReset} />\n            </div>\n          ) : (\n            <form\n              onSubmit={handleSubmit}\n              noValidate\n              className=\"w-full max-w-md mx-auto\"\n            >\n              <div className=\"relative rounded-full border border-neutral-600 bg-neutral-950 flex flex-col sm:flex-row items-stretch sm:items-center justify-between p-1 sm:p-1 sm:pl-4 gap-1.5 sm:gap-0 focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 transition-all shadow-inner\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter your email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full bg-transparent text-white placeholder:text-neutral-400 outline-none text-xs sm:text-sm font-medium px-2.5 sm:px-0 sm:pr-2 py-1.5 sm:py-0 text-center sm:text-left\"\n                />\n\n                <button\n                  type=\"submit\"\n                  className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full px-4 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-sm transition-all duration-150 cursor-pointer shadow-md text-center\"\n                >\n                  SUBSCRIBE\n                </button>\n              </div>\n\n              {/* Error Message if invalid */}\n              {status === \"error\" && (\n                <p\n                  role=\"alert\"\n                  className=\"mt-2 text-xs text-rose-400 font-medium\"\n                >\n                  {errorMessage}\n                </p>\n              )}\n            </form>\n          )}\n        </div>\n      </div>\n    </section>\n  );"
      replacement_content: "  return (\n    <section\n      id=\"newsletter\"\n      className={`relative w-full py-10 sm:py-14 md:py-20 px-4 sm:px-8 md:px-12 lg:px-16 bg-white overflow-x-clip overflow-y-visible select-text scroll-mt-6 ${className}`}\n      aria-labelledby=\"newsletter-heading\"\n    >\n      {/* Container holding droplets and newsletter card with expansive tablet scaling */}\n      <div className=\"relative w-full max-w-[360px] sm:max-w-[580px] md:max-w-[820px] lg:max-w-[940px] xl:max-w-[980px] mx-auto\">\n        {/* 1. TOP-RIGHT DROPLET PATTERN - Shifted further right */}\n        <div\n          className=\"absolute -top-4 sm:-top-6 md:-top-7 lg:-top-8 -right-3 sm:-right-6 md:-right-8 lg:-right-10 xl:-right-12 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterTopRightDroplet />\n        </div>\n\n        {/* 2. BOTTOM-LEFT DROPLET PATTERN - Shifted further left */}\n        <div\n          className=\"absolute -bottom-4 sm:-bottom-6 md:-bottom-7 lg:-bottom-8 -left-3 sm:-left-6 md:-left-8 lg:-left-10 xl:-left-12 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterBottomLeftDroplet />\n        </div>\n\n        {/* 3. MAIN BLACK NEWSLETTER CARD CONTAINER */}\n        <div\n          className=\"relative z-20 mx-auto w-full bg-black text-white text-center rounded-[24px] sm:rounded-[32px] md:rounded-[44px] lg:rounded-[48px] px-5 py-7 sm:px-8 sm:py-10 md:px-14 md:py-14 lg:px-16 lg:py-16 shadow-2xl flex flex-col items-center justify-center border border-white/10\"\n        >\n          {/* Eyebrow: Join our community */}\n          <p className=\"font-semibold tracking-wider text-neutral-300 text-[11px] sm:text-xs md:text-sm uppercase mb-1.5 sm:mb-2 md:mb-2.5\">\n            Join our community\n          </p>\n\n          {/* Title: Subscribe to our newsletter with swoosh */}\n          <h2\n            id=\"newsletter-heading\"\n            className=\"font-extrabold tracking-tight text-white leading-tight text-xl sm:text-2xl md:text-4xl lg:text-[42px] mb-2.5 sm:mb-3.5 md:mb-4\"\n          >\n            <span>Subscribe to our </span>\n            <span className=\"relative inline-block whitespace-nowrap\">\n              <span>newsletter</span>\n              <NewsletterUnderlineSwoosh />\n            </span>\n          </h2>\n\n          {/* Subtitle / Description Paragraph */}\n          <p className=\"font-normal text-neutral-300 mx-auto text-xs sm:text-sm md:text-base lg:text-[17px] max-w-sm sm:max-w-lg md:max-w-2xl lg:max-w-3xl mb-6 sm:mb-8 md:mb-10 leading-relaxed\">\n            Join our community of fitness enthusiasts and athletes! By subscribing to\n            our newsletter, you&apos;ll receive expert training tips, nutrition guides,\n            exclusive discounts, and the latest news on upcoming events.\n          </p>\n\n          {/* Subscription Form / Status */}\n          {status === \"success\" ? (\n            <div className=\"w-full max-w-sm sm:max-w-md md:max-w-xl mx-auto\">\n              <NewsletterSuccessView email={email} onReset={handleReset} />\n            </div>\n          ) : (\n            <form\n              onSubmit={handleSubmit}\n              noValidate\n              className=\"w-full max-w-sm sm:max-w-md md:max-w-xl mx-auto\"\n            >\n              <div className=\"relative rounded-full border border-neutral-700 bg-neutral-950 flex flex-col sm:flex-row items-stretch sm:items-center justify-between p-1.5 sm:p-1.5 sm:pl-5 md:pl-6 gap-2 sm:gap-0 focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 transition-all shadow-inner\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter your email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full bg-transparent text-white placeholder:text-neutral-400 outline-none text-xs sm:text-sm md:text-base font-medium px-3 sm:px-0 sm:pr-3 py-1.5 sm:py-0 text-center sm:text-left\"\n                />\n\n                <button\n                  type=\"submit\"\n                  className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full px-5 sm:px-6 md:px-8 py-2.5 sm:py-2.5 md:py-3 text-xs sm:text-sm md:text-sm transition-all duration-150 cursor-pointer shadow-md text-center\"\n                >\n                  SUBSCRIBE\n                </button>\n              </div>\n\n              {/* Error Message if invalid */}\n              {status === \"error\" && (\n                <p\n                  role=\"alert\"\n                  className=\"mt-2 text-xs md:text-sm text-rose-400 font-medium\"\n                >\n                  {errorMessage}\n                </p>\n              )}\n            </form>\n          )}\n        </div>\n      </div>\n    </section>\n  );"
