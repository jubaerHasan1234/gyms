        target_content: "@import \"tailwindcss\";\n\nhtml {\n  scroll-behavior: smooth;\n  font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n}\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n\n  body {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, button, input, a {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n}"
        replacement_content: "@import url(\'https://api.fontshare.com/v2/css?f[]=satoshi@900,800,700,600,500,400,300&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \'Satoshi\', sans-serif;\n  --font-display: \'Satoshi\', sans-serif;\n  --font-body: \'Satoshi\', sans-serif;\n  --font-heading: \'Satoshi\', sans-serif;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  font-family: \'Satoshi\', sans-serif;\n}\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Satoshi\', sans-serif;\n  }\n\n  body {\n    font-family: \'Satoshi\', sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, button, input, textarea, select, a, p, span, div, label {\n    font-family: \'Satoshi\', sans-serif;\n  }\n}"
      }
