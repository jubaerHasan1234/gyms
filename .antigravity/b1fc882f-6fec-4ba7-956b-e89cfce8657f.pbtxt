    content: "import React from \"react\";\nimport { Check } from \"lucide-react\";\n\nexport interface NewsletterSuccessViewProps {\n  email: string;\n  onReset: () => void;\n}\n\nexport const NewsletterSuccessView: React.FC<NewsletterSuccessViewProps> = ({\n  email,\n  onReset,\n}) => {\n  return (\n    <div className=\"w-full max-w-[240px] sm:max-w-md md:max-w-lg mx-auto bg-neutral-900 border border-neutral-700/80 rounded-full py-1.5 sm:py-2.5 px-3 sm:px-5 md:px-6 flex items-center justify-between gap-2 sm:gap-3 text-left animate-fadeIn\">\n      <div className=\"flex items-center gap-1.5 sm:gap-2.5 min-w-0\">\n        <span className=\"w-4 h-4 sm:w-6 sm:h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0\">\n          <Check className=\"w-2.5 h-2.5 sm:w-3.5 sm:h-3.5\" />\n        </span>\n        <div className=\"min-w-0\">\n          <p className=\"text-[10px] sm:text-sm font-semibold text-white leading-tight\">\n            Welcome aboard!\n          </p>\n          <p className=\"text-[8.5px] sm:text-xs text-neutral-400 truncate max-w-[110px] sm:max-w-xs\">\n            Sent to <span className=\"text-neutral-200 font-medium\">{email}</span>\n          </p>\n        </div>\n      </div>\n      <button\n        onClick={onReset}\n        className=\"text-[9.5px] sm:text-xs text-neutral-400 hover:text-white underline underline-offset-2 shrink-0 transition-colors cursor-pointer\"\n      >\n        Change\n      </button>\n    </div>\n  );\n};\n\nexport default NewsletterSuccessView;\n"
    num_lines: 39
    num_bytes: 1480
  }
}
