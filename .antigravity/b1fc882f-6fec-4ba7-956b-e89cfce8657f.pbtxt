    replacement_infos {
      original_chunk {
        target_content: "      {/* Container holding droplets and newsletter card with compact mobile width and expansive tablet/desktop scaling */}\n      <div className=\"relative w-full max-w-[270px] sm:max-w-[580px] md:max-w-[820px] lg:max-w-[940px] xl:max-w-[980px] mx-auto\">\n        {/* 1. TOP-RIGHT DROPLET PATTERN - Positioned further to the right */}\n        <div\n          className=\"absolute -top-3.5 sm:-top-5 md:-top-7 lg:-top-8 -right-6 sm:-right-10 md:-right-14 lg:-right-18 xl:-right-22 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterTopRightDroplet />\n        </div>\n\n        {/* 2. BOTTOM-LEFT DROPLET PATTERN - Positioned further to the left */}\n        <div\n          className=\"absolute -bottom-3.5 sm:-bottom-5 md:-bottom-7 lg:-bottom-8 -left-6 sm:-left-10 md:-left-8 lg:-left-18 xl:-left-22 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterBottomLeftDroplet />\n        </div>\n\n        {/* 3. MAIN BLACK NEWSLETTER CARD CONTAINER */}\n        <div\n          className=\"relative z-20 mx-auto w-full bg-black text-white text-center rounded-[22px] sm:rounded-[32px] md:rounded-[44px] lg:rounded-[48px] px-3.5 py-5 sm:px-8 sm:py-10 md:px-14 md:py-14 lg:px-16 lg:py-16 shadow-2xl flex flex-col items-center justify-center border border-white/10\"\n        >\n          {/* Eyebrow: Join our community */}\n          <p className=\"font-semibold tracking-wider text-neutral-300 text-[10px] sm:text-xs md:text-sm uppercase mb-1 sm:mb-2 md:mb-2.5\">\n            Join our community\n          </p>\n\n          {/* Title: Subscribe to our newsletter with swoosh */}\n          <h2\n            id=\"newsletter-heading\"\n            className=\"font-extrabold tracking-tight text-white leading-tight text-lg sm:text-2xl md:text-4xl lg:text-[42px] mb-2 sm:mb-3.5 md:mb-4\"\n          >\n            <span>Subscribe to our </span>\n            <span className=\"relative inline-block whitespace-nowrap\">\n              <span>newsletter</span>\n              <NewsletterUnderlineSwoosh />\n            </span>\n          </h2>\n\n          {/* Subtitle / Description Paragraph */}\n          <p className=\"font-normal text-neutral-300 mx-auto text-[11px] sm:text-sm md:text-base lg:text-[17px] max-w-sm sm:max-w-lg md:max-w-2xl lg:max-w-3xl mb-4 sm:mb-8 md:mb-10 leading-relaxed\">\n            Join our community of fitness enthusiasts and athletes! By subscribing to\n            our newsletter, you&apos;ll receive expert training tips, nutrition guides,\n            exclusive discounts, and the latest news on upcoming events.\n          </p>\n\n          {/* Subscription Form / Status */}\n          {status === \"success\" ? (\n            <div className=\"w-full max-w-[240px] sm:max-w-md md:max-w-xl mx-auto\">\n              <NewsletterSuccessView email={email} onReset={handleReset} />\n            </div>\n          ) : (\n            <form\n              onSubmit={handleSubmit}\n              noValidate\n              className=\"w-full max-w-[240px] sm:max-w-md md:max-w-xl mx-auto\"\n            >\n              {/* Email box: inline row layout with small button on the right side */}\n              <div className=\"relative rounded-full border border-neutral-700 bg-neutral-950 flex flex-row items-center justify-between p-1 sm:p-1.5 pl-2.5 sm:pl-5 md:pl-6 gap-1.5 sm:gap-0 focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 transition-all shadow-inner\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter your email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full min-w-0 bg-transparent text-white placeholder:text-neutral-400 outline-none text-[11px] sm:text-sm md:text-base font-normal sm:font-medium px-1 sm:px-0 sm:pr-3 py-0.5 sm:py-0 text-left\"\n                />\n\n                {/* Right side small button (not big button) */}\n                <button\n                  type=\"submit\"\n                  className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full px-2.5 sm:px-6 md:px-8 py-1 sm:py-2.5 md:py-3 text-[9.5px] sm:text-xs md:text-sm transition-all duration-150 cursor-pointer shadow-md text-center\"\n                >\n                  SUBSCRIBE\n                </button>\n              </div>\n\n              {/* Error Message if invalid */}\n              {status === \"error\" && (\n                <p\n                  role=\"alert\"\n                  className=\"mt-1.5 text-[10px] sm:text-xs md:text-sm text-rose-400 font-medium\"\n                >\n                  {errorMessage}\n                </p>\n              )}\n            </form>\n          )}\n        </div>"
        replacement_content: "      {/* Container holding droplets and newsletter card with smaller mobile and tablet widths */}\n      <div className=\"relative w-full max-w-[245px] sm:max-w-[500px] md:max-w-[620px] lg:max-w-[820px] xl:max-w-[900px] mx-auto\">\n        {/* 1. TOP-RIGHT DROPLET PATTERN */}\n        <div\n          className=\"absolute -top-3 sm:-top-5 md:-top-6 lg:-top-8 -right-4 sm:-right-8 md:-right-10 lg:-right-14 xl:-right-18 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterTopRightDroplet />\n        </div>\n\n        {/* 2. BOTTOM-LEFT DROPLET PATTERN */}\n        <div\n          className=\"absolute -bottom-3 sm:-bottom-5 md:-bottom-6 lg:-bottom-8 -left-4 sm:-left-8 md:-left-8 lg:-left-14 xl:-left-18 z-10 pointer-events-none\"\n          aria-hidden=\"true\"\n        >\n          <NewsletterBottomLeftDroplet />\n        </div>\n\n        {/* 3. MAIN BLACK NEWSLETTER CARD CONTAINER */}\n        <div\n          className=\"relative z-20 mx-auto w-full bg-black text-white text-center rounded-[20px] sm:rounded-[28px] md:rounded-[36px] lg:rounded-[44px] px-3 py-4.5 sm:px-7 sm:py-8 md:px-11 md:py-11 lg:px-14 lg:py-14 shadow-2xl flex flex-col items-center justify-center border border-white/10\"\n        >\n          {/* Eyebrow: Join our community */}\n          <p className=\"font-semibold tracking-wider text-neutral-300 text-[9.5px] sm:text-xs md:text-sm uppercase mb-1 sm:mb-1.5 md:mb-2\">\n            Join our community\n          </p>\n\n          {/* Title: Subscribe to our newsletter with swoosh */}\n          <h2\n            id=\"newsletter-heading\"\n            className=\"font-extrabold tracking-tight text-white leading-tight text-base sm:text-2xl md:text-3xl lg:text-4xl mb-2 sm:mb-3 md:mb-3.5\"\n          >\n            <span>Subscribe to our </span>\n            <span className=\"relative inline-block whitespace-nowrap\">\n              <span>newsletter</span>\n              <NewsletterUnderlineSwoosh />\n            </span>\n          </h2>\n\n          {/* Subtitle / Description Paragraph */}\n          <p className=\"font-normal text-neutral-300 mx-auto text-[10px] sm:text-xs md:text-[13.5px] lg:text-[15px] max-w-[215px] sm:max-w-md md:max-w-lg lg:max-w-2xl mb-3.5 sm:mb-6 md:mb-8 leading-relaxed\">\n            Join our community of fitness enthusiasts and athletes! By subscribing to\n            our newsletter, you&apos;ll receive expert training tips, nutrition guides,\n            exclusive discounts, and the latest news on upcoming events.\n          </p>\n\n          {/* Subscription Form / Status */}\n          {status === \"success\" ? (\n            <div className=\"w-full max-w-[215px] sm:max-w-sm md:max-w-md mx-auto\">\n              <NewsletterSuccessView email={email} onReset={handleReset} />\n            </div>\n          ) : (\n            <form\n              onSubmit={handleSubmit}\n              noValidate\n              className=\"w-full max-w-[215px] sm:max-w-sm md:max-w-md mx-auto\"\n            >\n              {/* Email box: inline row layout with small button on the right side */}\n              <div className=\"relative rounded-full border border-neutral-700 bg-neutral-950 flex flex-row items-center justify-between p-0.5 sm:p-1.5 pl-2 sm:pl-4 md:pl-5 gap-1 sm:gap-0 focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 transition-all shadow-inner\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter your email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full min-w-0 bg-transparent text-white placeholder:text-neutral-400 outline-none text-[10px] sm:text-xs md:text-sm font-normal sm:font-medium px-1 sm:px-0 sm:pr-2 py-0.5 sm:py-0 text-left\"\n                />\n\n                {/* Right side small button */}\n                <button\n                  type=\"submit\"\n                  className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full px-2 sm:px-5 md:px-7 py-0.5 sm:py-2 md:py-2.5 text-[9px] sm:text-xs md:text-xs transition-all duration-150 cursor-pointer shadow-md text-center\"\n                >\n                  SUBSCRIBE\n                </button>\n              </div>\n\n              {/* Error Message if invalid */}\n              {status === \"error\" && (\n                <p\n                  role=\"alert\"\n                  className=\"mt-1 text-[9.5px] sm:text-xs text-rose-400 font-medium\"\n                >\n                  {errorMessage}\n                </p>\n              )}\n            </form>\n          )}\n        </div>"
