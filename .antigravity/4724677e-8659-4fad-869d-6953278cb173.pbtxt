ottom: \"0.1cqw\",\n                  }}\n                >\n                  POWER YOUR\n                </span>\n                {/* Below Line: PONTETIALE */}\n                <span\n                  className=\"block tracking-[-0.04em] whitespace-nowrap\"\n                  style={{\n                    fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                    fontWeight: 900,\n                    fontStyle: \"normal\",\n                    fontSize: \"10.4cqw\",\n                    color: \"rgba(255, 255, 255, 0.08)\",\n                    WebkitTextStroke: \"max(1.2px, 0.11cqw) rgba(255, 255, 255, 0.95)\",\n                    textShadow: \"0 0 25px rgba(0,0,0,0.7)\",\n                  }}\n                >\n                  PONTETIALE\n                </span>\n              </h1>\n            </div>\n          </div>\n        </div>"
