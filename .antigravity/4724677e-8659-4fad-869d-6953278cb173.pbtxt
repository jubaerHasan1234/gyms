    content: "import React from \"react\";\nimport boxerImg from \"../assets/images/boxer_champion_training_1790843406316.jpg\";\n\ninterface TrainLikeChampionSectionProps {\n  className?: string;\n}\n\n/**\n * Top-Left Droplet:\n * Horizontal dome shapes: Curved round TOP dome with soft rounded corner radius (cr) on the bottom edge\n * Matches the user request (\"droplet some radius add\") so the corners are smoothly rounded and organic.\n */\nconst TopLeftDropletGroup: React.FC<{ color?: string }> = ({ color = \"#D1D5DB\" }) => {\n  // Curved dome top, smooth rounded bottom corners with corner radius `cr`:\n  const domeD = (x: number, y: number, w = 15, h = 8, cr = 1.6) =>\n    `M ${x} ${y + h - cr}\n     A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n     Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n     L ${x + cr} ${y + h}\n     Q ${x} ${y + h} ${x} ${y + h - cr}\n     Z`;\n\n  return (\n    <svg\n      viewBox=\"0 0 84 62\"\n      className=\"w-[70px] sm:w-[82px] md:w-[96px] h-auto overflow-visible select-none\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      {/* Row 0 */}\n      <path d={domeD(4, 2)} fill={color} />\n\n      {/* Row 1 */}\n      <path d={domeD(4, 16)} fill={color} />\n      <path d={domeD(24, 16)} fill={color} />\n      <path d={domeD(44, 16)} fill={color} />\n\n      {/* Row 2 */}\n      <path d={domeD(4, 30)} fill={color} />\n      <path d={domeD(44, 30)} fill={color} />\n      <path d={domeD(64, 30)} fill={color} />\n\n      {/* Row 3 */}\n      <path d={domeD(24, 44)} fill={color} />\n      <path d={domeD(64, 44)} fill={color} />\n    </svg>\n  );\n};\n\n/**\n * Top-Right Droplet:\n * Vertical D-shaped droplets (curved left side, soft rounded straight right corners)\n * Column 1 (left): row 4 (bottom)\n * Column 2: row 1, row 3, row 4\n * Column 3: row 0, row 1, row 4\n * Column 4 (right): row 0, row 2\n */\nconst TopRightDropletGroup: React.FC<{ color?: string }> = ({ color = \"#D1D5DB\" }) => {\n  // D-droplet with subtle rounded radius on the right vertical corners:\n  const dDroplet = (x: number, y: number, w = 5.5, h = 13, cr = 1.4) =>\n    `M ${x + w} ${y + cr}\n     L ${x + w} ${y + h - cr}\n     Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n     A ${w} ${h / 2} 0 0 1 ${x + w - cr} ${y}\n     Q ${x + w} ${y} ${x + w} ${y + cr}\n     Z`;\n\n  return (\n    <svg\n      viewBox=\"0 0 68 76\"\n      className=\"w-[52px] sm:w-[60px] md:w-[68px] h-auto overflow-visible select-none\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      {/* Col 1 */}\n      <path d={dDroplet(2, 54)} fill={color} />\n\n      {/* Col 2 */}\n      <path d={dDroplet(18, 18)} fill={color} />\n      <path d={dDroplet(18, 36)} fill={color} />\n      <path d={dDroplet(18, 54)} fill={color} />\n\n      {/* Col 3 */}\n      <path d={dDroplet(34, 0)} fill={color} />\n      <path d={dDroplet(34, 18)} fill={color} />\n      <path d={dDroplet(34, 54)} fill={color} />\n\n      {/* Col 4 */}\n      <path d={dDroplet(50, 0)} fill={color} />\n      <path d={dDroplet(50, 36)} fill={color} />\n    </svg>\n  );\n};\n\nexport const TrainLikeChampionSection: React.FC<TrainLikeChampionSectionProps> = ({\n  className = \"\",\n}) => {\n  return (\n    <section className={`w-full select-none relative ${className}`}>\n      {/* 1. Droplets + Header Section:\n             - Left droplet positioned above the title on the left\n             - Right droplet positioned at the right edge\n             - Maintains identical relative coordinates across desktop, tablet, and mobile!\n      */}\n      <div className=\"w-full relative flex items-start justify-between pb-3 sm:pb-4\">\n        {/* Left column: Droplet and Title/Subtitle */}\n        <div className=\"flex flex-col items-start relative z-10 max-w-[80%]\">\n          {/* Top-Left Droplet Pattern */}\n          <div className=\"mb-2 sm:mb-3 pointer-events-none\">\n            <TopLeftDropletGroup />\n          </div>\n\n          {/* Section Heading */}\n          <h2\n            className=\"text-[18px] sm:text-[22px] md:text-[28px] lg:text-[36px] font-extrabold text-[#2A2B2E] tracking-tight leading-tight\"\n          >\n            Train Like a Champion\n          </h2>\n\n          {/* Section Subtitle */}\n          <p\n            className=\"text-[11px] sm:text-xs md:text-sm lg:text-[15px] font-medium text-slate-500 mt-1 sm:mt-1.5 leading-relaxed\"\n          >\n            Unleash Your Power with Expert Boxing Training\n          </p>\n        </div>\n\n        {/* Right column: Top-Right Droplet Pattern anchored cleanly */}\n        <div className=\"pt-2 sm:pt-4 flex-shrink-0 pointer-events-none\">\n          <TopRightDropletGroup />\n        </div>\n      </div>\n\n      {/* 2. Main Black Card Container with Smooth Curved Corners matching screenshot */}\n      <div\n        className=\"w-full bg-black text-white rounded-[24px] sm:rounded-[30px] md:rounded-[36px] lg:rounded-[40px] p-4 sm:p-6 md:p-8 lg:p-10 mt-3 sm:mt-4 relative overflow-hidden\"\n      >\n        <div\n          className=\"w-full flex flex-col lg:flex-row gap-6 md:gap-8 lg:gap-10 items-stretch\"\n        >\n          {/* Left: Athlete Photo Card with rounded corners */}\n          <div\n            className=\"w-full md:w-[42%] lg:w-[35%] xl:w-[33%] aspect-[4/3] sm:aspect-[3/4] rounded-[18px] sm:rounded-[22px] md:rounded-[26px] overflow-hidden bg-neutral-900 flex-shrink-0 relative shadow-inner\"\n          >\n            <img\n              src={boxerImg}\n              alt=\"Male athletic boxer champion in training\"\n              className=\"w-full h-full object-cover object-top\"\n              loading=\"lazy\"\n            />\n          </div>\n\n          {/* Right: Two Columns of Training Focus & Why Train With Us */}\n          <div\n            className=\"flex-1 flex flex-col sm:flex-row gap-6 sm:gap-8 lg:gap-10 justify-between\"\n          >\n            {/* Column A: Training Focus Areas */}\n            <div className=\"flex-1 flex flex-col justify-between space-y-5 sm:space-y-6\">\n              <div>\n                <h3 className=\"text-sm sm:text-base md:text-lg font-bold text-white tracking-tight\">\n                  Training Focus Areas:\n                </h3>\n              </div>\n\n              {/* Point 1 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Strength &amp; Conditioning\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Develop knockout power with a mix of strength training and explosive movements.\n                </p>\n              </div>\n\n              {/* Point 2 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Speed &amp; Agility\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Sharpen your reflexes and footwork with dynamic drills that improve speed and coordination.\n                </p>\n              </div>\n\n              {/* Point 3 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Endurance Training\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Boost your stamina with high-intensity circuits that keep you fighting strong till the final round.\n                </p>\n              </div>\n            </div>\n\n            {/* Column B: Why Train With Us + Call to Action Buttons */}\n            <div className=\"flex-1 flex flex-col justify-between space-y-5 sm:space-y-6\">\n              <div>\n                <h3 className=\"text-sm sm:text-base md:text-lg font-bold text-white tracking-tight\">\n                  Why Train With Us:\n                </h3>\n              </div>\n\n              {/* Point 1 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Expert Coaches\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Our experienced boxing trainers have worked with amateur and professional athletes, ensuring you get the best training tailored to your goals.\n                </p>\n              </div>\n\n              {/* Point 2 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Flexible Programs\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Whether you\'re a beginner or seasoned boxer, we offer flexible programs that fit your schedule and needs.\n                </p>\n              </div>\n\n              {/* Call to Action: Punch Now Button + Video Play Button */}\n              <div className=\"pt-2 sm:pt-4 flex items-center gap-3 sm:gap-4\">\n                {/* Bright Green Punch Now Button */}\n                <button\n                  type=\"button\"\n                  className=\"bg-[#5DB928] hover:bg-[#68CE2C] active:scale-95 text-white font-bold text-xs sm:text-sm md:text-base px-6 sm:px-8 md:px-10 py-2.5 sm:py-3 rounded-[12px] sm:rounded-[14px] transition-all cursor-pointer shadow-lg shadow-green-900/40 select-none flex-shrink-0\"\n                >\n                  Punch Now\n                </button>\n\n                {/* Circular Play Button with Dashed/Pattern Ring */}\n                <button\n                  type=\"button\"\n                  aria-label=\"Play training video preview\"\n                  className=\"w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 rounded-full border border-dashed border-[#5DB928]/80 hover:border-[#68CE2C] flex items-center justify-center transition-all cursor-pointer active:scale-90 group flex-shrink-0\"\n                >\n                  {/* Play triangle */}\n                  <div\n                    className=\"w-0 h-0 ml-0.5 border-y-[6px] border-y-transparent border-l-[10px] border-l-[#5DB928] group-hover:border-l-[#68CE2C] transition-colors\"\n                  />\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default TrainLikeChampionSection;\n"
    raw_content: "import React from \"react\";\nimport boxerImg from \"../assets/images/boxer_champion_training_1790843406316.jpg\";\n\ninterface TrainLikeChampionSectionProps {\n  className?: string;\n}\n\n/**\n * Top-Left Droplet:\n * Horizontal dome shapes: Curved round TOP dome with soft rounded corner radius (cr) on the bottom edge\n * Matches the user request (\"droplet some radius add\") so the corners are smoothly rounded and organic.\n */\nconst TopLeftDropletGroup: React.FC<{ color?: string }> = ({ color = \"#D1D5DB\" }) => {\n  // Curved dome top, smooth rounded bottom corners with corner radius `cr`:\n  const domeD = (x: number, y: number, w = 15, h = 8, cr = 1.6) =>\n    `M ${x} ${y + h - cr}\n     A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n     Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n     L ${x + cr} ${y + h}\n     Q ${x} ${y + h} ${x} ${y + h - cr}\n     Z`;\n\n  return (\n    <svg\n      viewBox=\"0 0 84 62\"\n      className=\"w-[70px] sm:w-[82px] md:w-[96px] h-auto overflow-visible select-none\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      {/* Row 0 */}\n      <path d={domeD(4, 2)} fill={color} />\n\n      {/* Row 1 */}\n      <path d={domeD(4, 16)} fill={color} />\n      <path d={domeD(24, 16)} fill={color} />\n      <path d={domeD(44, 16)} fill={color} />\n\n      {/* Row 2 */}\n      <path d={domeD(4, 30)} fill={color} />\n      <path d={domeD(44, 30)} fill={color} />\n      <path d={domeD(64, 30)} fill={color} />\n\n      {/* Row 3 */}\n      <path d={domeD(24, 44)} fill={color} />\n      <path d={domeD(64, 44)} fill={color} />\n    </svg>\n  );\n};\n\n/**\n * Top-Right Droplet:\n * Vertical D-shaped droplets (curved left side, soft rounded straight right corners)\n * Column 1 (left): row 4 (bottom)\n * Column 2: row 1, row 3, row 4\n * Column 3: row 0, row 1, row 4\n * Column 4 (right): row 0, row 2\n */\nconst TopRightDropletGroup: React.FC<{ color?: string }> = ({ color = \"#D1D5DB\" }) => {\n  // D-droplet with subtle rounded radius on the right vertical corners:\n  const dDroplet = (x: number, y: number, w = 5.5, h = 13, cr = 1.4) =>\n    `M ${x + w} ${y + cr}\n     L ${x + w} ${y + h - cr}\n     Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n     A ${w} ${h / 2} 0 0 1 ${x + w - cr} ${y}\n     Q ${x + w} ${y} ${x + w} ${y + cr}\n     Z`;\n\n  return (\n    <svg\n      viewBox=\"0 0 68 76\"\n      className=\"w-[52px] sm:w-[60px] md:w-[68px] h-auto overflow-visible select-none\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      {/* Col 1 */}\n      <path d={dDroplet(2, 54)} fill={color} />\n\n      {/* Col 2 */}\n      <path d={dDroplet(18, 18)} fill={color} />\n      <path d={dDroplet(18, 36)} fill={color} />\n      <path d={dDroplet(18, 54)} fill={color} />\n\n      {/* Col 3 */}\n      <path d={dDroplet(34, 0)} fill={color} />\n      <path d={dDroplet(34, 18)} fill={color} />\n      <path d={dDroplet(34, 54)} fill={color} />\n\n      {/* Col 4 */}\n      <path d={dDroplet(50, 0)} fill={color} />\n      <path d={dDroplet(50, 36)} fill={color} />\n    </svg>\n  );\n};\n\nexport const TrainLikeChampionSection: React.FC<TrainLikeChampionSectionProps> = ({\n  className = \"\",\n}) => {\n  return (\n    <section className={`w-full select-none relative ${className}`}>\n      {/* 1. Droplets + Header Section:\n             - Left droplet positioned above the title on the left\n             - Right droplet positioned at the right edge\n             - Maintains identical relative coordinates across desktop, tablet, and mobile!\n      */}\n      <div className=\"w-full relative flex items-start justify-between pb-3 sm:pb-4\">\n        {/* Left column: Droplet and Title/Subtitle */}\n        <div className=\"flex flex-col items-start relative z-10 max-w-[80%]\">\n          {/* Top-Left Droplet Pattern */}\n          <div className=\"mb-2 sm:mb-3 pointer-events-none\">\n            <TopLeftDropletGroup />\n          </div>\n\n          {/* Section Heading */}\n          <h2\n            className=\"text-[18px] sm:text-[22px] md:text-[28px] lg:text-[36px] font-extrabold text-[#2A2B2E] tracking-tight leading-tight\"\n          >\n            Train Like a Champion\n          </h2>\n\n          {/* Section Subtitle */}\n          <p\n            className=\"text-[11px] sm:text-xs md:text-sm lg:text-[15px] font-medium text-slate-500 mt-1 sm:mt-1.5 leading-relaxed\"\n          >\n            Unleash Your Power with Expert Boxing Training\n          </p>\n        </div>\n\n        {/* Right column: Top-Right Droplet Pattern anchored cleanly */}\n        <div className=\"pt-2 sm:pt-4 flex-shrink-0 pointer-events-none\">\n          <TopRightDropletGroup />\n        </div>\n      </div>\n\n      {/* 2. Main Black Card Container with Smooth Curved Corners matching screenshot */}\n      <div\n        className=\"w-full bg-black text-white rounded-[24px] sm:rounded-[30px] md:rounded-[36px] lg:rounded-[40px] p-4 sm:p-6 md:p-8 lg:p-10 mt-3 sm:mt-4 relative overflow-hidden\"\n      >\n        <div\n          className=\"w-full flex flex-col lg:flex-row gap-6 md:gap-8 lg:gap-10 items-stretch\"\n        >\n          {/* Left: Athlete Photo Card with rounded corners */}\n          <div\n            className=\"w-full md:w-[42%] lg:w-[35%] xl:w-[33%] aspect-[4/3] sm:aspect-[3/4] rounded-[18px] sm:rounded-[22px] md:rounded-[26px] overflow-hidden bg-neutral-900 flex-shrink-0 relative shadow-inner\"\n          >\n            <img\n              src={boxerImg}\n              alt=\"Male athletic boxer champion in training\"\n              className=\"w-full h-full object-cover object-top\"\n              loading=\"lazy\"\n            />\n          </div>\n\n          {/* Right: Two Columns of Training Focus & Why Train With Us */}\n          <div\n            className=\"flex-1 flex flex-col sm:flex-row gap-6 sm:gap-8 lg:gap-10 justify-between\"\n          >\n            {/* Column A: Training Focus Areas */}\n            <div className=\"flex-1 flex flex-col justify-between space-y-5 sm:space-y-6\">\n              <div>\n                <h3 className=\"text-sm sm:text-base md:text-lg font-bold text-white tracking-tight\">\n                  Training Focus Areas:\n                </h3>\n              </div>\n\n              {/* Point 1 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Strength &amp; Conditioning\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Develop knockout power with a mix of strength training and explosive movements.\n                </p>\n              </div>\n\n              {/* Point 2 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Speed &amp; Agility\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Sharpen your reflexes and footwork with dynamic drills that improve speed and coordination.\n                </p>\n              </div>\n\n              {/* Point 3 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Endurance Training\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Boost your stamina with high-intensity circuits that keep you fighting strong till the final round.\n                </p>\n              </div>\n            </div>\n\n            {/* Column B: Why Train With Us + Call to Action Buttons */}\n            <div className=\"flex-1 flex flex-col justify-between space-y-5 sm:space-y-6\">\n              <div>\n                <h3 className=\"text-sm sm:text-base md:text-lg font-bold text-white tracking-tight\">\n                  Why Train With Us:\n                </h3>\n              </div>\n\n              {/* Point 1 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Expert Coaches\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Our experienced boxing trainers have worked with amateur and professional athletes, ensuring you get the best training tailored to your goals.\n                </p>\n              </div>\n\n              {/* Point 2 */}\n              <div>\n                <h4 className=\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\">\n                  Flexible Programs\n                </h4>\n                <p className=\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\">\n                  Whether you\'re a beginner or seasoned boxer, we offer flexible programs that fit your schedule and needs.\n                </p>\n              </div>\n\n              {/* Call to Action: Punch Now Button + Video Play Button */}\n              <div className=\"pt-2 sm:pt-4 flex items-center gap-3 sm:gap-4\">\n                {/* Bright Green Punch Now Button */}\n                <button\n                  type=\"button\"\n                  className=\"bg-[#5DB928] hover:bg-[#68CE2C] active:scale-95 text-white font-bold text-xs sm:text-sm md:text-base px-6 sm:px-8 md:px-10 py-2.5 sm:py-3 rounded-[12px] sm:rounded-[14px] transition-all cursor-pointer shadow-lg shadow-green-900/40 select-none flex-shrink-0\"\n                >\n                  Punch Now\n                </button>\n\n                {/* Circular Play Button with Dashed/Pattern Ring */}\n                <button\n                  type=\"button\"\n                  aria-label=\"Play training video preview\"\n                  className=\"w-10 h-10 sm:w-11 