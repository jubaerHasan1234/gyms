      {children}\\n      </body>\\n    </html>\\n  );\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/app/layout.tsx\", \"toolAction\":\"Creating layout.tsx\", \"toolSummary\":\"Create layout.tsx\"}"
