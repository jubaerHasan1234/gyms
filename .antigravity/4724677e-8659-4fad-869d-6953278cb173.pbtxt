    end_line: 24
    content: "import React, { useState } from \"react\";\nimport { Plus, Check, Star } from \"lucide-react\";\n\n// Imported product images\nimport mintDarkImg from \"../assets/images/mint_dark_choc_1790758788483.jpg\";\nimport mintBarImg from \"../assets/images/mint_bar_green_1790758818267.jpg\";\nimport brokenChocImg from \"../assets/images/broken_choc_pink_1790758842063.jpg\";\nimport orangeDarkImg from \"../assets/images/orange_dark_choc_1790758867028.jpg\";\nimport mintRibbedImg from \"../assets/images/mint_chocolate_bar_1790758888858.jpg\";\nimport whiteCashewImg from \"../assets/images/white_choc_cashew_1790758905121.jpg\";\n\nexport interface ProductItem {\n  id: number;\n  title: string;\n  price: string;\n  rating: number;\n  image: string;\n  alt: string;\n}\n\nconst PRODUCTS: ProductItem[] = [\n  {\n    id: 1,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\","
    raw_content: "import React, { useState } from \"react\";\nimport { Plus, Check, Star } from \"lucide-react\";\n\n// Imported product images\nimport mintDarkImg from \"../assets/images/mint_dark_choc_1790758788483.jpg\";\nimport mintBarImg from \"../assets/images/mint_bar_green_1790758818267.jpg\";\nimport brokenChocImg from \"../assets/images/broken_choc_pink_1790758842063.jpg\";\nimport orangeDarkImg from \"../assets/images/orange_dark_choc_1790758867028.jpg\";\nimport mintRibbedImg from \"../assets/images/mint_chocolate_bar_1790758888858.jpg\";\nimport whiteCashewImg from \"../assets/images/white_choc_cashew_1790758905121.jpg\";\n\nexport interface ProductItem {\n  id: number;\n  title: string;\n  price: string;\n  rating: number;\n  image: string;\n  alt: string;\n}\n\nconst PRODUCTS: ProductItem[] = [\n  {\n    id: 1,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: mintDarkImg,\n    alt: \"Mint Dark Chocolate Squares\",\n  },\n  {\n    id: 2,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: mintBarImg,\n    alt: \"Mint Dark Chocolate Bar\",\n  },\n  {\n    id: 3,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: brokenChocImg,\n    alt: \"Broken Dark Chocolate Chunks\",\n  },\n  {\n    id: 4,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: orangeDarkImg,\n    alt: \"Orange Stacked Chocolate\",\n  },\n  {\n    id: 5,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: mintRibbedImg,\n    alt: \"Mint Ribbed Chocolate Bar\",\n  },\n  {\n    id: 6,\n    title: \"Mint flavor chocolate\",\n    price: \"\342\202\271399.00\",\n    rating: 5,\n    image: whiteCashewImg,\n    alt: \"White Chocolate Cashew Blocks\",\n  },\n];\n\nexport interface OurProductsSectionProps {\n  className?: string;\n}\n\nexport const OurProductsSection: React.FC<OurProductsSectionProps> = ({\n  className = \"\",\n}) => {\n  const [addedIds, setAddedIds] = useState<number[]>([]);\n\n  const handleAddProduct = (id: number) => {\n    setAddedIds((prev) =>\n      prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id]\n    );\n  };\n\n  return (\n    <section id=\"products\" className={`w-full pt-2 sm:pt-3 md:pt-4 pb-6 sm:pb-10 md:pb-14 px-4 sm:px-6 md:px-8 lg:px-10 select-none relative scroll-mt-6 ${className}`}>\n      {/* 1. Fully Responsive Header with Title */}\n      <div className=\"w-full relative pt-2 sm:pt-4 pb-1 flex items-center justify-between overflow-visible z-10\">\n        <div className=\"flex items-center gap-2 sm:gap-3 flex-shrink-0\">\n          <h2\n            className=\"text-[14px] sm:text-[16px] md:text-[20px] lg:text-[40px] font-extrabold text-[#2A2B2E] tracking-tight leading-tight whitespace-nowrap pb-0\"\n          >\n            Our Products\n          </h2>\n        </div>\n      </div>\n\n      {/* 2. Responsive Subtitle below Header */}\n      <div className=\"w-full mb-5 sm:mb-7 md:mb-9 mt-1 sm:mt-1.5 md:mt-2 relative z-10\">\n        <p\n          className=\"text-[10px] sm:text-[11px] md:text-[13px] lg:text-base font-medium text-slate-500 max-w-2xl leading-relaxed\"\n        >\n          Fuel Your Workouts with Protein-Packed Nutrition\n        </p>\n      </div>\n\n      {/* 3. Responsive Product Grid:\n             - Mobile Screen: 1 product per row\n             - Tablet Screen: 2 products per row\n             - Desktop Screen: 3 products per row\n      */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-7\">\n        {PRODUCTS.map((prod) => {\n          const isAdded = addedIds.includes(prod.id);\n          return (\n            <div\n              key={prod.id}\n              className=\"group bg-black rounded-[24px] sm:rounded-[28px] md:rounded-[32px] p-3.5 sm:p-4 flex flex-col justify-between transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 w-full\"\n            >\n              {/* Image Container with smooth rounded corners matching reference */}\n              <div className=\"w-full aspect-square rounded-[18px] sm:rounded-[22px] md:rounded-[26px] overflow-hidden bg-neutral-900 relative\">\n                <img\n                  src={prod.image}\n                  alt={prod.alt}\n                  className=\"w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105\"\n                  loading=\"lazy\"\n                />\n              </div>\n\n              {/* Product Info Footer inside black card */}\n              <div className=\"pt-3 sm:pt-3.5 pb-1 px-1 sm:px-1.5 flex items-center justify-between gap-2\">\n                <div className=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n                  <h3 className=\"text-white text-sm sm:text-base font-semibold tracking-tight truncate\">\n                    {prod.title}\n                  </h3>\n                  <div className=\"flex items-center gap-2 mt-0.5 flex-wrap\">\n                    <span className=\"text-white font-bold text-base sm:text-lg tracking-tight whitespace-nowrap\">\n                      {prod.price}\n                    </span>\n                    {/* 5 Green Stars */}\n                    <div className=\"flex items-center gap-0.5 flex-shrink-0\">\n                      {[...Array(5)].map((_, i) => (\n                        <Star\n                          key={i}\n                          className=\"w-3 h-3 sm:w-3.5 sm:h-3.5 fill-[#47B727] text-[#47B727]\"\n                        />\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bright Green Plus / Added Button */}\n                <button\n                  type=\"button\"\n                  onClick={() => handleAddProduct(prod.id)}\n                  aria-label={`Add ${prod.title}`}\n                  className={`w-9 h-9 sm:w-10 sm:h-10 md:w-11 md:h-11 rounded-xl flex items-center justify-center flex-shrink-0 transition-all cursor-pointer select-none active:scale-90 ${\n                    isAdded\n                      ? \"bg-[#358a1c] text-white\"\n                      : \"bg-[#49B829] hover:bg-[#52ce2e] text-white shadow-md shadow-green-900/30\"\n                  }`}\n                >\n                  {isAdded ? (\n                    <Check className=\"w-5 h-5 sm:w-5.5 sm:h-5.5 stroke-[2.5]\" />\n                  ) : (\n                    <Plus className=\"w-5 h-5 sm:w-5.5 sm:h-5.5 stroke-[2.5]\" />\n                  )}\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </section>\n  );\n};\n\nexport default OurProductsSection;\n"
    num_lines: 181
    num_bytes: 6494
  }
}
