      arguments_json: "{\"Content\":\"import HeroSection from \'@/components/HeroSection\';\\nimport { ProductDropletsOverlay } from \'@/components/ProductDropletsOverlay\';\\nimport { OurProductsSection } from \'@/components/OurProductsSection\';\\nimport { TrainLikeChampionSection } from \'@/components/TrainLikeChampionSection\';\\nimport { ClientsSayingSection } from \'@/components/ClientsSayingSection\';\\nimport { NewsletterSection } from \'@/components/NewsletterSection\';\\nimport { FooterSection } from \'@/components/FooterSection\';\\n\\nexport default function HomePage() {\\n  return (\\n    <div className=\\\"min-h-screen bg-[#ffffff] flex flex-col items-center\\\">\\n      {/* Main Canvas Container */}\\n      <main className=\\\"w-full max-w-[1480px] p-3 sm:p-6 lg:p-8 mx-auto flex flex-col\\\">\\n        {/* Responsive Hero Section - seamless with website background, no shadow, no rounded card border */}\\n        <div className=\\\"w-full overflow-hidden bg-white\\\">\\n          <HeroSection />\\n        </div>\\n\\n        {/* ProductDropletsOverlay component directly above Our Products Section */}\\n        <div className=\\\"w-full relative bg-white select-none pointer-events-none\\\">\\n          <ProductDropletsOverlay />\\n        </div>\\n\\n        {/* Our Products Section directly joined together with zero gap */}\\n        <div className=\\\"w-full bg-white m-0 p-0\\\">\\n          <OurProductsSection />\\n        </div>\\n\\n        {/* Train Like a Champion (Expert Boxing Training) Section */}\\n        <div className=\\\"w-full bg-white m-0 p-0\\\">\\n          <TrainLikeChampionSection />\\n        </div>\\n\\n        {/* What Our Clients Are Saying Testimonials Section */}\\n        <div className=\\\"w-full bg-white m-0 p-0\\\">\\n          <ClientsSayingSection />\\n        </div>\\n\\n        {/* Subscribe to our Newsletter Section */}\\n        <div className=\\\"w-full bg-white m-0 p-0\\\">\\n          <NewsletterSection />\\n        </div>\\n\\n        {/* Full Responsive Modern Attractive Footer Section */}\\n        <div className=\\\"w-full bg-white m-0 p-0 mt-4 sm:mt-10 md:mt-6\\\">\\n          <FooterSection />\\n        </div>\\n      </main>\\n    </div>\\n  );\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/app/page.tsx\", \"toolAction\":\"Creating page.tsx\", \"toolSummary\":\"Create page.tsx\"}"
