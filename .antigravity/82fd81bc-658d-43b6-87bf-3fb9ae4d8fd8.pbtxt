  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 77
    content: "import React, { useState } from \'react\';\nimport HeroSection from \'./components/HeroSection\';\nimport { ProductDropletsOverlay } from \'./components/ProductDropletsOverlay\';\nimport { OurProductsSection } from \'./components/OurProductsSection\';\nimport { TrainLikeChampionSection } from \'./components/TrainLikeChampionSection\';\nimport { ClientsSayingSection } from \'./components/ClientsSayingSection\';\nimport { NewsletterSection } from \'./components/NewsletterSection\';\nimport { FooterSection } from \'./components/FooterSection\';\nimport { ViewportSwitcher, ViewportMode } from \'./components/ViewportSwitcher\';\n\nexport default function App() {\n  const [viewportMode, setViewportMode] = useState<ViewportMode>(\'responsive\');\n\n  const getContainerWidthClass = () => {\n    switch (viewportMode) {\n      case \'desktop\':\n        return \'max-w-[1440px] shadow-2xl rounded-[32px] my-6 p-4 sm:p-6 lg:p-8 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'tablet\':\n        return \'max-w-[820px] shadow-2xl rounded-[28px] my-6 p-4 sm:p-6 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'mobile\':\n        return \'max-w-[390px] shadow-2xl rounded-[24px] my-6 p-3 sm:p-4 bg-[#ffffff] ring-1 ring-black/10\';\n      default:\n        return \'w-full max-w-[1480px] p-3 sm:p-6 lg:p-8\';\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#ffffff] flex flex-col items-center\">\n      {/* 1. Device Viewport Simulator Bar for responsive verification */}\n      <ViewportSwitcher\n        currentMode={viewportMode}\n        onModeChange={(mode) => setViewportMode(mode)}\n      />\n\n      {/* 2. Main Canvas Container */}\n      <main\n        className={`w-full transition-all duration-300 mx-auto flex flex-col ${getContainerWidthClass()}`}\n      >\n        {/* Responsive Hero Section - seamless with website background, no shadow, no rounded card border */}\n        <div className=\"w-full overflow-hidden bg-white\">\n          <HeroSection />\n        </div>\n\n        {/* ProductDropletsOverlay component in App.tsx directly above Our Products Section */}\n        <div className=\"w-full relative bg-white select-none pointer-events-none\">\n          <ProductDropletsOverlay />\n        </div>\n\n        {/* Our Products Section directly joined together with zero gap */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <OurProductsSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Train Like a Champion (Expert Boxing Training) Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <TrainLikeChampionSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* What Our Clients Are Saying Testimonials Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <ClientsSayingSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Subscribe to our Newsletter Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <NewsletterSection forcedViewport={viewportMode} />\n        </div>\n\n\n        {/* Full Responsive Modern Attractive Footer Section */}\n        <div className=\"w-full bg-white m-0 p-0 mt-4 sm:mt-10 md:mt-6\">\n          <FooterSection forcedViewport={viewportMode} />\n        </div>\n      </main>\n    </div>\n  );\n}\n"
    raw_content: "import React, { useState } from \'react\';\nimport HeroSection from \'./components/HeroSection\';\nimport { ProductDropletsOverlay } from \'./components/ProductDropletsOverlay\';\nimport { OurProductsSection } from \'./components/OurProductsSection\';\nimport { TrainLikeChampionSection } from \'./components/TrainLikeChampionSection\';\nimport { ClientsSayingSection } from \'./components/ClientsSayingSection\';\nimport { NewsletterSection } from \'./components/NewsletterSection\';\nimport { FooterSection } from \'./components/FooterSection\';\nimport { ViewportSwitcher, ViewportMode } from \'./components/ViewportSwitcher\';\n\nexport default function App() {\n  const [viewportMode, setViewportMode] = useState<ViewportMode>(\'responsive\');\n\n  const getContainerWidthClass = () => {\n    switch (viewportMode) {\n      case \'desktop\':\n        return \'max-w-[1440px] shadow-2xl rounded-[32px] my-6 p-4 sm:p-6 lg:p-8 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'tablet\':\n        return \'max-w-[820px] shadow-2xl rounded-[28px] my-6 p-4 sm:p-6 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'mobile\':\n        return \'max-w-[390px] shadow-2xl rounded-[24px] my-6 p-3 sm:p-4 bg-[#ffffff] ring-1 ring-black/10\';\n      default:\n        return \'w-full max-w-[1480px] p-3 sm:p-6 lg:p-8\';\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#ffffff] flex flex-col items-center\">\n      {/* 1. Device Viewport Simulator Bar for responsive verification */}\n      <ViewportSwitcher\n        currentMode={viewportMode}\n        onModeChange={(mode) => setViewportMode(mode)}\n      />\n\n      {/* 2. Main Canvas Container */}\n      <main\n        className={`w-full transition-all duration-300 mx-auto flex flex-col ${getContainerWidthClass()}`}\n      >\n        {/* Responsive Hero Section - seamless with website background, no shadow, no rounded card border */}\n        <div className=\"w-full overflow-hidden bg-white\">\n          <HeroSection />\n        </div>\n\n        {/* ProductDropletsOverlay component in App.tsx directly above Our Products Section */}\n        <div className=\"w-full relative bg-white select-none pointer-events-none\">\n          <ProductDropletsOverlay />\n        </div>\n\n        {/* Our Products Section directly joined together with zero gap */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <OurProductsSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Train Like a Champion (Expert Boxing Training) Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <TrainLikeChampionSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* What Our Clients Are Saying Testimonials Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <ClientsSayingSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Subscribe to our Newsletter Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <NewsletterSection forcedViewport={viewportMode} />\n        </div>\n\n\n        {/* Full Responsive Modern Attractive Footer Section */}\n        <div className=\"w-full bg-white m-0 p-0 mt-4 sm:mt-10 md:mt-6\">\n          <FooterSection forcedViewport={viewportMode} />\n        </div>\n      </main>\n    </div>\n  );\n}\n"
    num_lines: 78
    num_bytes: 3192
  }
}
