    content: "import React from \"react\";\nimport { ViewportMode } from \"./ViewportSwitcher\";\n\nexport interface FooterSectionProps {\n  forcedViewport?: ViewportMode;\n  className?: string;\n}\n\nexport const FooterSection: React.FC<FooterSectionProps> = ({\n  forcedViewport = \"responsive\",\n  className = \"\",\n}) => {\n  // Responsive grid styling helper based on forcedViewport or fluid responsive CSS\n  const getGridClasses = () => {\n    switch (forcedViewport) {\n      case \"mobile\":\n        return \"grid grid-cols-1 gap-8\";\n      case \"tablet\":\n        return \"grid grid-cols-2 gap-8 md:gap-10\";\n      case \"desktop\":\n        return \"grid grid-cols-4 gap-8 lg:gap-10 xl:gap-12\";\n      default:\n        // Fluid responsive classes for all screen sizes:\n        // mobile: 1 column, tablet (sm/md): 2 columns, desktop (lg): 4 columns\n        return \"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-8 md:gap-10 lg:gap-10 xl:gap-12\";\n    }\n  };\n\n  return (\n    <footer\n      className={`w-full bg-white text-neutral-900 select-text transition-all duration-200 pt-4 sm:pt-10 md:pt-4 ${className}`}\n      aria-label=\"Site Footer\"\n    >\n      {/* \n        1. TOP HORIZONTAL DIVIDER LINE"
    raw_content: "import React from \"react\";\nimport { ViewportMode } from \"./ViewportSwitcher\";\n\nexport interface FooterSectionProps {\n  forcedViewport?: ViewportMode;\n  className?: string;\n}\n\nexport const FooterSection: React.FC<FooterSectionProps> = ({\n  forcedViewport = \"responsive\",\n  className = \"\",\n}) => {\n  // Responsive grid styling helper based on forcedViewport or fluid responsive CSS\n  const getGridClasses = () => {\n    switch (forcedViewport) {\n      case \"mobile\":\n        return \"grid grid-cols-1 gap-8\";\n      case \"tablet\":\n        return \"grid grid-cols-2 gap-8 md:gap-10\";\n      case \"desktop\":\n        return \"grid grid-cols-4 gap-8 lg:gap-10 xl:gap-12\";\n      default:\n        // Fluid responsive classes for all screen sizes:\n        // mobile: 1 column, tablet (sm/md): 2 columns, desktop (lg): 4 columns\n        return \"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-8 md:gap-10 lg:gap-10 xl:gap-12\";\n    }\n  };\n\n  return (\n    <footer\n      className={`w-full bg-white text-neutral-900 select-text transition-all duration-200 pt-4 sm:pt-10 md:pt-4 ${className}`}\n      aria-label=\"Site Footer\"\n    >\n      {/* \n        1. TOP HORIZONTAL DIVIDER LINE\n        Exact clean hairline border matching the screenshot across the full container width\n      */}\n      <div className=\"w-full border-t border-neutral-300 mb-8 sm:mb-10 lg:mb-12\" />\n\n      <div className=\"w-full px-4 sm:px-6 md:px-8 lg:px-10 max-w-[1400px] mx-auto\">\n        {/* \n          2. MAIN 4-COLUMN FOOTER CONTENT\n          Matches screenshot:\n          [About]  [Quick Links]  [Our Service]  [Contact Info]\n        */}\n        <div className={getGridClasses()}>\n          {/* ========================================================\n              COLUMN 1: ABOUT\n              - Heading: About\n              - Paragraph: \"At MuscleForge, we believe in the power of dedication and hard work...\"\n              - Divider line\n              - \"Social Media: Fb In Tw\"\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              About\n            </h3>\n\n            <p className=\"text-xs sm:text-[13px] md:text-sm text-neutral-600 leading-relaxed max-w-sm mb-4\">\n              At MuscleForge, we believe in the power of dedication and hard\n              work. Our mission is to provide you with the tools, resources, and\n              community you need to build the body of your dreams\n            </p>\n\n            {/* Subtle Divider under About paragraph matching the screenshot */}\n            <div className=\"w-36 sm:w-44 border-t border-neutral-300 my-2 sm:my-3\" />\n\n            {/* Social Media Line matching screenshot \"Social Media: Fb In Tw\" */}\n            <div className=\"mt-2 flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs sm:text-sm\">\n              <span className=\"font-semibold text-neutral-900 select-none\">\n                Social Media:\n              </span>\n\n              <div className=\"inline-flex items-center gap-2\">\n                <a\n                  href=\"#facebook\"\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1 py-0.5 rounded transition-colors\"\n                  aria-label=\"Facebook\"\n                >\n                  Fb\n                </a>\n\n                <a\n                  href=\"#instagram\"\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1 py-0.5 rounded transition-colors\"\n                  aria-label=\"Instagram\"\n                >\n                  In\n                </a>\n\n                <a\n                  href=\"#twitter\"\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1 py-0.5 rounded transition-colors\"\n                  aria-label=\"Twitter\"\n                >\n                  Tw\n                </a>\n              </div>\n            </div>\n          </div>\n\n          {/* ========================================================\n              COLUMN 2: QUICK LINKS\n              - Heading: Quick Links\n              - Items:\n                \342\200\242 Home\n                \342\200\242 Our gym location\n                \342\200\242 Contact Us\n                \342\200\242 Privacy policy\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Quick Links\n            </h3>\n\n            <ul className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              <li>\n                <a\n                  href=\"#home\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Home\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#location\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Our gym location\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#contact\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Contact Us\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#privacy\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Privacy policy\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* ========================================================\n              COLUMN 3: OUR SERVICE\n              - Heading: Our Service\n              - Items:\n                \342\200\242 Indoor gym\n                \342\200\242 Outdoor gym\n                \342\200\242 On ground gym\n                \342\200\242 Yoga class\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Our Service\n            </h3>\n\n            <ul className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              <li>\n                <a\n                  href=\"#indoor-gym\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Indoor gym\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#outdoor-gym\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Outdoor gym\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#ground-gym\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  On ground gym\n                </a>\n              </li>\n\n              <li>\n                <a\n                  href=\"#yoga-class\"\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all inline-block\"\n                >\n                  Yoga class\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* ========================================================\n              COLUMN 4: CONTACT INFO\n              - Heading: Contact Info\n              - Mail: info@example.com\n              - Call: +91 9876543210\n              - Location: New York, 235 Lane, 10001\n              - Time: Workout Hours: 5AM - 8PM\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Contact Info\n            </h3>\n\n            <div className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              {/* Mail */}\n              <div className=\"flex items-center flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900\">Mail:</span>\n                <a\n                  href=\"mailto:info@example.com\"\n                  className=\"hover:text-neutral-900 hover:underline transition-colors\"\n                >\n                  info@example.com\n                </a>\n              </div>\n\n              {/* Call */}\n              <div className=\"flex items-center flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900\">Call:</span>\n                <a\n                  href=\"tel:+919876543210\"\n                  className=\"hover:text-neutral-900 hover:underline transition-colors tabular-nums\"\n                >\n                  +91 9876543210\n                </a>\n              </div>\n\n              {/* Location */}\n              <div className=\"flex items-start flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900 shrink-0\">\n                  Location:\n                </span>\n                <span className=\"text-neutral-700\">\n                  New York, 235 Lane, 10001\n                </span>\n              </div>\n\n              {/* Workout Hours Time */}\n              <div className=\"flex items-baseline flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900 shrink-0\">\n                  Time:\n                </span>\n                <span className=\"text-neutral-700\">\n                  Workout Hours: 5AM - 8PM\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* \n          3. CENTER DIVIDER LINE\n          Matches the exact centered divider from the user\'s reference screenshot\n        */}\n        <div className=\"mt-8 sm:mt-10 md:mt-12 mb-5 sm:mb-6 flex justify-center\">\n          <div className=\"w-40 sm:w-60 md:w-80 border-t border-neutral-300\" />\n        </div>\n\n        {/* \n          4. BOTTOM COPYRIGHT TEXT\n          Matches screenshot:\n          \"websitename.com\302\2512024 all right reserve\"\n        */}\n        <div className=\"pb-8 sm:pb-10 text-center\">\n          <p className=\"text-xs sm:text-[13px] text-neutral-500 font-normal tracking-tight\">\n            websitename.com\302\2512024 all right reserve\n          </p>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default FooterSection;\n"
    num_lines: 291
    num_bytes: 10632
  }
}
