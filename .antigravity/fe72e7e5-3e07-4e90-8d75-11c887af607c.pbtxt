  view_file {
    absolute_path_uri: "file:///src/components/HeroSection.tsx"
    end_line: 554
    content: "\"use client\";\nimport React, { ReactElement } from \"react\";\nimport { motion } from \"framer-motion\";\nimport Image from \"./NextImageShim\";\nimport ShapePatternSvg from \"./ShapePatternSvg\";\n\ninterface HeroSectionProps {}\n\nconst HeroSection: React.FC<HeroSectionProps> = () => {\n  const heroPath =\n    \"M 554 87 C 620 86 603 108 607 208 V 317 L 607 391 C 609 576 618 576 534 573 H 292 C 181 572 178 572 178 484 L 176 355 V 312 C 176 276 181 241 149 231 L 105 216 L 64 203 C 11 187 0 182 -7 164 C -7 164 -34 74 40 82 C 109 69 77 14 114 20 L 354 23 C 461 20 359 78 464 84 Z\";\n\n  const servicePath =\n    \"M 218 118 C 216 356 228 371 176 369 H 143 H 75 H 27.5 C -6 368 -7 368 -8 299 V -20 C -8 -35 -4 -59 17 -56 C 66 -45 69 -44 111 -31 L 194 -1 C 221 14 218 75 218 58 Z\";\n\n  const specialties = [\n    { title: \"Ground running\", image: \"/images/running.png\" },\n    { title: \"Yoga Assistance\", image: \"/images/yoga.png\" },\n    { title: \"Personal Trainer\", image: \"/images/personalTesting.png\" },\n  ];\n\n  // Helper to render authentic Figma droplet/capsule shapes (flat top with subtle rounded corners, curved bowl bottom)\n  const renderFigmaDroplet = (\n    x: number,\n    y: number,\n    key: string,\n    w: number = 21,\n    h: number = 10.5,\n    fill: string = \"#89C53A\"\n  ): ReactElement => (\n    <path\n      key={key}\n      d={`M ${x + 1.5} ${y} \n         h ${w - 3} \n         q 1.5 0 1.5 1.5 \n         v 0.5 \n         c 0 ${h - 2} -${w / 2} ${h - 2} -${w / 2} ${h - 2} \n         s -${w / 2} 0 -${w / 2} -${h - 2} \n         v -0.5 \n         q 0 -1.5 1.5 -1.5 \n         z`}\n      fill={fill}\n    />\n  );\n\n  return (\n    /*\n      The container preserves the exact 800/600 (4:3) aspect ratio with Container Queries (cqw).\n      By consistently using cqw (container query width units) without breaking clamps/min-widths,\n      every shape, text, card, and pattern stays at the EXACT SAME relative position on ALL devices.\n    */\n    <div className=\"relative w-full aspect-[800/600] bg-white overflow-hidden select-none [container-type:inline-size]\">\n      \n      {/* Background Hero Layer (Black Hero Shape) */}\n      <div className=\"absolute inset-0 z-0 pointer-events-none\">\n        <svg\n          viewBox=\"0 0 800 600\"\n          preserveAspectRatio=\"none\"\n          className=\"w-full h-full\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Hero Shape (Black) */}\n          <path\n            d={heroPath}\n            fill=\"black\"\n            transform=\"translate(30, 0) scale(1.266, 1)\"\n            className=\"transition-all duration-500 ease-in-out\"\n          />\n        </svg>\n      </div>\n\n      {/* Decorative Droplet SVG Patterns across the canvas */}\n      <ShapePatternSvg />\n\n      {/* Top Header Navigation */}\n      <div className=\"absolute top-[2.4%] left-[2.8%] right-[2.8%] z-30 flex items-center justify-between pointer-events-auto\">\n        {/* Brand Logo Button: Vibrant Lime Green circle with logo.png rotated -45 deg */}\n        <a\n          href=\"#\"\n          onClick={(e) => {\n            e.preventDefault();\n            window.scrollTo({ top: 0, behavior: \"smooth\" });\n          }}\n          className=\"flex items-center justify-center rounded-full bg-[#71AC16] shadow-md hover:scale-105 transition-transform\"\n          style={{\n            width: \"5.8cqw\",\n            height: \"5.8cqw\",\n          }}\n          aria-label=\"Home\"\n        >\n          <img\n            src=\"/images/logo.png\"\n            alt=\"Logo\"\n            width={48}\n            height={48}\n            className=\"w-[58%] h-[58%] object-contain\"\n            style={{\n              transform: \"rotate(-45deg)\",\n            }}\n          />\n        </a>\n\n        {/* Center Nav Pill: Black background with subtle crisp white border and reduced shadow */}\n        <div\n          className=\"flex items-center bg-black border border-white/90 rounded-full text-white shadow-sm\"\n          style={{\n            padding: \"0.55cqw 0.75cqw 0.55cqw 2.8cqw\",\n            gap: \"2.2cqw\",\n            transform: \"translate(-7.1cqw, 1.4cqw)\",\n          }}\n        >\n          <a\n            href=\"#home\"\n            className=\"text-white hover:text-white/80 transition-colors font-normal whitespace-nowrap\"\n            style={{\n              fontSize: \"1.25cqw\",\n              letterSpacing: \"-0.01em\",\n            }}\n          >\n            Home\n          </a>\n          <a\n            href=\"#gym-location\"\n            className=\"text-white hover:text-[#71AC16] transition-colors cursor-pointer font-normal whitespace-nowrap\"\n            style={{\n              fontSize: \"1.25cqw\",\n              letterSpacing: \"-0.01em\",\n            }}\n          >\n            Our gym location\n          </a>\n          \n          {/* Vertical Separator */}\n          <span\n            className=\"text-white font-light select-none opacity-80\"\n            style={{\n              fontSize: \"1.15cqw\",\n              margin: \"0 0.2cqw\",\n            }}\n          >\n            |\n          </span>\n\n          {/* Search Pill inside: Dark Charcoal oval pill matching screenshot proportions */}\n          <div\n            className=\"flex items-center justify-between bg-[#383A3D] hover:bg-[#424448] rounded-full transition-colors cursor-pointer\"\n            style={{\n              padding: \"0.5cqw 1.25cqw\",\n              gap: \"1.2cqw\",\n              width: \"9.5cqw\",\n            }}\n          >\n            <input\n              type=\"text\"\n              placeholder=\"Search\"\n              className=\"bg-transparent outline-none placeholder:text-white text-white font-normal w-full select-none\"\n              style={{\n                fontSize: \"1.25cqw\",\n                lineHeight: \"1\",\n              }}\n            />\n            {/* White solid filled magnifying glass icon matching screenshot */}\n            <svg\n              style={{ width: \"1.25cqw\", height: \"1.25cqw\" }}\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              className=\"text-white flex-shrink-0\"\n            >\n              {/* Thick ring with white stroke */}\n              <circle\n                cx=\"10\"\n                cy=\"10\"\n                r=\"6.5\"\n                stroke=\"white\"\n                strokeWidth=\"3.2\"\n              />\n              {/* Thick rounded angled handle */}\n              <line\n                x1=\"15\"\n                y1=\"15\"\n                x2=\"21\"\n                y2=\"21\"\n                stroke=\"white\"\n                strokeWidth=\"3.5\"\n                strokeLinecap=\"round\"\n              />\n            </svg>\n          </div>\n        </div>\n\n        {/* REGI Button - all side padding, more right padding, shifted left and more bottom */}\n        <div\n          className=\"bg-[#6FA816] hover:bg-[#78B419] text-white font-extrabold tracking-wider rounded-full transition-all uppercase select-none flex items-center justify-center shadow-sm cursor-default\"\n          style={{\n            padding: \"1.05cqw 12.8cqw 1.05cqw 3.6cqw\",\n            fontSize: \"1.5cqw\",\n            transform: \"translate(-6.9cqw, 1.0cqw)\",\n            letterSpacing: \"0.04em\",\n          }}\n        >\n          REGI\n        </div>\n      </div>\n\n      {/* Social Follow On (Top-Left inside Black Hero Shape) matching screenshot - shifted more bottom */}\n      <div\n        className=\"absolute z-20 flex items-center text-white font-normal select-none\"\n        style={{\n          top: \"20.5%\",\n          left: \"7.2%\",\n          gap: \"1.2cqw\",\n          fontSize: \"1.3cqw\",\n        }}\n      >\n        <span className=\"text-white font-bold tracking-tight\">Follow On:</span>\n        <div className=\"flex items-center text-white\" style={{ gap: \"1.15cqw\" }}>\n          {/* Facebook \'f\' */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-bold text-[1.4cqw] leading-none\">f</span>\n          {/* Instagram camera icon outline with rounded inner lens and flash dot */}\n          <svg\n            className=\"hover:text-[#71AC16] cursor-pointer\"\n            style={{ width: \"1.4cqw\", height: \"1.4cqw\" }}\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"2.2\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          >\n            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"6\" ry=\"6\" />\n            <circle cx=\"12\" cy=\"12\" r=\"4.2\" />\n            <circle cx=\"17.5\" cy=\"6.5\" r=\"0.8\" fill=\"currentColor\" />\n          </svg>\n          {/* X (formerly Twitter) logo */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-black text-[1.3cqw] leading-none\">\360\235\225\217</span>\n          {/* LinkedIn \'in\' */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-bold text-[1.3cqw] leading-none tracking-tighter\">in</span>\n        </div>\n      </div>\n\n      {/*\n        ========================================================================\n        OUR SPECIALTY SERVICE SECTION\n        - Green service shape as direct container background\n        - Droplets shifted more to the LEFT and BOTTOM\n        - All elements scale 100% proportionally in cqw for identical device positioning\n        - Personal trainer card radius: 30px 30px 65px 65px (3.75cqw 3.75cqw 8.125cqw 8.125cqw)\n        ========================================================================\n      */}\n      <div\n        className=\"absolute z-10 select-none pointer-events-auto\"\n        style={{\n          left: \"1.5%\",\n          top: \"36.5%\",\n          width: \"29%\",\n          height: \"59.48%\",\n        }}\n      >\n        {/* Layer 1: Green Service Shape Background */}\n        <div className=\"absolute inset-0 pointer-events-none\">\n          <svg\n            viewBox=\"-8 -59 236 430\"\n            preserveAspectRatio=\"none\"\n            className=\"w-full h-full filter drop-shadow-md\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d={servicePath}\n              fill=\"#71AC16\"\n              className=\"transition-all duration-300\"\n            />\n          </svg>\n        </div>\n\n        {/* Layer 2: Content truly nested inside the green shape (expanded width on left side) */}\n        <div className=\"relative z-10 w-full h-full flex flex-col justify-between pl-[1.5%] pr-[5.5%] pt-[0.8%] pb-[3.5%] text-white\">\n          \n          {/* 1. Top Droplet Capsule Pattern: full design starting significantly more to the left */}\n          <div className=\"w-full flex justify-start -ml-[13%] mt-[1.4cqw] mb-[0.6cqw]\">\n            <svg\n              viewBox=\"-48 -2 250 84\"\n              className=\"w-full h-auto\"\n              style={{ maxHeight: \"7cqw\" }}\n            >\n              {/* Row 1: 1 droplet in Col 2 */}\n              {renderFigmaDroplet(-4, 8, \"f-r1-c2\", 21, 10.5)}\n\n              {/* Row 2: 4 droplets in Col 1, Col 2, Col 3, Col 4 */}\n              {renderFigmaDroplet(-42, 26, \"f-r2-c1\", 21, 10.5)}\n              {renderFigmaDroplet(-4, 26, \"f-r2-c2\", 21, 10.5)}\n              {renderFigmaDroplet(30, 26, \"f-r2-c3\", 21, 10.5)}\n              {renderFigmaDroplet(64, 26, \"f-r2-c4\", 21, 10.5)}\n\n              {/* Row 3: 5 droplets in Col 1, Col 2, Col 3, Col 5, Col 7 */}\n              {renderFigmaDroplet(-42, 44, \"f-r3-c1\", 21, 10.5)}\n              {renderFigmaDroplet(-4, 44, \"f-r3-c2\", 21, 10.5)}\n              {renderFigmaDroplet(30, 44, \"f-r3-c3\", 21, 10.5)}\n              {renderFigmaDroplet(96, 44, \"f-r3-c5\", 21, 10.5)}\n              {renderFigmaDroplet(160, 44, \"f-r3-c7\", 21, 10.5)}\n\n              {/* Row 4: 3 droplets in Col 3, Col 4, Col 6 */}\n              {renderFigmaDroplet(30, 62, \"f-r4-c3\", 21, 10.5)}\n              {renderFigmaDroplet(64, 62, \"f-r4-c4\", 21, 10.5)}\n              {renderFigmaDroplet(128, 62, \"f-r4-c6\", 21, 10.5)}\n            </svg>\n          </div>\n\n          {/* 2. Heading: OUR SPECIALTY (Shifted towards cards) */}\n          <div className=\"w-full px-[0.5%] mb-[0.7cqw]\">\n            <h2\n              className=\"font-tilt uppercase tracking-tight text-white leading-none font-normal\"\n              style={{\n                fontSize: \"2.4cqw\",\n                letterSpacing: \"-0.04em\",\n              }}\n            >\n              Our Specialty\n            </h2>\n          </div>\n\n          {/* 3. Three Specialty Cards (Spanning with side margins and bottom gap) */}\n          <div\n            className=\"w-full flex flex-col justify-start\"\n            style={{ gap: \"0.95cqw\" }}\n          >\n            {specialties.map((item, index) => {\n              const isPersonalTrainer = item.title.toLowerCase().includes(\"personal\") || index === 2;\n              return (\n                <div\n                  key={index}\n                  className={`flex items-center justify-start border border-white/50 bg-white/15 hover:bg-white/25 transition-all w-full text-left shadow-sm group backdrop-blur-[2px] cursor-default select-none ${\n                    isPersonalTrainer ? \"\" : \"rounded-[2.7cqw]\"\n                  }`}\n                  style={{\n                    minHeight: \"6.8cqw\",\n                    padding: \"1.25cqw 1.35cqw\",\n                    gap: \"1.2cqw\",\n                    ...(isPersonalTrainer\n                      ? {\n                          borderRadius: \"4cqw 4cqw 8.5cqw 8.5cqw\",\n                        }\n                      : {}),\n                  }}\n                >\n                  {/* Left Icon Container: Rounded square with thin white border */}\n                  <div\n                    className=\"flex-shrink-0 bg-white/[0.08] border border-white/50 flex items-center justify-center overflow-hidden rounded-[1.4cqw]\"\n                    style={{\n                      width: \"5cqw\",\n                      height: \"5cqw\",\n                    }}\n                  >\n                    <Image\n                      src={item.image}\n                      alt={item.title}\n                      width={44}\n                      height={44}\n                      className=\"object-contain w-[80%] h-[80%] group-hover:scale-110 transition-transform duration-200\"\n                    />\n                  </div>\n\n                  {/* Right Title: Fully responsive cqw typography with no minimum clamp blowout on mobile */}\n                  <span\n                    className=\"font-tilt text-white whitespace-nowrap leading-none font-normal\"\n                    style={{\n                      fontSize: \"1.7cqw\",\n                      letterSpacing: \"-0.03em\",\n                    }}\n                  >\n                    {item.title}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* --- IMAGE & TEXT SECTION (Anchored permanently relative to the Black Hero Shape) --- */}\n      <div className=\"absolute inset-0 z-20 pointer-events-none overflow-visible\">\n        {/* Content Aligned to Center Right following reference design */}\n        <div\n          className=\"absolute flex flex-col items-end overflow-visible\"\n          style={{\n            right: \"2%\",\n            bottom: \"23%\",\n            width: \"61%\",\n          }}\n        >\n          <div className=\"relative w-full flex justify-end overflow-visible\">\n            <div className=\"relative w-full max-w-[100%] overflow-visible\">\n              {/* User uploaded image hero-bodybuilders.jpg */}\n              <img\n                src=\"/images/hero-bodybuilders.jpg\"\n                alt=\"Power Your Potential - Bodybuilders\"\n                width={1200}\n                height={750}\n                className=\"h-auto w-full object-contain block drop-shadow-2xl\"\n                loading=\"eager\"\n              />\n\n              {/* Decorative top-right droplet pattern matching the exact uploaded reference screenshot */}\n              <div\n                className=\"absolute pointer-events-none\"\n                style={{\n                  top: \"3%\",\n                  right: \"6%\",\n                  width: \"5.5cqw\",\n                  height: \"7.5cqw\",\n                }}\n              >\n                <svg viewBox=\"0 0 68 96\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                  {/*\n                    Exact pattern from screenshot:\n                    Row 0: [X] [X] [X]\n                    Row 1: [X] [X] [ ]\n                    Row 2: [X] [X] [ ]\n                    Row 3: [X] [X] [X]\n                    Row 4: [ ] [X] [ ]\n                  */}\n                  {[\n                    [true, true, true],\n                    [true, true, false],\n                    [true, true, false],\n                    [true, true, true],\n                    [false, true, false],\n                  ].map((row, r) =>\n                    row.map((active, c) => {\n                      if (!active) return null;\n                      const x = c * 22 + 4;\n                      const y = r * 18 + 4;\n                      return (\n                        <path\n                          key={`hero-grid-${r}-${c}`}\n                          d={`M ${x} ${y} h 16 q 1 0 1 1 v 0.5 c 0 6.5 -8 6.5 -8 6.5 s -8 0 -8 -6.5 v -0.5 q 0 -1 1 -1 z`}\n                          fill=\"#5A5D64\"\n                          opacity=\"0.85\"\n                        />\n                      );\n                    })\n                  )}\n                </svg>\n              </div>\n\n              {/* TEXT: Line 1 \"POWER YOUR\", Line 2 below \"PONTETIALE\" with Satoshi */}\n              <h1\n                className=\"absolute left-[0%] w-[100%] flex flex-col uppercase tracking-[-0.04em] text-left select-none z-30 pointer-events-none\"\n                style={{\n                  fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                  fontWeight: 900,\n                  fontStyle: \"normal\",\n                  bottom: \"-2.8cqw\",\n                  lineHeight: 0.84,\n                }}\n              >\n                {/* Line 1: POWER YOUR */}\n                <span\n                  className=\"block tracking-[-0.04em] whitespace-nowrap\"\n                  style={{\n                    fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                    fontWeight: 900,\n                    fontStyle: \"normal\",\n                    fontSize: \"9.2cqw\",\n                    color: \"rgba(255, 255, 255, 0.08)\",\n                    WebkitTextStroke: \"max(1.2px, 0.11cqw) rgba(255, 255, 255, 0.95)\",\n                    textShadow: \"0 0 25px rgba(0,0,0,0.7)\",\n                    paddingBottom: \"0.1cqw\",\n                  }}\n                >\n                  POWER YOUR\n                </span>\n                {/* Below Line: PONTETIALE */}\n                <span\n                  className=\"block tracking-[-0.04em] whitespace-nowrap\"\n                  style={{\n                    fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                    fontWeight: 900,\n                    fontStyle: \"normal\",\n                    fontSize: \"10.4cqw\",\n                    color: \"rgba(255, 255, 255, 0.08)\",\n                    WebkitTextStroke: \"max(1.2px, 0.11cqw) rgba(255, 255, 255, 0.95)\",\n                    textShadow: \"0 0 25px rgba(0,0,0,0.7)\",\n                  }}\n                >\n                  PONTETIALE\n                </span>\n              </h1>\n            </div>\n          </div>\n        </div>\n\n        {/* BUTTON SECTION: Directly below the typography aligned to the left of the P in POWER / PONTETIAL */}\n        <div\n          className=\"absolute flex flex-row items-center pointer-events-auto\"\n          style={{\n            left: \"38.5%\",\n            bottom: \"10.5%\",\n            gap: \"1.1cqw\",\n          }}\n        >\n          <a\n            href=\"#products\"\n            onClick={(e) => {\n              e.preventDefault();\n              const el = document.getElementById(\"products\");\n              if (el) {\n                el.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n              }\n            }}\n            className=\"flex items-center bg-[#151719] border border-white/60 rounded-[1.2cqw] text-white font-bold hover:bg-white hover:text-black transition-all group shadow-2xl cursor-pointer active:scale-95 select-none\"\n            style={{\n              padding: \"0.9cqw 2.2cqw\",\n              fontSize: \"1.35cqw\",\n              gap: \"1cqw\",\n            }}\n          >\n            <span className=\"tracking-wide\">SHOP NOW</span>\n            <span className=\"group-hover:translate-x-1.5 transition-transform\" style={{ fontSize: \"1.1em\" }}>\n              \342\206\222\n            </span>\n          </a>\n\n          <a\n            href=\"#gym-location\"\n            onClick={(e) => {\n              e.preventDefault();\n              const el = document.getElementById(\"gym-location\");\n              if (el) {\n                el.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n              }\n            }}\n            className=\"bg-[#151719] border border-white/60 rounded-[1.2cqw] text-white hover:bg-white hover:text-black transition-all shadow-2xl cursor-pointer active:scale-95 flex items-center justify-center select-none\"\n            style={{\n              padding: \"0.9cqw\",\n              width: \"3.8cqw\",\n              height: \"3.8cqw\",\n            }}\n            aria-label=\"Gym Location\"\n          >\n            <svg\n              style={{ width: \"1.8cqw\", height: \"1.8cqw\" }}\n              fill=\"currentColor\"\n              viewBox=\"0 0 24 24\"\n            >\n              <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\" />\n            </svg>\n          </a>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default HeroSection;\n"
    raw_content: "\"use client\";\nimport React, { ReactElement } from \"react\";\nimport { motion } from \"framer-motion\";\nimport Image from \"./NextImageShim\";\nimport ShapePatternSvg from \"./ShapePatternSvg\";\n\ninterface HeroSectionProps {}\n\nconst HeroSection: React.FC<HeroSectionProps> = () => {\n  const heroPath =\n    \"M 554 87 C 620 86 603 108 607 208 V 317 L 607 391 C 609 576 618 576 534 573 H 292 C 181 572 178 572 178 484 L 176 355 V 312 C 176 276 181 241 149 231 L 105 216 L 64 203 C 11 187 0 182 -7 164 C -7 164 -34 74 40 82 C 109 69 77 14 114 20 L 354 23 C 461 20 359 78 464 84 Z\";\n\n  const servicePath =\n    \"M 218 118 C 216 356 228 371 176 369 H 143 H 75 H 27.5 C -6 368 -7 368 -8 299 V -20 C -8 -35 -4 -59 17 -56 C 66 -45 69 -44 111 -31 L 194 -1 C 221 14 218 75 218 58 Z\";\n\n  const specialties = [\n    { title: \"Ground running\", image: \"/images/running.png\" },\n    { title: \"Yoga Assistance\", image: \"/images/yoga.png\" },\n    { title: \"Personal Trainer\", image: \"/images/personalTesting.png\" },\n  ];\n\n  // Helper to render authentic Figma droplet/capsule shapes (flat top with subtle rounded corners, curved bowl bottom)\n  const renderFigmaDroplet = (\n    x: number,\n    y: number,\n    key: string,\n    w: number = 21,\n    h: number = 10.5,\n    fill: string = \"#89C53A\"\n  ): ReactElement => (\n    <path\n      key={key}\n      d={`M ${x + 1.5} ${y} \n         h ${w - 3} \n         q 1.5 0 1.5 1.5 \n         v 0.5 \n         c 0 ${h - 2} -${w / 2} ${h - 2} -${w / 2} ${h - 2} \n         s -${w / 2} 0 -${w / 2} -${h - 2} \n         v -0.5 \n         q 0 -1.5 1.5 -1.5 \n         z`}\n      fill={fill}\n    />\n  );\n\n  return (\n    /*\n      The container preserves the exact 800/600 (4:3) aspect ratio with Container Queries (cqw).\n      By consistently using cqw (container query width units) without breaking clamps/min-widths,\n      every shape, text, card, and pattern stays at the EXACT SAME relative position on ALL devices.\n    */\n    <div className=\"relative w-full aspect-[800/600] bg-white overflow-hidden select-none [container-type:inline-size]\">\n      \n      {/* Background Hero Layer (Black Hero Shape) */}\n      <div className=\"absolute inset-0 z-0 pointer-events-none\">\n        <svg\n          viewBox=\"0 0 800 600\"\n          preserveAspectRatio=\"none\"\n          className=\"w-full h-full\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          {/* Hero Shape (Black) */}\n          <path\n            d={heroPath}\n            fill=\"black\"\n            transform=\"translate(30, 0) scale(1.266, 1)\"\n            className=\"transition-all duration-500 ease-in-out\"\n          />\n        </svg>\n      </div>\n\n      {/* Decorative Droplet SVG Patterns across the canvas */}\n      <ShapePatternSvg />\n\n      {/* Top Header Navigation */}\n      <div className=\"absolute top-[2.4%] left-[2.8%] right-[2.8%] z-30 flex items-center justify-between pointer-events-auto\">\n        {/* Brand Logo Button: Vibrant Lime Green circle with logo.png rotated -45 deg */}\n        <a\n          href=\"#\"\n          onClick={(e) => {\n            e.preventDefault();\n            window.scrollTo({ top: 0, behavior: \"smooth\" });\n          }}\n          className=\"flex items-center justify-center rounded-full bg-[#71AC16] shadow-md hover:scale-105 transition-transform\"\n          style={{\n            width: \"5.8cqw\",\n            height: \"5.8cqw\",\n          }}\n          aria-label=\"Home\"\n        >\n          <img\n            src=\"/images/logo.png\"\n            alt=\"Logo\"\n            width={48}\n            height={48}\n            className=\"w-[58%] h-[58%] object-contain\"\n            style={{\n              transform: \"rotate(-45deg)\",\n            }}\n          />\n        </a>\n\n        {/* Center Nav Pill: Black background with subtle crisp white border and reduced shadow */}\n        <div\n          className=\"flex items-center bg-black border border-white/90 rounded-full text-white shadow-sm\"\n          style={{\n            padding: \"0.55cqw 0.75cqw 0.55cqw 2.8cqw\",\n            gap: \"2.2cqw\",\n            transform: \"translate(-7.1cqw, 1.4cqw)\",\n          }}\n        >\n          <a\n            href=\"#home\"\n            className=\"text-white hover:text-white/80 transition-colors font-normal whitespace-nowrap\"\n            style={{\n              fontSize: \"1.25cqw\",\n              letterSpacing: \"-0.01em\",\n            }}\n          >\n            Home\n          </a>\n          <a\n            href=\"#gym-location\"\n            className=\"text-white hover:text-[#71AC16] transition-colors cursor-pointer font-normal whitespace-nowrap\"\n            style={{\n              fontSize: \"1.25cqw\",\n              letterSpacing: \"-0.01em\",\n            }}\n          >\n            Our gym location\n          </a>\n          \n          {/* Vertical Separator */}\n          <span\n            className=\"text-white font-light select-none opacity-80\"\n            style={{\n              fontSize: \"1.15cqw\",\n              margin: \"0 0.2cqw\",\n            }}\n          >\n            |\n          </span>\n\n          {/* Search Pill inside: Dark Charcoal oval pill matching screenshot proportions */}\n          <div\n            className=\"flex items-center justify-between bg-[#383A3D] hover:bg-[#424448] rounded-full transition-colors cursor-pointer\"\n            style={{\n              padding: \"0.5cqw 1.25cqw\",\n              gap: \"1.2cqw\",\n              width: \"9.5cqw\",\n            }}\n          >\n            <input\n              type=\"text\"\n              placeholder=\"Search\"\n              className=\"bg-transparent outline-none placeholder:text-white text-white font-normal w-full select-none\"\n              style={{\n                fontSize: \"1.25cqw\",\n                lineHeight: \"1\",\n              }}\n            />\n            {/* White solid filled magnifying glass icon matching screenshot */}\n            <svg\n              style={{ width: \"1.25cqw\", height: \"1.25cqw\" }}\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              className=\"text-white flex-shrink-0\"\n            >\n              {/* Thick ring with white stroke */}\n              <circle\n                cx=\"10\"\n                cy=\"10\"\n                r=\"6.5\"\n                stroke=\"white\"\n                strokeWidth=\"3.2\"\n              />\n              {/* Thick rounded angled handle */}\n              <line\n                x1=\"15\"\n                y1=\"15\"\n                x2=\"21\"\n                y2=\"21\"\n                stroke=\"white\"\n                strokeWidth=\"3.5\"\n                strokeLinecap=\"round\"\n              />\n            </svg>\n          </div>\n        </div>\n\n        {/* REGI Button - all side padding, more right padding, shifted left and more bottom */}\n        <div\n          className=\"bg-[#6FA816] hover:bg-[#78B419] text-white font-extrabold tracking-wider rounded-full transition-all uppercase select-none flex items-center justify-center shadow-sm cursor-default\"\n          style={{\n            padding: \"1.05cqw 12.8cqw 1.05cqw 3.6cqw\",\n            fontSize: \"1.5cqw\",\n            transform: \"translate(-6.9cqw, 1.0cqw)\",\n            letterSpacing: \"0.04em\",\n          }}\n        >\n          REGI\n        </div>\n      </div>\n\n      {/* Social Follow On (Top-Left inside Black Hero Shape) matching screenshot - shifted more bottom */}\n      <div\n        className=\"absolute z-20 flex items-center text-white font-normal select-none\"\n        style={{\n          top: \"20.5%\",\n          left: \"7.2%\",\n          gap: \"1.2cqw\",\n          fontSize: \"1.3cqw\",\n        }}\n      >\n        <span className=\"text-white font-bold tracking-tight\">Follow On:</span>\n        <div className=\"flex items-center text-white\" style={{ gap: \"1.15cqw\" }}>\n          {/* Facebook \'f\' */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-bold text-[1.4cqw] leading-none\">f</span>\n          {/* Instagram camera icon outline with rounded inner lens and flash dot */}\n          <svg\n            className=\"hover:text-[#71AC16] cursor-pointer\"\n            style={{ width: \"1.4cqw\", height: \"1.4cqw\" }}\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"2.2\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          >\n            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"6\" ry=\"6\" />\n            <circle cx=\"12\" cy=\"12\" r=\"4.2\" />\n            <circle cx=\"17.5\" cy=\"6.5\" r=\"0.8\" fill=\"currentColor\" />\n          </svg>\n          {/* X (formerly Twitter) logo */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-black text-[1.3cqw] leading-none\">\360\235\225\217</span>\n          {/* LinkedIn \'in\' */}\n          <span className=\"hover:text-[#71AC16] cursor-pointer font-bold text-[1.3cqw] leading-none tracking-tighter\">in</span>\n        </div>\n      </div>\n\n      {/*\n        ========================================================================\n        OUR SPECIALTY SERVICE SECTION\n        - Green service shape as direct container background\n        - Droplets shifted more to the LEFT and BOTTOM\n        - All elements scale 100% proportionally in cqw for identical device positioning\n        - Personal trainer card radius: 30px 30px 65px 65px (3.75cqw 3.75cqw 8.125cqw 8.125cqw)\n        ========================================================================\n      */}\n      <div\n        className=\"absolute z-10 select-none pointer-events-auto\"\n        style={{\n          left: \"1.5%\",\n          top: \"36.5%\",\n          width: \"29%\",\n          height: \"59.48%\",\n        }}\n      >\n        {/* Layer 1: Green Service Shape Background */}\n        <div className=\"absolute inset-0 pointer-events-none\">\n          <svg\n            viewBox=\"-8 -59 236 430\"\n            preserveAspectRatio=\"none\"\n            className=\"w-full h-full filter drop-shadow-md\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <path\n              d={servicePath}\n              fill=\"#71AC16\"\n              className=\"transition-all duration-300\"\n            />\n          </svg>\n        </div>\n\n        {/* Layer 2: Content truly nested inside the green shape (expanded width on left side) */}\n        <div className=\"relative z-10 w-full h-full flex flex-col justify-between pl-[1.5%] pr-[5.5%] pt-[0.8%] pb-[3.5%] text-white\">\n          \n          {/* 1. Top Droplet Capsule Pattern: full design starting significantly more to the left */}\n          <div className=\"w-full flex justify-start -ml-[13%] mt-[1.4cqw] mb-[0.6cqw]\">\n            <svg\n              viewBox=\"-48 -2 250 84\"\n              className=\"w-full h-auto\"\n              style={{ maxHeight: \"7cqw\" }}\n            >\n              {/* Row 1: 1 droplet in Col 2 */}\n              {renderFigmaDroplet(-4, 8, \"f-r1-c2\", 21, 10.5)}\n\n              {/* Row 2: 4 droplets in Col 1, Col 2, Col 3, Col 4 */}\n              {renderFigmaDroplet(-42, 26, \"f-r2-c1\", 21, 10.5)}\n              {renderFigmaDroplet(-4, 26, \"f-r2-c2\", 21, 10.5)}\n              {renderFigmaDroplet(30, 26, \"f-r2-c3\", 21, 10.5)}\n              {renderFigmaDroplet(64, 26, \"f-r2-c4\", 21, 10.5)}\n\n              {/* Row 3: 5 droplets in Col 1, Col 2, Col 3, Col 5, Col 7 */}\n              {renderFigmaDroplet(-42, 44, \"f-r3-c1\", 21, 10.5)}\n              {renderFigmaDroplet(-4, 44, \"f-r3-c2\", 21, 10.5)}\n              {renderFigmaDroplet(30, 44, \"f-r3-c3\", 21, 10.5)}\n              {renderFigmaDroplet(96, 44, \"f-r3-c5\", 21, 10.5)}\n              {renderFigmaDroplet(160, 44, \"f-r3-c7\", 21, 10.5)}\n\n              {/* Row 4: 3 droplets in Col 3, Col 4, Col 6 */}\n              {renderFigmaDroplet(30, 62, \"f-r4-c3\", 21, 10.5)}\n              {renderFigmaDroplet(64, 62, \"f-r4-c4\", 21, 10.5)}\n              {renderFigmaDroplet(128, 62, \"f-r4-c6\", 21, 10.5)}\n            </svg>\n          </div>\n\n          {/* 2. Heading: OUR SPECIALTY (Shifted towards cards) */}\n          <div className=\"w-full px-[0.5%] mb-[0.7cqw]\">\n            <h2\n              className=\"font-tilt uppercase tracking-tight text-white leading-none font-normal\"\n              style={{\n                fontSize: \"2.4cqw\",\n                letterSpacing: \"-0.04em\",\n              }}\n            >\n              Our Specialty\n            </h2>\n          </div>\n\n          {/* 3. Three Specialty Cards (Spanning with side margins and bottom gap) */}\n          <div\n            className=\"w-full flex flex-col justify-start\"\n            style={{ gap: \"0.95cqw\" }}\n          >\n            {specialties.map((item, index) => {\n              const isPersonalTrainer = item.title.toLowerCase().includes(\"personal\") || index === 2;\n              return (\n                <div\n                  key={index}\n                  className={`flex items-center justify-start border border-white/50 bg-white/15 hover:bg-white/25 transition-all w-full text-left shadow-sm group backdrop-blur-[2px] cursor-default select-none ${\n                    isPersonalTrainer ? \"\" : \"rounded-[2.7cqw]\"\n                  }`}\n                  style={{\n                    minHeight: \"6.8cqw\",\n                    padding: \"1.25cqw 1.35cqw\",\n                    gap: \"1.2cqw\",\n                    ...(isPersonalTrainer\n                      ? {\n                          borderRadius: \"4cqw 4cqw 8.5cqw 8.5cqw\",\n                        }\n                      : {}),\n                  }}\n                >\n                  {/* Left Icon Container: Rounded square with thin white border */}\n                  <div\n                    className=\"flex-shrink-0 bg-white/[0.08] border border-white/50 flex items-center justify-center overflow-hidden rounded-[1.4cqw]\"\n                    style={{\n                      width: \"5cqw\",\n                      height: \"5cqw\",\n                    }}\n                  >\n                    <Image\n                      src={item.image}\n                      alt={item.title}\n                      width={44}\n                      height={44}\n                      className=\"object-contain w-[80%] h-[80%] group-hover:scale-110 transition-transform duration-200\"\n                    />\n                  </div>\n\n                  {/* Right Title: Fully responsive cqw typography with no minimum clamp blowout on mobile */}\n                  <span\n                    className=\"font-tilt text-white whitespace-nowrap leading-none font-normal\"\n                    style={{\n                      fontSize: \"1.7cqw\",\n                      letterSpacing: \"-0.03em\",\n                    }}\n                  >\n                    {item.title}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* --- IMAGE & TEXT SECTION (Anchored permanently relative to the Black Hero Shape) --- */}\n      <div className=\"absolute inset-0 z-20 pointer-events-none overflow-visible\">\n        {/* Content Aligned to Center Right following reference design */}\n        <div\n          className=\"absolute flex flex-col items-end overflow-visible\"\n          style={{\n            right: \"2%\",\n            bottom: \"23%\",\n            width: \"61%\",\n          }}\n        >\n          <div className=\"relative w-full flex justify-end overflow-visible\">\n            <div className=\"relative w-full max-w-[100%] overflow-visible\">\n              {/* User uploaded image hero-bodybuilders.jpg */}\n              <img\n                src=\"/images/hero-bodybuilders.jpg\"\n                alt=\"Power Your Potential - Bodybuilders\"\n                width={1200}\n                height={750}\n                className=\"h-auto w-full object-contain block drop-shadow-2xl\"\n                loading=\"eager\"\n              />\n\n              {/* Decorative top-right droplet pattern matching the exact uploaded reference screenshot */}\n              <div\n                className=\"absolute pointer-events-none\"\n                style={{\n                  top: \"3%\",\n                  right: \"6%\",\n                  width: \"5.5cqw\",\n                  height: \"7.5cqw\",\n                }}\n              >\n                <svg viewBox=\"0 0 68 96\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                  {/*\n                    Exact pattern from screenshot:\n                    Row 0: [X] [X] [X]\n                    Row 1: [X] [X] [ ]\n                    Row 2: [X] [X] [ ]\n                    Row 3: [X] [X] [X]\n                    Row 4: [ ] [X] [ ]\n                  */}\n                  {[\n                    [true, true, true],\n                    [true, true, false],\n                    [true, true, false],\n                    [true, true, true],\n                    [false, true, false],\n                  ].map((row, r) =>\n                    row.map((active, c) => {\n                      if (!active) return null;\n                      const x = c * 22 + 4;\n                      const y = r * 18 + 4;\n                      return (\n                        <path\n                          key={`hero-grid-${r}-${c}`}\n                          d={`M ${x} ${y} h 16 q 1 0 1 1 v 0.5 c 0 6.5 -8 6.5 -8 6.5 s -8 0 -8 -6.5 v -0.5 q 0 -1 1 -1 z`}\n                          fill=\"#5A5D64\"\n                          opacity=\"0.85\"\n                        />\n                      );\n                    })\n                  )}\n                </svg>\n              </div>\n\n              {/* TEXT: Line 1 \"POWER YOUR\", Line 2 below \"PONTETIALE\" with Satoshi */}\n              <h1\n                className=\"absolute left-[0%] w-[100%] flex flex-col uppercase tracking-[-0.04em] text-left select-none z-30 pointer-events-none\"\n                style={{\n                  fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                  fontWeight: 900,\n                  fontStyle: \"normal\",\n                  bottom: \"-2.8cqw\",\n                  lineHeight: 0.84,\n                }}\n              >\n                {/* Line 1: POWER YOUR */}\n                <span\n                  className=\"block tracking-[-0.04em] whitespace-nowrap\"\n                  style={{\n                    fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                    fontWeight: 900,\n                    fontStyle: \"normal\",\n                    fontSize: \"9.2cqw\",\n                    color: \"rgba(255, 255, 255, 0.08)\",\n                    WebkitTextStroke: \"max(1.2px, 0.11cqw) rgba(255, 255, 255, 0.95)\",\n                    textShadow: \"0 0 25px rgba(0,0,0,0.7)\",\n                    paddingBottom: \"0.1cqw\",\n                  }}\n                >\n                  POWER YOUR\n                </span>\n                {/* Below Line: PONTETIALE */}\n                <span\n                  className=\"block tracking-[-0.04em] whitespace-nowrap\"\n                  style={{\n                    fontFamily: \"\'Satoshi\', \'Plus Jakarta Sans\', sans-serif\",\n                    fontWeight: 900,\n                    fontStyle: \"normal\",\n                    fontSize: \"10.4cqw\",\n                    color: \"rgba(255, 255, 255, 0.08)\",\n                    WebkitTextStroke: \"max(1.2px, 0.11cqw) rgba(255, 255, 255, 0.95)\",\n                    textShadow: \"0 0 25px rgba(0,0,0,0.7)\",\n                  }}\n                >\n                  PONTETIALE\n                </span>\n              </h1>\n            </div>\n          </div>\n        </div>\n\n        {/* BUTTON SECTION: Directly below the typography aligned to the left of the P in POWER / PONTETIAL */}\n        <div\n          className=\"absolute flex flex-row items-center pointer-events-auto\"\n          style={{\n            left: \"38.5%\",\n            bottom: \"10.5%\",\n            gap: \"1.1cqw\",\n          }}\n        >\n          <a\n            href=\"#products\"\n            onClick={(e) => {\n              e.preventDefault();\n              const el = document.getElementById(\"products\");\n              if (el) {\n                el.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n              }\n            }}\n            className=\"flex items-center bg-[#151719] border border-white/60 rounded-[1.2cqw] text-white font-bold hover:bg-white hover:text-black transition-all group shadow-2xl cursor-pointer active:scale-95 select-none\"\n            style={{\n              padding: \"0.9cqw 2.2cqw\",\n              fontSize: \"1.35cqw\",\n              gap: \"1cqw\",\n            }}\n          >\n            <span className=\"tracking-wide\">SHOP NOW</span>\n            <span className=\"group-hover:translate-x-1.5 transition-transform\" style={{ fontSize: \"1.1em\" }}>\n              \342\206\222\n            </span>\n          </a>\n\n          <a\n            href=\"#gym-location\"\n            onClick={(e) => {\n              e.preventDefault();\n              const el = document.getElementById(\"gym-location\");\n              if (el) {\n                el.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n              }\n            }}\n            className=\"bg-[#151719] border border-white/60 rounded-[1.2cqw] text-white hover:bg-white hover:text-black transition-all shadow-2xl cursor-pointer active:scale-95 flex items-center justify-center select-none\"\n            style={{\n              padding: \"0.9cqw\",\n              width: \"3.8cqw\",\n              height: \"3.8cqw\",\n            }}\n            aria-label=\"Gym Location\"\n          >\n            <svg\n              style={{ width: \"1.8cqw\", height: \"1.8cqw\" }}\n              fill=\"currentColor\"\n              viewBox=\"0 0 24 24\"\n            >\n              <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\" />\n            </svg>\n          </a>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default HeroSection;\n"
    num_lines: 555
    num_bytes: 21566
  }
}
