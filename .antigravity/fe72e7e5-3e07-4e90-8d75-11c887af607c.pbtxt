    content: "import React from \"react\";\n\nexport interface ClientsSayingSectionProps {\n  className?: string;\n}\n\n/**\n * Top-Left Droplets Pattern:\n * Sliced capsule / bowl droplets with curved convex bottom and flat top,\n * tilted ~ -16\302\260 upwards-right, exactly matching the user\'s reference screenshot:\n * 9 droplets arranged in a dynamic wave above \"What Our Clients Are Saying\".\n */\nexport const ClientLeftDropletGroup: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  // Curved bottom bowl droplet:\n  // Flat top edge, rounded corner radiuses on the sides, deeply curved smooth elliptical bottom\n  const renderCurvedBottomDroplet = (\n    cx: number,\n    cy: number,\n    rot = -16,\n    w = 21,\n    h = 9.5,\n    cr = 2.2,\n    key = `d-${cx}-${cy}`\n  ) => {\n    const hw = w / 2;\n    const hh = h / 2;\n    // Path centered at (0, 0):\n    // Top flat edge from (-hw + cr) to (hw - cr) at y = -hh\n    // Rounded top-right corner to (hw, -hh + cr)\n    // Deep curved elliptical bowl bottom to (-hw, -hh + cr)\n    // Rounded top-left corner back to (-hw + cr, -hh)\n    const d = `\n      M ${-hw + cr} ${-hh}\n      L ${hw - cr} ${-hh}\n      Q ${hw} ${-hh} ${hw} ${-hh + cr}\n      A ${hw} ${h - cr} 0 0 1 ${-hw} ${-hh + cr}\n      Q ${-hw} ${-hh} ${-hw + cr} ${-hh}\n      Z\n    `;\n\n    return (\n      <path\n        key={key}\n        d={d}\n        fill={color}\n        transform={`translate(${cx}, ${cy}) rotate(${rot})`}\n      />\n    );\n  };\n\n  return (\n    <svg\n      viewBox=\"0 0 144 86\"\n      className={`w-[78px] sm:w-[88px] md:w-[100px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* 1. Topmost center-peak droplet */}\n      {renderCurvedBottomDroplet(76, 11, -16, 21, 9.5, 2.2, \"d-top\")}\n\n      {/* 2. Left column (2 droplets) */}\n      {renderCurvedBottomDroplet(24, 25, -17, 21, 9.5, 2.2, \"d-left-top\")}\n      {renderCurvedBottomDroplet(30, 49, -16, 21, 9.5, 2.2, \"d-left-bot\")}\n\n      {/* 3. Middle-left column (2 droplets) */}\n      {renderCurvedBottomDroplet(56, 40, -17, 21, 9.5, 2.2, \"d-mid-top\")}\n      {renderCurvedBottomDroplet(62, 63, -17, 21, 9.5, 2.2, \"d-mid-bot\")}\n\n      {/* 4. Center-right lower droplet */}\n      {renderCurvedBottomDroplet(88, 54, -16, 21, 9.5, 2.2, \"d-center-right\")}\n\n      {/* 5. Right column (3 descending droplets) */}\n      {renderCurvedBottomDroplet(108, 25, -16, 21, 9.5, 2.2, \"d-right-top\")}\n      {renderCurvedBottomDroplet(114, 49, -16, 21, 9.5, 2.2, \"d-right-mid\")}\n      {renderCurvedBottomDroplet(120, 72, -17, 21, 9.5, 2.2, \"d-right-bot\")}\n    </svg>\n  );\n};\n\n/**\n * Top-Right Droplets Pattern:\n * Sliced dome droplets with curved convex top and flat bottom (with soft rounded corners),\n * matching the user\'s reference screenshot:\n * Row 1 (top):    [Col 1]\n * Row 2:          [Col 1]  [Col 2]  [Col 3]\n * Row 3:          [Col 1]           [Col 3]  [Col 4 (right edge)]\n * Row 4 (bottom):          [Col 2]           [Col 4 (right edge)]\n */\nexport const ClientRightDropletGroup: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  // Curved top dome droplet:\n  // Smooth semicircular/elliptical dome top, flat bottom horizontal edge, and softly rounded bottom corners\n  const renderCurvedTopDome = (\n    x: number,\n    y: number,\n    key: string,\n    w = 19,\n    h = 9.5,\n    cr = 1.8\n  ) => {\n    const d = `\n      M ${x} ${y + h - cr}\n      A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n      Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n      L ${x + cr} ${y + h}\n      Q ${x} ${y + h} ${x} ${y + h - cr}\n      Z\n    `;\n    return <path key={key} d={d} fill={color} />;\n  };\n\n  return (\n    <svg\n      viewBox=\"0 0 88 58\"\n      className={`w-[68px] sm:w-[80px] md:w-[92px] lg:w-[100px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* Row 1 (top): Col 1 */}\n      {renderCurvedTopDome(2, 2, \"r-1-1\")}\n\n      {/* Row 2: Col 1, Col 2, Col 3 */}\n      {renderCurvedTopDome(2, 17, \"r-2-1\")}\n      {renderCurvedTopDome(24, 17, \"r-2-2\")}\n      {renderCurvedTopDome(46, 17, \"r-2-3\")}\n\n      {/* Row 3: Col 1, Col 3, Col 4 (flush to right edge) */}\n      {renderCurvedTopDome(2, 32, \"r-3-1\")}\n      {renderCurvedTopDome(46, 32, \"r-3-3\")}\n      {renderCurvedTopDome(68, 32, \"r-3-4\")}\n\n      {/* Row 4 (bottom): Col 2, Col 4 (flush to right edge) */}\n      {renderCurvedTopDome(24, 47, \"r-4-2\")}\n      {renderCurvedTopDome(68, 47, \"r-4-4\")}\n    </svg>\n  );\n};\n\n/**\n * High-fidelity vector avatars matching the colorful circular avatars in the screenshot\n */\nconst Avatar1 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#38BDF8\" />\n    {/* Body / Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#F43F5E\" />\n    <path d=\"M16 28L20 33L24 28H16Z\" fill=\"#E2E8F0\" />\n    {/* Head & Neck */}\n    <rect x=\"18\" y=\"22\" width=\"4\" height=\"6\" fill=\"#FCD34D\" />\n    <circle cx=\"20\" cy=\"18\" r=\"7.5\" fill=\"#FDE68A\" />\n    {/* Hair & Beard */}\n    <path d=\"M12.5 17C12.5 12 15.5 10 20 10C24.5 10 27.5 12 27.5 17C27.5 14 26 12 20 12C14 12 12.5 14 12.5 17Z\" fill=\"#78350F\" />\n    <path d=\"M15 19C15 23.5 17.5 26 20 26C22.5 26 25 23.5 25 19C25 21 23 23 20 23C17 23 15 21 15 19Z\" fill=\"#78350F\" />\n  </svg>\n);\n\nconst Avatar2 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#60A5FA\" />\n    {/* Body / Yellow Shirt */}\n    <path d=\"M7 40C7 31 13 27 20 27C27 27 33 31 33 40H7Z\" fill=\"#FBBF24\" />\n    <path d=\"M16 27L20 32L24 27H16Z\" fill=\"#FFFFFF\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"8\" fill=\"#FDE68A\" />\n    {/* Yellow/Blonde hair */}\n    <path d=\"M12 18C12 11 15 8 20 8C25 8 28 11 28 18C27 12 24.5 10 20 10C15.5 10 13 12 12 18Z\" fill=\"#F59E0B\" />\n  </svg>\n);\n\nconst Avatar3 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#FB923C\" />\n    {/* Body / Green Shirt */}\n    <path d=\"M7 40C7 31.5 13 27.5 20 27.5C27 27.5 33 31.5 33 40H7Z\" fill=\"#22C55E\" />\n    <path d=\"M17 27.5L20 32L23 27.5H17Z\" fill=\"#FDE68A\" />\n    {/* Long brown hair behind */}\n    <path d=\"M11 20C11 14 15 10 20 10C25 10 29 14 29 20V26C29 26 27 28 25 28H15C13 28 11 26 11 26V20Z\" fill=\"#92400E\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"7.5\" fill=\"#FDE68A\" />\n    {/* Front parted bangs */}\n    <path d=\"M13 16C15 11 18 11 20 13C22 11 25 11 27 16C26 13 23 12 20 12C17 12 14 13 13 16Z\" fill=\"#78350F\" />\n  </svg>\n);\n\nconst Avatar4 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#C084FC\" />\n    {/* Body / Pink Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#EC4899\" />\n    <path d=\"M17 28L20 33L23 28H17Z\" fill=\"#FFFFFF\" />\n    {/* Hair bun */}\n    <circle cx=\"20\" cy=\"9\" r=\"4.5\" fill=\"#312E81\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"19\" r=\"7.5\" fill=\"#FED7AA\" />\n    {/* Front hair */}\n    <path d=\"M13 18C13 13 16 11 20 11C24 11 27 13 27 18C26 14 23 13 20 13C17 13 14 14 13 18Z\" fill=\"#312E81\" />\n  </svg>\n);\n\nconst Avatar5 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#818CF8\" />\n    {/* Body / Dark Navy with Red Collar */}\n    <path d=\"M7 40C7 31.5 13 27.5 20 27.5C27 27.5 33 31.5 33 40H7Z\" fill=\"#1E293B\" />\n    <path d=\"M15 27.5L20 33.5L25 27.5H15Z\" fill=\"#EF4444\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"8\" fill=\"#FCD34D\" />\n    {/* Short dark hair */}\n    <path d=\"M12 17C12 11 15.5 9 20 9C24.5 9 28 11 28 17C27 13 24 11 20 11C16 11 13 13 12 17Z\" fill=\"#1E1B4B\" />\n  </svg>\n);\n\nconst Avatar6 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#FB7185\" />\n    {/* Body / Bright Yellow Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#FACC15\" />\n    <path d=\"M16 28L20 33L24 28H16Z\" fill=\"#FFFFFF\" />\n    {/* Red / Auburn hair */}\n    <circle cx=\"20\" cy=\"19\" r=\"8\" fill=\"#FFEDD5\" />\n    <path d=\"M11 21C11 14 15 10 20 10C25 10 29 14 29 21C27 13 24 11.5 20 11.5C16 11.5 13 13 11 21Z\" fill=\"#DC2626\" />\n  </svg>\n);\n\n/**\n * 5-Star Rating component matching the screenshot:\n * 4 solid gold stars and 1 half-gold star (or 4.5 rating representation)\n */\nconst StarRating = ({ rating = 4.5 }: { rating?: number }) => {\n  return (\n    <div className=\"flex items-center gap-0.5 select-none\" aria-label={`Rating: ${rating} out of 5 stars`}>\n      {/* 4 Full Stars */}\n      {[0, 1, 2, 3].map((index) => (\n        <svg\n          key={index}\n          className=\"w-3 h-3 text-[#FBBF24] fill-current\"\n          viewBox=\"0 0 20 20\"\n        >\n          <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n        </svg>\n      ))}\n\n      {/* 5th Star: Half filled star for 4.5 */}\n      <svg className=\"w-3 h-3 text-[#FBBF24]\" viewBox=\"0 0 20 20\">\n        <defs>\n          <linearGradient id=\"halfStarGrad\">\n            <stop offset=\"55%\" stopColor=\"#FBBF24\" />\n            <stop offset=\"55%\" stopColor=\"#4B5563\" />\n          </linearGradient>\n        </defs>\n        <path\n          fill=\"url(#halfStarGrad)\"\n          d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"\n        />\n      </svg>\n\n      {/* Numeric score \"(4.5)\" matching screenshot */}\n      <span className=\"text-[10px] sm:text-[11px] text-neutral-400 font-medium ml-1\">\n        ({rating.toFixed(1)})\n      </span>\n    </div>\n  );\n};\n\nexport interface TestimonialCardData {\n  id: number;\n  title: string;\n  comment: string;\n  authorName: string;\n  authorRole: string;\n  rating: number;\n  AvatarComponent: React.ComponentType;\n}\n\nconst TESTIMONIALS: TestimonialCardData[] = [\n  {\n    id: 1,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar1,\n  },\n  {\n    id: 2,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar2,\n  },\n  {\n    id: 3,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar3,\n  },\n  {\n    id: 4,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar4,\n  },\n  {\n    id: 5,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar5,\n  },\n  {\n    id: 6,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar6,\n  },\n];\n\nexport const ClientsSayingSection: React.FC<ClientsSayingSectionProps> = ({\n  className = \"\",\n}) => {\n  return (\n    <section\n      id=\"testimonials\"\n      className={`w-full pb-8 sm:pb-12 md:pb-16 select-none relative scroll-mt-6 ${className}`}\n    >\n      {/* 1. Header with Left and Right Droplets:\n          Positioned identically across all screen sizes (desktop, tablet, mobile):\n          - Left droplet directly above the title on the left\n          - Right droplet aligned at the top right edge\n      */}\n      <div className=\"w-full relative flex items-start justify-between pb-3 sm:pb-5\">\n        {/* Left column: Droplet and Title/Subtitle */}\n        <div className=\"flex flex-col items-start relative z-10 max-w-[80%]\">\n          {/* Top-Left Droplet Pattern */}\n          <div className=\"mb-2 sm:mb-3 pointer-events-none\">\n            <ClientLeftDropletGroup />\n          </div>\n\n          {/* Section Heading */}\n          <h2\n            className=\"text-[20px] sm:text-[24px] md:text-[30px] lg:text-[36px] font-extrabold text-[#23262F] tracking-tight leading-tight\"\n          >\n            What Our Clients Are Saying\n          </h2>\n\n          {/* Section Subtitle */}\n          <p\n            className=\"text-[11px] sm:text-xs md:text-sm lg:text-[15px] font-medium text-slate-500 mt-1 sm:mt-1.5 leading-relaxed\"\n          >\n            Real Stories, Real Results \342\200\224 Hear From Our Athletes\n          </p>\n        </div>\n\n        {/* Right column: Top-Right Droplet Pattern adjusted slightly higher and further right */}\n        <div className=\"self-end mb-2 md:mb-4 flex-shrink-0 pointer-events-none ml-auto -mr-2 sm:-mr-6 md:-mr-8 lg:-mr-11\">\n          <ClientRightDropletGroup />\n        </div>\n      </div>\n\n      {/* 2. Light Grey Container with Rounded Corners (matching reference image) */}\n      <div className=\"w-full bg-[#ECEEF0] rounded-[24px] sm:rounded-[32px] md:rounded-[40px] lg:rounded-[44px] p-4 sm:p-6 md:p-8 lg:p-10 shadow-sm mt-3 sm:mt-4\">\n        {/* Responsive Grid of 6 Dark Testimonial Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6\">\n          {TESTIMONIALS.map((item) => {\n            const Avatar = item.AvatarComponent;\n            return (\n              <div\n                key={item.id}\n                className=\"bg-black text-white rounded-[20px] sm:rounded-[24px] p-5 sm:p-6 flex flex-col justify-between shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-[1.01] group border border-white/5\"\n              >\n                {/* Top content: Title and Review */}\n                <div>\n                  <h3 className=\"text-white font-bold text-[15px] sm:text-[16px] md:text-[17px] tracking-tight leading-snug\">\n                    {item.title}\n                  </h3>\n                  <p className=\"text-[#A7A9AE] text-xs sm:text-[13px] leading-relaxed mt-2.5 sm:mt-3 font-normal\">\n                    {item.comment}\n                  </p>\n                </div>\n\n                {/* Bottom row: User Avatar, Name, Role, and Star Rating */}\n                <div className=\"flex items-center justify-between mt-5 sm:mt-6 pt-2 border-t border-white/5\">\n                  {/* Left: Avatar + Name/Role */}\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-full overflow-hidden flex-shrink-0 ring-1 ring-white/10 shadow-sm\">\n                      <Avatar />\n                    </div>\n                    <div className=\"flex flex-col min-w-0\">\n                      <span className=\"text-white font-semibold text-xs sm:text-sm tracking-tight truncate\">\n                        {item.authorName}\n                      </span>\n                      <span className=\"text-[#8E9096] text-[10px] sm:text-xs truncate\">\n                        {item.authorRole}\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Right: Star Rating + Score */}\n                  <div className=\"flex-shrink-0 pl-2\">\n                    <StarRating rating={item.rating} />\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default ClientsSayingSection;\n"
    raw_content: "import React from \"react\";\n\nexport interface ClientsSayingSectionProps {\n  className?: string;\n}\n\n/**\n * Top-Left Droplets Pattern:\n * Sliced capsule / bowl droplets with curved convex bottom and flat top,\n * tilted ~ -16\302\260 upwards-right, exactly matching the user\'s reference screenshot:\n * 9 droplets arranged in a dynamic wave above \"What Our Clients Are Saying\".\n */\nexport const ClientLeftDropletGroup: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  // Curved bottom bowl droplet:\n  // Flat top edge, rounded corner radiuses on the sides, deeply curved smooth elliptical bottom\n  const renderCurvedBottomDroplet = (\n    cx: number,\n    cy: number,\n    rot = -16,\n    w = 21,\n    h = 9.5,\n    cr = 2.2,\n    key = `d-${cx}-${cy}`\n  ) => {\n    const hw = w / 2;\n    const hh = h / 2;\n    // Path centered at (0, 0):\n    // Top flat edge from (-hw + cr) to (hw - cr) at y = -hh\n    // Rounded top-right corner to (hw, -hh + cr)\n    // Deep curved elliptical bowl bottom to (-hw, -hh + cr)\n    // Rounded top-left corner back to (-hw + cr, -hh)\n    const d = `\n      M ${-hw + cr} ${-hh}\n      L ${hw - cr} ${-hh}\n      Q ${hw} ${-hh} ${hw} ${-hh + cr}\n      A ${hw} ${h - cr} 0 0 1 ${-hw} ${-hh + cr}\n      Q ${-hw} ${-hh} ${-hw + cr} ${-hh}\n      Z\n    `;\n\n    return (\n      <path\n        key={key}\n        d={d}\n        fill={color}\n        transform={`translate(${cx}, ${cy}) rotate(${rot})`}\n      />\n    );\n  };\n\n  return (\n    <svg\n      viewBox=\"0 0 144 86\"\n      className={`w-[78px] sm:w-[88px] md:w-[100px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* 1. Topmost center-peak droplet */}\n      {renderCurvedBottomDroplet(76, 11, -16, 21, 9.5, 2.2, \"d-top\")}\n\n      {/* 2. Left column (2 droplets) */}\n      {renderCurvedBottomDroplet(24, 25, -17, 21, 9.5, 2.2, \"d-left-top\")}\n      {renderCurvedBottomDroplet(30, 49, -16, 21, 9.5, 2.2, \"d-left-bot\")}\n\n      {/* 3. Middle-left column (2 droplets) */}\n      {renderCurvedBottomDroplet(56, 40, -17, 21, 9.5, 2.2, \"d-mid-top\")}\n      {renderCurvedBottomDroplet(62, 63, -17, 21, 9.5, 2.2, \"d-mid-bot\")}\n\n      {/* 4. Center-right lower droplet */}\n      {renderCurvedBottomDroplet(88, 54, -16, 21, 9.5, 2.2, \"d-center-right\")}\n\n      {/* 5. Right column (3 descending droplets) */}\n      {renderCurvedBottomDroplet(108, 25, -16, 21, 9.5, 2.2, \"d-right-top\")}\n      {renderCurvedBottomDroplet(114, 49, -16, 21, 9.5, 2.2, \"d-right-mid\")}\n      {renderCurvedBottomDroplet(120, 72, -17, 21, 9.5, 2.2, \"d-right-bot\")}\n    </svg>\n  );\n};\n\n/**\n * Top-Right Droplets Pattern:\n * Sliced dome droplets with curved convex top and flat bottom (with soft rounded corners),\n * matching the user\'s reference screenshot:\n * Row 1 (top):    [Col 1]\n * Row 2:          [Col 1]  [Col 2]  [Col 3]\n * Row 3:          [Col 1]           [Col 3]  [Col 4 (right edge)]\n * Row 4 (bottom):          [Col 2]           [Col 4 (right edge)]\n */\nexport const ClientRightDropletGroup: React.FC<{ color?: string; className?: string }> = ({\n  color = \"#D1D5DB\",\n  className = \"\",\n}) => {\n  // Curved top dome droplet:\n  // Smooth semicircular/elliptical dome top, flat bottom horizontal edge, and softly rounded bottom corners\n  const renderCurvedTopDome = (\n    x: number,\n    y: number,\n    key: string,\n    w = 19,\n    h = 9.5,\n    cr = 1.8\n  ) => {\n    const d = `\n      M ${x} ${y + h - cr}\n      A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n      Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n      L ${x + cr} ${y + h}\n      Q ${x} ${y + h} ${x} ${y + h - cr}\n      Z\n    `;\n    return <path key={key} d={d} fill={color} />;\n  };\n\n  return (\n    <svg\n      viewBox=\"0 0 88 58\"\n      className={`w-[68px] sm:w-[80px] md:w-[92px] lg:w-[100px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* Row 1 (top): Col 1 */}\n      {renderCurvedTopDome(2, 2, \"r-1-1\")}\n\n      {/* Row 2: Col 1, Col 2, Col 3 */}\n      {renderCurvedTopDome(2, 17, \"r-2-1\")}\n      {renderCurvedTopDome(24, 17, \"r-2-2\")}\n      {renderCurvedTopDome(46, 17, \"r-2-3\")}\n\n      {/* Row 3: Col 1, Col 3, Col 4 (flush to right edge) */}\n      {renderCurvedTopDome(2, 32, \"r-3-1\")}\n      {renderCurvedTopDome(46, 32, \"r-3-3\")}\n      {renderCurvedTopDome(68, 32, \"r-3-4\")}\n\n      {/* Row 4 (bottom): Col 2, Col 4 (flush to right edge) */}\n      {renderCurvedTopDome(24, 47, \"r-4-2\")}\n      {renderCurvedTopDome(68, 47, \"r-4-4\")}\n    </svg>\n  );\n};\n\n/**\n * High-fidelity vector avatars matching the colorful circular avatars in the screenshot\n */\nconst Avatar1 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#38BDF8\" />\n    {/* Body / Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#F43F5E\" />\n    <path d=\"M16 28L20 33L24 28H16Z\" fill=\"#E2E8F0\" />\n    {/* Head & Neck */}\n    <rect x=\"18\" y=\"22\" width=\"4\" height=\"6\" fill=\"#FCD34D\" />\n    <circle cx=\"20\" cy=\"18\" r=\"7.5\" fill=\"#FDE68A\" />\n    {/* Hair & Beard */}\n    <path d=\"M12.5 17C12.5 12 15.5 10 20 10C24.5 10 27.5 12 27.5 17C27.5 14 26 12 20 12C14 12 12.5 14 12.5 17Z\" fill=\"#78350F\" />\n    <path d=\"M15 19C15 23.5 17.5 26 20 26C22.5 26 25 23.5 25 19C25 21 23 23 20 23C17 23 15 21 15 19Z\" fill=\"#78350F\" />\n  </svg>\n);\n\nconst Avatar2 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#60A5FA\" />\n    {/* Body / Yellow Shirt */}\n    <path d=\"M7 40C7 31 13 27 20 27C27 27 33 31 33 40H7Z\" fill=\"#FBBF24\" />\n    <path d=\"M16 27L20 32L24 27H16Z\" fill=\"#FFFFFF\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"8\" fill=\"#FDE68A\" />\n    {/* Yellow/Blonde hair */}\n    <path d=\"M12 18C12 11 15 8 20 8C25 8 28 11 28 18C27 12 24.5 10 20 10C15.5 10 13 12 12 18Z\" fill=\"#F59E0B\" />\n  </svg>\n);\n\nconst Avatar3 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#FB923C\" />\n    {/* Body / Green Shirt */}\n    <path d=\"M7 40C7 31.5 13 27.5 20 27.5C27 27.5 33 31.5 33 40H7Z\" fill=\"#22C55E\" />\n    <path d=\"M17 27.5L20 32L23 27.5H17Z\" fill=\"#FDE68A\" />\n    {/* Long brown hair behind */}\n    <path d=\"M11 20C11 14 15 10 20 10C25 10 29 14 29 20V26C29 26 27 28 25 28H15C13 28 11 26 11 26V20Z\" fill=\"#92400E\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"7.5\" fill=\"#FDE68A\" />\n    {/* Front parted bangs */}\n    <path d=\"M13 16C15 11 18 11 20 13C22 11 25 11 27 16C26 13 23 12 20 12C17 12 14 13 13 16Z\" fill=\"#78350F\" />\n  </svg>\n);\n\nconst Avatar4 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#C084FC\" />\n    {/* Body / Pink Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#EC4899\" />\n    <path d=\"M17 28L20 33L23 28H17Z\" fill=\"#FFFFFF\" />\n    {/* Hair bun */}\n    <circle cx=\"20\" cy=\"9\" r=\"4.5\" fill=\"#312E81\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"19\" r=\"7.5\" fill=\"#FED7AA\" />\n    {/* Front hair */}\n    <path d=\"M13 18C13 13 16 11 20 11C24 11 27 13 27 18C26 14 23 13 20 13C17 13 14 14 13 18Z\" fill=\"#312E81\" />\n  </svg>\n);\n\nconst Avatar5 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#818CF8\" />\n    {/* Body / Dark Navy with Red Collar */}\n    <path d=\"M7 40C7 31.5 13 27.5 20 27.5C27 27.5 33 31.5 33 40H7Z\" fill=\"#1E293B\" />\n    <path d=\"M15 27.5L20 33.5L25 27.5H15Z\" fill=\"#EF4444\" />\n    {/* Head */}\n    <circle cx=\"20\" cy=\"18\" r=\"8\" fill=\"#FCD34D\" />\n    {/* Short dark hair */}\n    <path d=\"M12 17C12 11 15.5 9 20 9C24.5 9 28 11 28 17C27 13 24 11 20 11C16 11 13 13 12 17Z\" fill=\"#1E1B4B\" />\n  </svg>\n);\n\nconst Avatar6 = () => (\n  <svg viewBox=\"0 0 40 40\" className=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <circle cx=\"20\" cy=\"20\" r=\"20\" fill=\"#FB7185\" />\n    {/* Body / Bright Yellow Shirt */}\n    <path d=\"M7 40C7 32 13 28 20 28C27 28 33 32 33 40H7Z\" fill=\"#FACC15\" />\n    <path d=\"M16 28L20 33L24 28H16Z\" fill=\"#FFFFFF\" />\n    {/* Red / Auburn hair */}\n    <circle cx=\"20\" cy=\"19\" r=\"8\" fill=\"#FFEDD5\" />\n    <path d=\"M11 21C11 14 15 10 20 10C25 10 29 14 29 21C27 13 24 11.5 20 11.5C16 11.5 13 13 11 21Z\" fill=\"#DC2626\" />\n  </svg>\n);\n\n/**\n * 5-Star Rating component matching the screenshot:\n * 4 solid gold stars and 1 half-gold star (or 4.5 rating representation)\n */\nconst StarRating = ({ rating = 4.5 }: { rating?: number }) => {\n  return (\n    <div className=\"flex items-center gap-0.5 select-none\" aria-label={`Rating: ${rating} out of 5 stars`}>\n      {/* 4 Full Stars */}\n      {[0, 1, 2, 3].map((index) => (\n        <svg\n          key={index}\n          className=\"w-3 h-3 text-[#FBBF24] fill-current\"\n          viewBox=\"0 0 20 20\"\n        >\n          <path d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\" />\n        </svg>\n      ))}\n\n      {/* 5th Star: Half filled star for 4.5 */}\n      <svg className=\"w-3 h-3 text-[#FBBF24]\" viewBox=\"0 0 20 20\">\n        <defs>\n          <linearGradient id=\"halfStarGrad\">\n            <stop offset=\"55%\" stopColor=\"#FBBF24\" />\n            <stop offset=\"55%\" stopColor=\"#4B5563\" />\n          </linearGradient>\n        </defs>\n        <path\n          fill=\"url(#halfStarGrad)\"\n          d=\"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z\"\n        />\n      </svg>\n\n      {/* Numeric score \"(4.5)\" matching screenshot */}\n      <span className=\"text-[10px] sm:text-[11px] text-neutral-400 font-medium ml-1\">\n        ({rating.toFixed(1)})\n      </span>\n    </div>\n  );\n};\n\nexport interface TestimonialCardData {\n  id: number;\n  title: string;\n  comment: string;\n  authorName: string;\n  authorRole: string;\n  rating: number;\n  AvatarComponent: React.ComponentType;\n}\n\nconst TESTIMONIALS: TestimonialCardData[] = [\n  {\n    id: 1,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar1,\n  },\n  {\n    id: 2,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar2,\n  },\n  {\n    id: 3,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar3,\n  },\n  {\n    id: 4,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar4,\n  },\n  {\n    id: 5,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar5,\n  },\n  {\n    id: 6,\n    title: \"The Best Training Program!\",\n    comment:\n      \"The boxing program helped me build confidence, strength, and endurance. The coaches are supportive and push you to be your best. Highly recommend for anyone serious about their fitness!\",\n    authorName: \"Stive meloni\",\n    authorRole: \"Ceo Of Miko\",\n    rating: 4.5,\n    AvatarComponent: Avatar6,\n  },\n];\n\nexport const ClientsSayingSection: React.FC<ClientsSayingSectionProps> = ({\n  className = \"\",\n}) => {\n  return (\n    <section\n      id=\"testimonials\"\n      className={`w-full pb-8 sm:pb-12 md:pb-16 select-none relative scroll-mt-6 ${className}`}\n    >\n      {/* 1. Header with Left and Right Droplets:\n          Positioned identically across all screen sizes (desktop, tablet, mobile):\n          - Left droplet directly above the title on the left\n          - Right droplet aligned at the top right edge\n      */}\n      <div className=\"w-full relative flex items-start justify-between pb-3 sm:pb-5\">\n        {/* Left column: Droplet and Title/Subtitle */}\n        <div className=\"flex flex-col items-start relative z-10 max-w-[80%]\">\n          {/* Top-Left Droplet Pattern */}\n          <div className=\"mb-2 sm:mb-3 pointer-events-none\">\n            <ClientLeftDropletGroup />\n          </div>\n\n          {/* Section Heading */}\n          <h2\n            className=\"text-[20px] sm:text-[24px] md:text-[30px] lg:text-[36px] font-extrabold text-[#23262F] tracking-tight leading-tight\"\n          >\n            What Our Clients Are Saying\n          </h2>\n\n          {/* Section Subtitle */}\n          <p\n            className=\"text-[11px] sm:text-xs md:text-sm lg:text-[15px] font-medium text-slate-500 mt-1 sm:mt-1.5 leading-relaxed\"\n          >\n            Real Stories, Real Results \342\200\224 Hear From Our Athletes\n          </p>\n        </div>\n\n        {/* Right column: Top-Right Droplet Pattern adjusted slightly higher and further right */}\n        <div className=\"self-end mb-2 md:mb-4 flex-shrink-0 pointer-events-none ml-auto -mr-2 sm:-mr-6 md:-mr-8 lg:-mr-11\">\n          <ClientRightDropletGroup />\n        </div>\n      </div>\n\n      {/* 2. Light Grey Container with Rounded Corners (matching reference image) */}\n      <div className=\"w-full bg-[#ECEEF0] rounded-[24px] sm:rounded-[32px] md:rounded-[40px] lg:rounded-[44px] p-4 sm:p-6 md:p-8 lg:p-10 shadow-sm mt-3 sm:mt-4\">\n        {/* Responsive Grid of 6 Dark Testimonial Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6\">\n          {TESTIMONIALS.map((item) => {\n            const Avatar = item.AvatarComponent;\n            return (\n              <div\n                key={item.id}\n                className=\"bg-black text-white rounded-[20px] sm:rounded-[24px] p-5 sm:p-6 flex flex-col justify-between shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-[1.01] group border border-white/5\"\n              >\n                {/* Top content: Title and Review */}\n                <div>\n                  <h3 className=\"text-white font-bold text-[15px] sm:text-[16px] md:text-[17px] tracking-tight leading-snug\">\n                    {item.title}\n                  </h3>\n                  <p className=\"text-[#A7A9AE] text-xs sm:text-[13px] leading-relaxed mt-2.5 sm:mt-3 font-normal\">\n                    {item.comment}\n                  </p>\n                </div>\n\n                {/* Bottom row: User Avatar, Name, Role, and Star Rating */}\n                <div className=\"flex items-center justify-between mt-5 sm:mt-6 pt-2 border-t border-white/5\">\n                  {/* Left: Avatar + Name/Role */}\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-full overflow-hidden flex-shrink-0 ring-1 ring-white/10 shadow-sm\">\n                      <Avatar />\n                    </div>\n                    <div className=\"flex flex-col min-w-0\">\n                      <span className=\"text-white font-semibold text-xs sm:text-sm tracking-tight truncate\">\n                        {item.authorName}\n                      </span>\n                      <span className=\"text-[#8E9096] text-[10px] sm:text-xs truncate\">\n                        {item.authorRole}\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Right: Star Rating + Score */}\n                  <div className=\"flex-shrink-0 pl-2\">\n                    <StarRating rating={item.rating} />\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default ClientsSayingSection;\n"
    num_lines: 440
    num_bytes: 17280
  }
}
