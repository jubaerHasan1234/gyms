    content: "\"use client\";\nimport React, { useState } from \"react\";\nimport { Check } from \"lucide-react\";\n\nexport interface NewsletterSectionProps {\n  className?: string;\n}\n\n/**\n * VerticalDroplet:\n * D-shaped vertical capsule matching the top-right pattern from the screenshot:\n * Curved round LEFT side, straight vertical RIGHT side.\n */\nconst VerticalDroplet: React.FC<{\n  cx: number;\n  cy: number;\n  width?: number;\n  height?: number;\n  color?: string;\n}> = ({ cx, cy, width = 6.5, height = 15, color = \"#CBD5E1\" }) => {\n  const r = width;\n  return (\n    <path\n      d={`M ${cx + width} ${cy}\n          A ${r} ${height / 2} 0 0 0 ${cx + width} ${cy + height}\n          Z`}\n      fill={color}\n    />\n  );\n};\n\n/**\n * TopRightDropletPattern:\n * Exact 4-column vertical droplet pattern as seen in the user\'s reference screenshot:\n * Kept visible and identical across desktop, tablet, and mobile.\n */\nexport const TopRightDropletPattern: React.FC<{\n  color?: string;\n  className?: string;\n}> = ({ color = \"#CBD5E1\", className = \"\" }) => (\n  <svg\n    className={`w-[32px] sm:w-[46px] md:w-[56px] lg:w-[64px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n    viewBox=\"0 0 66 76\"\n    fill=\"none\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    aria-hidden=\"true\"\n  >\n    {/* Column 1 (x: 2) - Row 4 */}\n    <VerticalDroplet cx={2} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 2 (x: 19) - Rows 2, 3, 4 */}\n    <VerticalDroplet cx={19} cy={20} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={19} cy={38} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={19} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 3 (x: 36) - Rows 1, 2, 4 */}\n    <VerticalDroplet cx={36} cy={2} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={36} cy={20} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={36} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 4 (x: 53) - Rows 1, 3 */}\n    <VerticalDroplet cx={53} cy={2} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={53} cy={38} width={6.5} height={15} color={color} />\n  </svg>\n);\n\n/**\n * BottomLeftDropletPattern:\n * Horizontal dome-shaped droplet pattern with CURVED TOP and flat base\n * as requested (\"this droplet curved top\"):\n * Kept visible and identical across desktop, tablet, and mobile.\n */\nexport const BottomLeftDropletPattern: React.FC<{\n  color?: string;\n  className?: string;\n}> = ({ color = \"#CBD5E1\", className = \"\" }) => {\n  // Curved TOP dome shape, flat bottom with smooth corners\n  const renderDome = (x: number, y: number, key: string, w = 16, h = 8, cr = 1.2) => (\n    <path\n      key={key}\n      d={`M ${x} ${y + h - cr}\n          A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n          Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n          L ${x + cr} ${y + h}\n          Q ${x} ${y + h} ${x} ${y + h - cr}\n          Z`}\n      fill={color}\n    />\n  );\n\n  return (\n    <svg\n      className={`w-[46px] sm:w-[64px] md:w-[78px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      viewBox=\"0 0 106 60\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* Row 1 (top) */}\n      {renderDome(14, 2, \"b-r1-1\")}\n\n      {/* Row 2 */}\n      {renderDome(0, 16, \"b-r2-1\")}\n      {renderDome(28, 16, \"b-r2-2\")}\n      {renderDome(56, 16, \"b-r2-3\")}\n\n      {/* Row 3 */}\n      {renderDome(0, 32, \"b-r3-1\")}\n      {renderDome(42, 32, \"b-r3-2\")}\n      {renderDome(84, 32, \"b-r3-3\")}\n\n      {/* Row 4 (bottom) */}\n      {renderDome(28, 48, \"b-r4-1\")}\n      {renderDome(84, 48, \"b-r4-2\")}\n    </svg>\n  );\n};\n\nexport const NewsletterSection: React.FC<NewsletterSectionProps> = ({\n  className = \"\",\n}) => {\n  const [email, setEmail] = useState(\"\");\n  const [status, setStatus] = useState<\"idle\" | \"success\" | \"error\">(\"idle\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !email.trim()) {\n      setStatus(\"error\");\n      setErrorMessage(\"Please enter your email.\");\n      return;\n    }\n\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email.trim())) {\n      setStatus(\"error\");\n      setErrorMessage(\"Please enter a valid email.\");\n      return;\n    }\n\n    setStatus(\"success\");\n    setErrorMessage(\"\");\n  };\n\n  const handleReset = () => {\n    setEmail(\"\");\n    setStatus(\"idle\");\n    setErrorMessage(\"\");\n  };\n\n  return (\n    <section\n      className={`relative w-full pt-3 sm:pt-4 md:pt-5 lg:pt-6 pb-4 sm:pb-6 md:pb-8 px-2 sm:px-4 md:px-6 bg-white overflow-visible select-text ${className}`}\n      aria-labelledby=\"newsletter-heading\"\n    >\n      {/* \n        1. TOP-RIGHT SIDE DROPLET:\n        Positioned higher up (\"some top\") peaking nicely above the black card at the top-right corner.\n        Uses pure Tailwind responsive classes (sm:, md:, lg:).\n      */}\n      <div\n        className=\"absolute -top-4 sm:-top-4 md:-top-4 lg:-top-5 right-2 sm:right-4 md:right-7 lg:right-10 z-10 pointer-events-none\"\n        aria-hidden=\"true\"\n      >\n        <TopRightDropletPattern />\n      </div>\n\n      {/* \n        2. BOTTOM-LEFT SIDE DROPLET:\n        Positioned at the bottom-left corner in the white canvas area.\n        Uses pure Tailwind responsive classes (sm:, md:, lg:).\n      */}\n      <div\n        className=\"absolute -bottom-1 sm:bottom-0 md:bottom-1 left-2 sm:left-4 md:left-7 lg:left-10 z-10 pointer-events-none\"\n        aria-hidden=\"true\"\n      >\n        <BottomLeftDropletPattern />\n      </div>\n\n      {/* \n        3. MAIN BLACK NEWSLETTER CARD CONTAINER:\n        Pure Tailwind responsive classes (base: mobile, sm:/md: tablet, lg: desktop):\n        - Mobile: more small (w-full max-w-[220px] min-h-[170px])\n        - Small (sm:): max-w-[240px] min-h-[175px]\n        - Tablet (md: - smaller than lg and larger than md): more small (md:max-w-[260px] md:min-h-[185px])\n        - Desktop: some small (lg:max-w-[900px] lg:h-[295px])\n      */}\n      <div\n        className=\"relative z-20 mx-auto bg-black text-white text-center transition-all duration-300 flex flex-col justify-center items-center w-full max-w-[220px] min-h-[170px] rounded-[14px] px-2.5 py-3 sm:max-w-[240px] sm:min-h-[175px] sm:rounded-[15px] sm:px-3 sm:py-3 md:max-w-[260px] md:min-h-[185px] md:rounded-[16px] md:px-3.5 md:py-3.5 lg:max-w-[750px] lg:h-[295px] lg:min-h-0 lg:rounded-[30px] lg:px-8 lg:py-0\"\n      >\n        {/* Eyebrow: Join our community */}\n        <p className=\"font-normal tracking-wide text-neutral-200 text-[8.5px] sm:text-[9px] md:text-[9px] lg:text-[13px] mb-0.5 sm:mb-0.5 md:mb-0.5 lg:mb-1 opacity-80 sm:opacity-100\">\n          Join our community\n        </p>\n\n        {/* \n          Title: Subscribe to our newsletter\n          With red/orange curved underline swoosh with dot under \"newsletter\"\n        */}\n        <h2\n          id=\"newsletter-heading\"\n          className=\"font-bold tracking-tight text-white leading-tight text-[12px] sm:text-[12.5px] md:text-[13px] lg:text-[26px] mb-1 sm:mb-1 md:mb-1 lg:mb-1.5\"\n        >\n          <span>Subscribe to our </span>\n          <span className=\"relative inline-block whitespace-nowrap\">\n            <span>newsletter</span>\n            {/* Red/Orange curved underline swoosh curving towards top side with dot matching reference design */}\n            <svg\n              className=\"absolute left-0 w-full overflow-visible pointer-events-none -bottom-0.5 sm:-bottom-0.5 md:-bottom-0.5 lg:-bottom-2\"\n              viewBox=\"0 0 216 16\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              preserveAspectRatio=\"none\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M 3 12 C 55 2, 155 2, 202 9.5\"\n                stroke=\"#FF5722\"\n                strokeWidth=\"2.4\"\n                className=\"stroke-[1.8] sm:stroke-[1.8] md:stroke-[1.9] lg:stroke-[3]\"\n                strokeLinecap=\"round\"\n              />\n              <circle\n                cx=\"211\"\n                cy=\"10\"\n                r=\"1.8\"\n                className=\"r-[1.3] sm:r-[1.3] md:r-[1.4] lg:r-[2.2]\"\n                fill=\"#FF5722\"\n              />\n            </svg>\n          </span>\n        </h2>\n\n        {/* Subtitle / Description Paragraph - Compact, proportional, and clean */}\n        <p className=\"font-normal text-neutral-300 mx-auto text-[7.5px] max-w-[190px] sm:text-[7.8px] sm:max-w-[205px] md:text-[8px] md:max-w-[225px] lg:text-[12.5px] lg:max-w-[510px] mb-2 sm:mb-2 md:mb-2 lg:mb-4 leading-[1.25] sm:leading-snug lg:leading-relaxed\">\n          Join Our Community Of Fitness Enthusiasts And Athletes! By Subscribing To\n          Our Newsletter, You\'ll Receive Expert Training Tips, Nutrition Guides,\n          Exclusive Discounts, And The Latest News On Upcoming Events And Products.\n        </p>\n\n        {/* Subscription Form / Status */}\n        {status === \"success\" ? (\n          <div className=\"w-full max-w-[200px] sm:max-w-[210px] md:max-w-[220px] lg:max-w-xs mx-auto bg-neutral-900 border border-neutral-700/80 rounded-full py-1 sm:py-1 px-2.5 sm:px-2.5 flex items-center justify-between gap-1.5 text-left animate-fadeIn\">\n            <div className=\"flex items-center gap-1 sm:gap-1\">\n              <span className=\"w-4 h-4 sm:w-4 sm:h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0\">\n                <Check className=\"w-2.5 h-2.5\" />\n              </span>\n              <div>\n                <p className=\"text-[9.5px] sm:text-[9.5px] font-semibold text-white\">\n                  Welcome!\n                </p>\n                <p className=\"text-[8px] sm:text-[8px] text-neutral-400 truncate max-w-[100px] sm:max-w-none\">\n                  Check <span className=\"text-neutral-200\">{email}</span>\n                </p>\n              </div>\n            </div>\n            <button\n              onClick={handleReset}\n              className=\"text-[8.5px] sm:text-[8.5px] text-neutral-400 hover:text-white underline underline-offset-2 shrink-0 transition-colors\"\n            >\n              Change\n            </button>\n          </div>\n        ) : (\n          <form\n            onSubmit={handleSubmit}\n            noValidate\n            className=\"w-full mx-auto max-w-[195px] sm:max-w-[205px] md:max-w-[215px] lg:max-w-[420px]\"\n          >\n            <div className=\"relative rounded-full border border-neutral-400/80 bg-black flex items-center justify-between transition-all focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 p-0.5 sm:p-0.5 pl-2 sm:pl-2 md:pl-2.5\">\n              <div className=\"flex items-center flex-1 min-w-0 pr-1\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter Your Email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full bg-transparent text-white placeholder:text-neutral-400 outline-none truncate font-medium text-[8px] sm:text-[8px] md:text-[8.5px] lg:text-xs\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full transition-all duration-150 cursor-pointer shadow-sm px-2 py-0.5 text-[7.5px] sm:text-[7.5px] md:text-[8px] lg:px-5 lg:py-1.5 lg:text-[11px]\"\n              >\n                SUBSCRIBE\n              </button>\n            </div>\n\n            {/* Error Message if invalid */}\n            {status === \"error\" && (\n              <p\n                role=\"alert\"\n                className=\"mt-0.5 text-[8.5px] sm:text-[10px] text-red-400 font-medium text-center\"\n              >\n                {errorMessage}\n              </p>\n            )}\n          </form>\n        )}\n      </div>\n    </section>\n  );\n};\n\nexport default NewsletterSection;\n"
    raw_content: "\"use client\";\nimport React, { useState } from \"react\";\nimport { Check } from \"lucide-react\";\n\nexport interface NewsletterSectionProps {\n  className?: string;\n}\n\n/**\n * VerticalDroplet:\n * D-shaped vertical capsule matching the top-right pattern from the screenshot:\n * Curved round LEFT side, straight vertical RIGHT side.\n */\nconst VerticalDroplet: React.FC<{\n  cx: number;\n  cy: number;\n  width?: number;\n  height?: number;\n  color?: string;\n}> = ({ cx, cy, width = 6.5, height = 15, color = \"#CBD5E1\" }) => {\n  const r = width;\n  return (\n    <path\n      d={`M ${cx + width} ${cy}\n          A ${r} ${height / 2} 0 0 0 ${cx + width} ${cy + height}\n          Z`}\n      fill={color}\n    />\n  );\n};\n\n/**\n * TopRightDropletPattern:\n * Exact 4-column vertical droplet pattern as seen in the user\'s reference screenshot:\n * Kept visible and identical across desktop, tablet, and mobile.\n */\nexport const TopRightDropletPattern: React.FC<{\n  color?: string;\n  className?: string;\n}> = ({ color = \"#CBD5E1\", className = \"\" }) => (\n  <svg\n    className={`w-[32px] sm:w-[46px] md:w-[56px] lg:w-[64px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n    viewBox=\"0 0 66 76\"\n    fill=\"none\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    aria-hidden=\"true\"\n  >\n    {/* Column 1 (x: 2) - Row 4 */}\n    <VerticalDroplet cx={2} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 2 (x: 19) - Rows 2, 3, 4 */}\n    <VerticalDroplet cx={19} cy={20} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={19} cy={38} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={19} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 3 (x: 36) - Rows 1, 2, 4 */}\n    <VerticalDroplet cx={36} cy={2} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={36} cy={20} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={36} cy={56} width={6.5} height={15} color={color} />\n\n    {/* Column 4 (x: 53) - Rows 1, 3 */}\n    <VerticalDroplet cx={53} cy={2} width={6.5} height={15} color={color} />\n    <VerticalDroplet cx={53} cy={38} width={6.5} height={15} color={color} />\n  </svg>\n);\n\n/**\n * BottomLeftDropletPattern:\n * Horizontal dome-shaped droplet pattern with CURVED TOP and flat base\n * as requested (\"this droplet curved top\"):\n * Kept visible and identical across desktop, tablet, and mobile.\n */\nexport const BottomLeftDropletPattern: React.FC<{\n  color?: string;\n  className?: string;\n}> = ({ color = \"#CBD5E1\", className = \"\" }) => {\n  // Curved TOP dome shape, flat bottom with smooth corners\n  const renderDome = (x: number, y: number, key: string, w = 16, h = 8, cr = 1.2) => (\n    <path\n      key={key}\n      d={`M ${x} ${y + h - cr}\n          A ${w / 2} ${h} 0 0 1 ${x + w} ${y + h - cr}\n          Q ${x + w} ${y + h} ${x + w - cr} ${y + h}\n          L ${x + cr} ${y + h}\n          Q ${x} ${y + h} ${x} ${y + h - cr}\n          Z`}\n      fill={color}\n    />\n  );\n\n  return (\n    <svg\n      className={`w-[46px] sm:w-[64px] md:w-[78px] h-auto overflow-visible select-none pointer-events-none ${className}`}\n      viewBox=\"0 0 106 60\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden=\"true\"\n    >\n      {/* Row 1 (top) */}\n      {renderDome(14, 2, \"b-r1-1\")}\n\n      {/* Row 2 */}\n      {renderDome(0, 16, \"b-r2-1\")}\n      {renderDome(28, 16, \"b-r2-2\")}\n      {renderDome(56, 16, \"b-r2-3\")}\n\n      {/* Row 3 */}\n      {renderDome(0, 32, \"b-r3-1\")}\n      {renderDome(42, 32, \"b-r3-2\")}\n      {renderDome(84, 32, \"b-r3-3\")}\n\n      {/* Row 4 (bottom) */}\n      {renderDome(28, 48, \"b-r4-1\")}\n      {renderDome(84, 48, \"b-r4-2\")}\n    </svg>\n  );\n};\n\nexport const NewsletterSection: React.FC<NewsletterSectionProps> = ({\n  className = \"\",\n}) => {\n  const [email, setEmail] = useState(\"\");\n  const [status, setStatus] = useState<\"idle\" | \"success\" | \"error\">(\"idle\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !email.trim()) {\n      setStatus(\"error\");\n      setErrorMessage(\"Please enter your email.\");\n      return;\n    }\n\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email.trim())) {\n      setStatus(\"error\");\n      setErrorMessage(\"Please enter a valid email.\");\n      return;\n    }\n\n    setStatus(\"success\");\n    setErrorMessage(\"\");\n  };\n\n  const handleReset = () => {\n    setEmail(\"\");\n    setStatus(\"idle\");\n    setErrorMessage(\"\");\n  };\n\n  return (\n    <section\n      className={`relative w-full pt-3 sm:pt-4 md:pt-5 lg:pt-6 pb-4 sm:pb-6 md:pb-8 px-2 sm:px-4 md:px-6 bg-white overflow-visible select-text ${className}`}\n      aria-labelledby=\"newsletter-heading\"\n    >\n      {/* \n        1. TOP-RIGHT SIDE DROPLET:\n        Positioned higher up (\"some top\") peaking nicely above the black card at the top-right corner.\n        Uses pure Tailwind responsive classes (sm:, md:, lg:).\n      */}\n      <div\n        className=\"absolute -top-4 sm:-top-4 md:-top-4 lg:-top-5 right-2 sm:right-4 md:right-7 lg:right-10 z-10 pointer-events-none\"\n        aria-hidden=\"true\"\n      >\n        <TopRightDropletPattern />\n      </div>\n\n      {/* \n        2. BOTTOM-LEFT SIDE DROPLET:\n        Positioned at the bottom-left corner in the white canvas area.\n        Uses pure Tailwind responsive classes (sm:, md:, lg:).\n      */}\n      <div\n        className=\"absolute -bottom-1 sm:bottom-0 md:bottom-1 left-2 sm:left-4 md:left-7 lg:left-10 z-10 pointer-events-none\"\n        aria-hidden=\"true\"\n      >\n        <BottomLeftDropletPattern />\n      </div>\n\n      {/* \n        3. MAIN BLACK NEWSLETTER CARD CONTAINER:\n        Pure Tailwind responsive classes (base: mobile, sm:/md: tablet, lg: desktop):\n        - Mobile: more small (w-full max-w-[220px] min-h-[170px])\n        - Small (sm:): max-w-[240px] min-h-[175px]\n        - Tablet (md: - smaller than lg and larger than md): more small (md:max-w-[260px] md:min-h-[185px])\n        - Desktop: some small (lg:max-w-[900px] lg:h-[295px])\n      */}\n      <div\n        className=\"relative z-20 mx-auto bg-black text-white text-center transition-all duration-300 flex flex-col justify-center items-center w-full max-w-[220px] min-h-[170px] rounded-[14px] px-2.5 py-3 sm:max-w-[240px] sm:min-h-[175px] sm:rounded-[15px] sm:px-3 sm:py-3 md:max-w-[260px] md:min-h-[185px] md:rounded-[16px] md:px-3.5 md:py-3.5 lg:max-w-[750px] lg:h-[295px] lg:min-h-0 lg:rounded-[30px] lg:px-8 lg:py-0\"\n      >\n        {/* Eyebrow: Join our community */}\n        <p className=\"font-normal tracking-wide text-neutral-200 text-[8.5px] sm:text-[9px] md:text-[9px] lg:text-[13px] mb-0.5 sm:mb-0.5 md:mb-0.5 lg:mb-1 opacity-80 sm:opacity-100\">\n          Join our community\n        </p>\n\n        {/* \n          Title: Subscribe to our newsletter\n          With red/orange curved underline swoosh with dot under \"newsletter\"\n        */}\n        <h2\n          id=\"newsletter-heading\"\n          className=\"font-bold tracking-tight text-white leading-tight text-[12px] sm:text-[12.5px] md:text-[13px] lg:text-[26px] mb-1 sm:mb-1 md:mb-1 lg:mb-1.5\"\n        >\n          <span>Subscribe to our </span>\n          <span className=\"relative inline-block whitespace-nowrap\">\n            <span>newsletter</span>\n            {/* Red/Orange curved underline swoosh curving towards top side with dot matching reference design */}\n            <svg\n              className=\"absolute left-0 w-full overflow-visible pointer-events-none -bottom-0.5 sm:-bottom-0.5 md:-bottom-0.5 lg:-bottom-2\"\n              viewBox=\"0 0 216 16\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              preserveAspectRatio=\"none\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M 3 12 C 55 2, 155 2, 202 9.5\"\n                stroke=\"#FF5722\"\n                strokeWidth=\"2.4\"\n                className=\"stroke-[1.8] sm:stroke-[1.8] md:stroke-[1.9] lg:stroke-[3]\"\n                strokeLinecap=\"round\"\n              />\n              <circle\n                cx=\"211\"\n                cy=\"10\"\n                r=\"1.8\"\n                className=\"r-[1.3] sm:r-[1.3] md:r-[1.4] lg:r-[2.2]\"\n                fill=\"#FF5722\"\n              />\n            </svg>\n          </span>\n        </h2>\n\n        {/* Subtitle / Description Paragraph - Compact, proportional, and clean */}\n        <p className=\"font-normal text-neutral-300 mx-auto text-[7.5px] max-w-[190px] sm:text-[7.8px] sm:max-w-[205px] md:text-[8px] md:max-w-[225px] lg:text-[12.5px] lg:max-w-[510px] mb-2 sm:mb-2 md:mb-2 lg:mb-4 leading-[1.25] sm:leading-snug lg:leading-relaxed\">\n          Join Our Community Of Fitness Enthusiasts And Athletes! By Subscribing To\n          Our Newsletter, You\'ll Receive Expert Training Tips, Nutrition Guides,\n          Exclusive Discounts, And The Latest News On Upcoming Events And Products.\n        </p>\n\n        {/* Subscription Form / Status */}\n        {status === \"success\" ? (\n          <div className=\"w-full max-w-[200px] sm:max-w-[210px] md:max-w-[220px] lg:max-w-xs mx-auto bg-neutral-900 border border-neutral-700/80 rounded-full py-1 sm:py-1 px-2.5 sm:px-2.5 flex items-center justify-between gap-1.5 text-left animate-fadeIn\">\n            <div className=\"flex items-center gap-1 sm:gap-1\">\n              <span className=\"w-4 h-4 sm:w-4 sm:h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0\">\n                <Check className=\"w-2.5 h-2.5\" />\n              </span>\n              <div>\n                <p className=\"text-[9.5px] sm:text-[9.5px] font-semibold text-white\">\n                  Welcome!\n                </p>\n                <p className=\"text-[8px] sm:text-[8px] text-neutral-400 truncate max-w-[100px] sm:max-w-none\">\n                  Check <span className=\"text-neutral-200\">{email}</span>\n                </p>\n              </div>\n            </div>\n            <button\n              onClick={handleReset}\n              className=\"text-[8.5px] sm:text-[8.5px] text-neutral-400 hover:text-white underline underline-offset-2 shrink-0 transition-colors\"\n            >\n              Change\n            </button>\n          </div>\n        ) : (\n          <form\n            onSubmit={handleSubmit}\n            noValidate\n            className=\"w-full mx-auto max-w-[195px] sm:max-w-[205px] md:max-w-[215px] lg:max-w-[420px]\"\n          >\n            <div className=\"relative rounded-full border border-neutral-400/80 bg-black flex items-center justify-between transition-all focus-within:border-white focus-within:ring-2 focus-within:ring-white/20 p-0.5 sm:p-0.5 pl-2 sm:pl-2 md:pl-2.5\">\n              <div className=\"flex items-center flex-1 min-w-0 pr-1\">\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => {\n                    setEmail(e.target.value);\n                    if (status === \"error\") {\n                      setStatus(\"idle\");\n                      setErrorMessage(\"\");\n                    }\n                  }}\n                  placeholder=\"Enter Your Email\"\n                  aria-label=\"Email Address\"\n                  className=\"w-full bg-transparent text-white placeholder:text-neutral-400 outline-none truncate font-medium text-[8px] sm:text-[8px] md:text-[8.5px] lg:text-xs\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"shrink-0 bg-white hover:bg-neutral-200 active:scale-95 text-black font-bold uppercase tracking-wider rounded-full transition-all duration-150 cursor-pointer shadow-sm px-2 py-0.5 text-[7.5px] sm:text-[7.5px] md:text-[8px] lg:px-5 lg:py-1.5 lg:text-[11px]\"\n              >\n                SUBSCRIBE\n              </button>\n            </div>\n\n            {/* Error Message if invalid */}\n            {status === \"error\" && (\n              <p\n                role=\"alert\"\n                className=\"mt-0.5 text-[8.5px] sm:text-[10px] text-red-400 font-medium text-center\"\n              >\n                {errorMessage}\n              </p>\n            )}\n          </form>\n        )}\n      </div>\n    </section>\n  );\n};\n\nexport default NewsletterSection;\n"
    num_lines: 313
    num_bytes: 12172
  }
}
