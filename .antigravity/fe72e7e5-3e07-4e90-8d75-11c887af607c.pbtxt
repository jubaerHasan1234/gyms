      arguments_json: "{\"Content\":\"import React from \\\"react\\\";\\n\\nexport const WhyTrainWithUs: React.FC = () => {\\n  return (\\n    <div className=\\\"flex-1 flex flex-col justify-between space-y-5 sm:space-y-6\\\">\\n      <div>\\n        <h3 className=\\\"text-sm sm:text-base md:text-lg font-bold text-white tracking-tight\\\">\\n          Why Train With Us:\\n        </h3>\\n      </div>\\n\\n      {/* Point 1 */}\\n      <div>\\n        <h4 className=\\\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\\\">\\n          Expert Coaches\\n        </h4>\\n        <p className=\\\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\\\">\\n          Our experienced boxing trainers have worked with amateur and professional athletes, ensuring you get the best training tailored to your goals.\\n        </p>\\n      </div>\\n\\n      {/* Point 2 */}\\n      <div>\\n        <h4 className=\\\"text-xs sm:text-sm md:text-base font-semibold text-white tracking-tight\\\">\\n          Flexible Programs\\n        </h4>\\n        <p className=\\\"text-[11px] sm:text-xs text-neutral-400 mt-1 leading-relaxed\\\">\\n          Whether you\'re a beginner or seasoned boxer, we offer flexible programs that fit your schedule and needs.\\n        </p>\\n      </div>\\n\\n      {/* Call to Action: Punch Now Button + Video Play Button */}\\n      <div className=\\\"pt-2 sm:pt-4 flex items-center gap-3 sm:gap-4\\\">\\n        {/* Bright Green Punch Now Button */}\\n        <button\\n          type=\\\"button\\\"\\n          className=\\\"bg-[#5DB928] hover:bg-[#68CE2C] active:scale-95 text-white font-bold text-xs sm:text-sm md:text-base px-6 sm:px-8 md:px-10 py-2.5 sm:py-3 rounded-[12px] sm:rounded-[14px] transition-all cursor-pointer shadow-lg shadow-green-900/40 select-none flex-shrink-0\\\"\\n        >\\n          Punch Now\\n        </button>\\n\\n        {/* Circular Play Button with Dashed/Pattern Ring */}\\n        <button\\n          type=\\\"button\\\"\\n          aria-label=\\\"Play training video preview\\\"\\n          className=\\\"w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 rounded-full border border-dashed border-[#5DB928]/80 hover:border-[#68CE2C] flex items-center justify-center transition-all cursor-pointer active:scale-90 group flex-shrink-0\\\"\\n        >\\n          {/* Play triangle */}\\n          <div\\n            className=\\\"w-0 h-0 ml-0.5 border-y-[6px] border-y-transparent border-l-[10px] border-l-[#5DB928] group-hover:border-l-[#68CE2C] transition-colors\\\"\\n          />\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\\nexport default WhyTrainWithUs;\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/training/WhyTrainWithUs.tsx\", \"toolAction\":\"Creating WhyTrainWithUs.tsx\", \"toolSummary\":\"Create WhyTrainWithUs component\"}"
