      checkpoint_index: -1
      created_at {
        seconds: 1791532362
        nanos: 26336599
      }
      time_since_last_invocation {
        seconds: 12
        nanos: 215354179
      }
      context_window_metadata {
        estimated_tokens_used: 109411
        token_breakdown {
