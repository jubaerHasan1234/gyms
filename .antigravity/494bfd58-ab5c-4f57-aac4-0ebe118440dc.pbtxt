    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport React, { useState } from \"react\";\nimport Link from \"next/link\";\nimport { KeyRound, Mail, ArrowRight, Loader2, AlertCircle, CheckCircle2, ArrowLeft } from \"lucide-react\";\nimport { AuthInputField } from \"../common/AuthInputField\";\nimport { OtpVerificationCard } from \"../otp/OtpVerificationCard\";\nimport { ResetPasswordForm } from \"./ResetPasswordForm\";\nimport { authApi } from \"@/lib/authApi\";\nimport { useAuth } from \"@/context/AuthContext\";\n\ntype Step = \"request\" | \"verify\" | \"reset\";\n\nexport const ForgotPasswordCard: React.FC = () => {\n  const { setLatestOtpInfo } = useAuth();\n  const [step, setStep] = useState<Step>(\"request\");\n  const [email, setEmail] = useState(\"\");\n  const [otp, setOtp] = useState(\"\");\n  const [resetToken, setResetToken] = useState(\"\");\n\n  const [loading, setLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n\n  const handleRequestOtp = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMessage(null);\n\n    if (!email.trim()) {\n      setErrorMessage(\"Please enter your account email address.\");\n      return;\n    }\n\n    try {\n      setLoading(true);\n      const res = await authApi.forgotPassword(email);\n\n      if (res.data?.otp) {\n        setOtp(res.data.otp);\n        setLatestOtpInfo({\n          email: email.trim(),\n          otp: res.data.otp,\n          type: \"forgot\",\n        });\n        setSuccessMessage(\"Verification code generated! Please verify below.\");\n        setStep(\"verify\");\n      } else {\n        setErrorMessage(res.message || \"Failed to send reset code. Please verify your email.\");\n      }\n    } catch (err: any) {\n      setErrorMessage(err?.message || \"Error requesting password reset.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"w-full\">\n      {step === \"verify\" && (\n        <OtpVerificationCard\n          email={email}\n          initialOtp={otp}\n          isForgotPasswordFlow={true}\n          onForgotVerified={(token) => {\n            setResetToken(token);\n            setStep(\"reset\");\n          }}\n        />\n      )}\n\n      {step === \"reset\" && (\n        <div className=\"w-full bg-[#121417]/90 backdrop-blur-xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden\">\n          <div className=\"absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#71AC16] to-transparent\" />\n          <div className=\"mb-6\">\n            <div className=\"w-12 h-12 rounded-2xl bg-[#71AC16]/10 border border-[#71AC16]/30 text-[#71AC16] flex items-center justify-center mb-4\">\n              <KeyRound className=\"w-6 h-6\" />\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-black text-white uppercase tracking-tight\">\n              Create New <span className=\"text-[#71AC16]\">Password</span>\n            </h1>\n            <p className=\"text-neutral-400 text-xs sm:text-sm mt-1.5 leading-relaxed\">\n              Your identity has been verified. Enter a secure new password for your account.\n            </p>\n          </div>\n\n          <ResetPasswordForm token={resetToken} email={email} />\n        </div>\n      )}\n\n      {step === \"request\" && (\n        <div className=\"w-full bg-[#121417]/90 backdrop-blur-xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden\">\n          <div className=\"absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#71AC16] to-transparent\" />\n\n          <div className=\"mb-7\">\n            <div className=\"w-12 h-12 rounded-2xl bg-[#71AC16]/10 border border-[#71AC16]/30 text-[#71AC16] flex items-center justify-center mb-4\">\n              <KeyRound className=\"w-6 h-6\" />\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-black text-white uppercase tracking-tight\">\n              Reset Your <span className=\"text-[#71AC16]\">Password</span>\n            </h1>\n            <p className=\"text-neutral-400 text-xs sm:text-sm mt-1.5 leading-relaxed\">\n              Enter your registered email. We will generate a verification code to authenticate your request.\n            </p>\n          </div>\n\n          {successMessage && (\n            <div className=\"mb-5 p-4 rounded-xl bg-[#71AC16]/15 border border-[#71AC16]/50 text-[#86ce1e] text-xs font-semibold flex items-center gap-3\">\n              <CheckCircle2 className=\"w-5 h-5 flex-shrink-0 text-[#71AC16]\" />\n              <span>{successMessage}</span>\n            </div>\n          )}\n\n          {errorMessage && (\n            <div className=\"mb-5 p-4 rounded-xl bg-red-950/40 border border-red-500/50 text-red-200 text-xs font-semibold flex items-start gap-3\">\n              <AlertCircle className=\"w-5 h-5 flex-shrink-0 text-red-400 mt-0.5\" />\n              <div className=\"flex-1 leading-relaxed\">{errorMessage}</div>\n            </div>\n          )}\n\n          <form onSubmit={handleRequestOtp} className=\"space-y-5\">\n            <AuthInputField\n              label=\"Account Email\"\n              type=\"email\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              placeholder=\"warrior@example.com\"\n              icon={<Mail className=\"w-4 h-4\" />}\n              required\n              autoFocus\n            />\n\n            <button\n              type=\"submit\"\n              disabled={loading || !email}\n              className=\"w-full mt-2 py-3.5 px-6 rounded-xl bg-[#71AC16] hover:bg-[#7ebd1a] active:scale-[0.98] text-black font-extrabold uppercase tracking-wider text-sm transition-all shadow-lg shadow-[#71AC16]/20 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed select-none\"\n            >\n              {loading ? (\n                <>\n                  <Loader2 className=\"w-5 h-5 animate-spin\" />\n                  <span>Requesting Code...</span>\n                </>\n              ) : (\n                <>\n                  <span>Send Verification Code</span>\n                  <ArrowRight className=\"w-4 h-4 stroke-[3]\" />\n                </>\n              )}\n            </button>\n          </form>\n\n          <div className=\"mt-8 pt-6 border-t border-white/10 text-center\">\n            <Link\n              href=\"/login\"\n              className=\"text-xs text-neutral-400 hover:text-white transition-colors inline-flex items-center gap-2 font-medium\"\n            >\n              <ArrowLeft className=\"w-3.5 h-3.5\" />\n              <span>Return to Sign In</span>\n            </Link>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
