    end_line: 61
    content: "@import url(\'https://api.fontshare.com/v2/css?f[]=satoshi@900,800,700,600,500,400,300&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \'Satoshi\', sans-serif;\n  --font-display: \'Satoshi\', sans-serif;\n  --font-body: \'Satoshi\', sans-serif;\n  --font-heading: \'Satoshi\', sans-serif;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  font-family: \'Satoshi\', sans-serif;\n}\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Satoshi\', sans-serif;\n  }\n\n  body {\n    font-family: \'Satoshi\', sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, button, input, textarea, select, a, p, span, div, label {\n    font-family: \'Satoshi\', sans-serif;\n  }\n}\n\n/* Custom text stroke utilities for the Power Your Potential outline typography */\n.text-stroke-white {\n  -webkit-text-stroke: 2px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-sm {\n  -webkit-text-stroke: 1.25px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-thick {\n  -webkit-text-stroke: 3px rgba(255, 255, 255, 0.98);\n  color: transparent;\n}\n\n.font-tilt {\n  font-family: \'Satoshi\', sans-serif;\n}\n\n/* Glassmorphism subtle backdrop */\n.glass-pill {\n  background: rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.28);\n}\n\n.glass-pill:hover {\n  background: rgba(255, 255, 255, 0.22);\n  border-color: rgba(255, 255, 255, 0.5);\n}\n"
    num_lines: 62
    num_bytes: 1422
  }
}
