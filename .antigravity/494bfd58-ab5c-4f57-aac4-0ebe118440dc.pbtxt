tRegisteredData(data);\n            }}\n          />\n\n          {/* Switch to Login Link */}\n          <div className=\"mt-8 pt-6 border-t border-white/10 text-center\">\n            <p className=\"text-xs text-neutral-400 flex items-center justify-center gap-2\">\n              <span>Already a member?</span>\n              <Link\n                href=\"/login\"\n                className=\"text-[#71AC16] hover:text-[#88d317] font-bold inline-flex items-center gap-1 hover:underline transition-colors\"\n              >\n                <LogIn className=\"w-3.5 h-3.5\" />\n                <span>Sign in here</span>\n              </Link>\n            </p>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
