  view_file {
    absolute_path_uri: "file:///src/app/api/proxy/%5B...path%5D/route.ts"
    end_line: 61
    content: "import { NextRequest, NextResponse } from \"next/server\";\n\nexport async function POST(\n  request: NextRequest,\n  context: { params: Promise<{ path: string[] }> }\n) {\n  try {\n    const { path } = await context.params;\n    const endpoint = (path || []).join(\"/\");\n    const targetUrl = `https://apitest.thewarriors.team/api/${endpoint}`;\n\n    const contentType = request.headers.get(\"content-type\") || \"\";\n    const authHeader = request.headers.get(\"authorization\");\n\n    const forwardHeaders: Record<string, string> = {\n      Accept: \"application/json\",\n    };\n    if (authHeader) {\n      forwardHeaders[\"Authorization\"] = authHeader;\n    }\n\n    let bodyData: any;\n    if (contentType.includes(\"multipart/form-data\") || contentType.includes(\"application/x-www-form-urlencoded\")) {\n      bodyData = await request.formData();\n    } else {\n      // If client sent json or raw\n      try {\n        const formData = await request.formData();\n        bodyData = formData;\n      } catch {\n        // Fallback to text or form data construction\n        bodyData = await request.text();\n      }\n    }\n\n    const response = await fetch(targetUrl, {\n      method: \"POST\",\n      headers: forwardHeaders,\n      body: bodyData,\n      cache: \"no-store\",\n    });\n\n    const responseText = await response.text();\n    let data;\n    try {\n      data = JSON.parse(responseText);\n    } catch {\n      data = { message: responseText };\n    }\n\n    return NextResponse.json(data, { status: response.status });\n  } catch (error: any) {\n    return NextResponse.json(\n      {\n        status: false,\n        message: error?.message || \"An unexpected error occurred while contacting the server.\",\n      },\n      { status: 500 }\n    );\n  }\n}\n"
    num_lines: 62
    num_bytes: 1707
  }
}
