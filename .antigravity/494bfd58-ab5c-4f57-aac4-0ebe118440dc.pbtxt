    content: "          <svg\n            style={{ width: \"1.2cqw\", height: \"1.2cqw\" }}\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            className=\"text-white flex-shrink-0\"\n          >\n            <circle\n              cx=\"10\"\n              cy=\"10\"\n              r=\"6.5\"\n              stroke=\"white\"\n              strokeWidth=\"3.2\"\n            />\n            <line\n              x1=\"15\"\n              y1=\"15\"\n              x2=\"21\"\n              y2=\"21\"\n              stroke=\"white\"\n              strokeWidth=\"3.5\"\n              strokeLinecap=\"round\"\n            />\n          </svg>\n        </div>\n      </div>\n\n      {/* Right Auth Action Container */}\n      <div\n        className=\"flex items-center\"\n        style={{\n          gap: \"0.8cqw\",\n          transform: \"translate(-1cqw, 1.0cqw)\",\n        }}\n      >\n        {isAuthenticated && user ? (\n          /* Authenticated User Menu */\n          <div className=\"relative\">\n            <button\n              type=\"button\"\n              onClick={() => setShowUserMenu(!showUserMenu)}\n              className=\"flex items-center bg-[#151719] hover:bg-neutral-800 border border-[#71AC16]/50 rounded-full text-white shadow-md transition-all cursor-pointer active:scale-95\"\n              style={{\n                padding: \"0.5cqw 1.4cqw 0.5cqw 0.7cqw\",\n                gap: \"0.6cqw\",\n              }}\n            >\n              <div\n                className=\"rounded-full bg-[#71AC16] text-black font-black flex items-center justify-center flex-shrink-0\"\n                style={{\n                  width: \"2.4cqw\",\n                  height: \"2.4cqw\",\n                  fontSize: \"1.0cqw\",\n                }}\n              >\n                {displayName.charAt(0).toUpperCase()}\n              </div>\n              <div className=\"flex flex-col text-left\">\n                <span\n                  className=\"font-bold text-white capitalize leading-tight truncate\"\n                  style={{\n                    fontSize: \"1.1cqw\",\n                    maxWidth: \"8cqw\",\n                  }}\n                >\n                  {displayName}\n                </span>\n                <span\n                  className=\"text-[#71AC16] uppercase font-bold tracking-wider\"\n                  style={{ fontSize: \"0.8cqw\" }}\n                >\n                  {user.role || \"Member\"}\n                </span>\n              </div>\n            </button>\n\n            {/* Dropdown Menu */}\n            {showUserMenu && (\n              <div\n                className=\"absolute right-0 top-full mt-2 w-48 bg-[#151719] border border-white/15 rounded-2xl p-2 shadow-2xl z-50 animate-in fade-in zoom-in-95 duration-150\"\n                onMouseLeave={() => setShowUserMenu(false)}\n              >\n                <div className=\"px-3 py-2 border-b border-white/10\">\n                  <p className=\"text-xs text-neutral-400 font-medium\">Signed in as</p>\n                  <p className=\"text-xs font-bold text-white truncate\">{user.email}</p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setShowUserMenu(false);\n                    logout();\n                  }}\n                  className=\"w-full mt-1.5 flex items-center gap-2 px-3 py-2 text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-xl transition-colors cursor-pointer\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span>Log Out</span>\n                </button>\n              </div>\n            )}\n          </div>\n        ) : (\n          /* Unauthenticated: LOGIN & REGISTER Buttons */\n          <div className=\"flex items-center\" style={{ gap: \"0.6cqw\" }}>\n            <Link\n              href=\"/login\"\n              className=\"bg-transparent hover:bg-white/10 border border-white/40 text-white font-bold tracking-wider rounded-full transition-all uppercase select-none flex items-center justify-center cursor-pointer whitespace-nowrap active:scale-95\"\n              style={{\n                padding: \"0.8cqw 1.8cqw\",\n                fontSize: \"1.2cqw\",\n                letterSpacing: \"0.03em\",\n              }}\n            >\n              LOGIN\n            </Link>\n\n            <Link\n              href=\"/register\"\n              className=\"bg-[#6FA816] hover:bg-[#78B419] active:scale-95 text-white font-extrabold tracking-wider rounded-full transition-all uppercase select-none flex items-center justify-center shadow-md cursor-pointer whitespace-nowrap\"\n              style={{\n                padding: \"0.85cqw 2.2cqw\",\n                fontSize: \"1.25cqw\",\n                letterSpacing: \"0.04em\","
