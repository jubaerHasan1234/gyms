    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport React, { ReactNode } from \"react\";\nimport Link from \"next/link\";\nimport { ArrowLeft, Home } from \"lucide-react\";\nimport { AuthBrandLogo } from \"./AuthBrandLogo\";\nimport { AuthDecorativeBackdrop } from \"./AuthDecorativeBackdrop\";\nimport { AuthSideHero } from \"./AuthSideHero\";\n\ninterface AuthLayoutProps {\n  children: ReactNode;\n  heroHeadline?: string;\n  heroTagline?: string;\n  heroBadge?: string;\n  reverseColumns?: boolean;\n}\n\nexport const AuthLayout: React.FC<AuthLayoutProps> = ({\n  children,\n  heroHeadline,\n  heroTagline,\n  heroBadge,\n  reverseColumns = false,\n}) => {\n  return (\n    <div className=\"min-h-screen relative bg-[#0E1012] text-white flex flex-col justify-between overflow-x-hidden selection:bg-[#71AC16] selection:text-white\">\n      {/* Decorative droplet & lighting backdrop */}\n      <AuthDecorativeBackdrop />\n\n      {/* Main Container */}\n      <div className=\"relative z-10 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex flex-col min-h-screen justify-between\">\n        {/* Top Header Navigation */}\n        <header className=\"flex items-center justify-between pb-6 border-b border-white/10\">\n          <AuthBrandLogo />\n\n          <div className=\"flex items-center gap-3\">\n            <Link\n              href=\"/\"\n              className=\"inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-neutral-300 hover:text-white bg-white/5 hover:bg-white/10 px-4 py-2 rounded-full border border-white/10 transition-all select-none active:scale-95\"\n            >\n              <ArrowLeft className=\"w-4 h-4 text-[#71AC16]\" />\n              <span className=\"hidden sm:inline\">Back to</span> Home\n            </Link>\n          </div>\n        </header>\n\n        {/* Content Body Grid */}\n        <main className=\"flex-1 py-8 sm:py-12 flex items-center justify-center\">\n          <div className=\"w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\">\n            {/* Form Column */}\n            <div\n              className={`w-full max-w-xl mx-auto lg:max-w-none ${\n                reverseColumns ? \"lg:col-span-6 lg:order-2\" : \"lg:col-span-6\"\n              }`}\n            >\n              {children}\n            </div>\n\n            {/* Visual Hero Showcase Column (Desktop / Tablet) */}\n            <div\n              className={`hidden lg:block ${\n                reverseColumns ? \"lg:col-span-6 lg:order-1\" : \"lg:col-span-6\"\n              } h-full`}\n            >\n              <AuthSideHero\n                headline={heroHeadline}\n                tagline={heroTagline}\n                badge={heroBadge}\n              />\n            </div>\n          </div>\n        </main>\n\n        {/* Bottom Footer */}\n        <footer className=\"pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400 select-none\">\n          <p>\302\251 2026 Kratos Fitness Club. All rights reserved.</p>\n          <div className=\"flex items-center gap-6\">\n            <Link href=\"/\" className=\"hover:text-white transition-colors\">\n              Home\n            </Link>\n            <Link href=\"/#training\" className=\"hover:text-white transition-colors\">\n              Gym Locations\n            </Link>\n            <Link href=\"/#products\" className=\"hover:text-white transition-colors\">\n              Products\n            </Link>\n            <span className=\"text-white/20\">|</span>\n            <span className=\"text-neutral-500\">API Test Environment</span>\n          </div>\n        </footer>\n      </div>\n    </div>\n  );\n};\n"
