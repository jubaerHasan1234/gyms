      arguments_json: "{\"Content\":\"\\\"use client\\\";\\n\\nimport React, { useState } from \\\"react\\\";\\nimport { Check, Copy, Sparkles, ShieldCheck } from \\\"lucide-react\\\";\\n\\ninterface OtpNotificationBannerProps {\\n  otp: string;\\n  email?: string;\\n  sourceText?: string;\\n  onAutoFill?: (otp: string) => void;\\n  className?: string;\\n}\\n\\nexport const OtpNotificationBanner: React.FC<OtpNotificationBannerProps> = ({\\n  otp,\\n  email,\\n  sourceText = \\\"Server Response OTP\\\",\\n  onAutoFill,\\n  className = \\\"\\\",\\n}) => {\\n  const [copied, setCopied] = useState(false);\\n\\n  if (!otp) return null;\\n\\n  const handleCopy = () => {\\n    navigator.clipboard.writeText(otp);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 2000);\\n  };\\n\\n  return (\\n    <div\\n      className={`relative overflow-hidden rounded-2xl bg-[#71AC16]/10 border-2 border-[#71AC16]/60 p-4 shadow-sm ${className}`}\\n    >\\n      <div className=\\\"flex items-start gap-3.5 relative z-10\\\">\\n        <div className=\\\"w-10 h-10 rounded-xl bg-[#71AC16] text-white flex items-center justify-center flex-shrink-0 shadow-sm\\\">\\n          <ShieldCheck className=\\\"w-5 h-5 font-bold\\\" />\\n        </div>\\n\\n        <div className=\\\"flex-1 min-w-0\\\">\\n          <div className=\\\"flex items-center gap-2 flex-wrap\\\">\\n            <span className=\\\"text-[11px] font-black uppercase tracking-wider text-[#48720b] bg-[#71AC16]/20 px-2 py-0.5 rounded-full flex items-center gap-1\\\">\\n              <Sparkles className=\\\"w-3 h-3 text-[#71AC16]\\\" /> {sourceText}\\n            </span>\\n            {email && (\\n              <span className=\\\"text-[11px] text-neutral-600 truncate max-w-[200px]\\\">\\n                for {email}\\n              </span>\\n            )}\\n          </div>\\n\\n          <p className=\\\"text-xs text-neutral-700 mt-1 font-medium\\\">\\n            Verification code provided by the API response:\\n          </p>\\n\\n          <div className=\\\"mt-2.5 flex items-center gap-3 flex-wrap\\\">\\n            <div className=\\\"bg-white border-2 border-[#71AC16] px-3.5 py-1.5 rounded-lg flex items-center gap-2 shadow-sm\\\">\\n              <span className=\\\"font-mono text-xl font-black text-neutral-900 tracking-[0.25em]\\\">\\n                {otp}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              {onAutoFill && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onAutoFill(otp)}\\n                  className=\\\"px-3.5 py-1.5 text-xs font-bold bg-[#71AC16] hover:bg-[#639912] active:scale-95 text-white rounded-lg transition-all shadow-sm flex items-center gap-1.5 cursor-pointer\\\"\\n                >\\n                  <Sparkles className=\\\"w-3.5 h-3.5\\\" />\\n                  Auto-fill Code\\n                </button>\\n              )}\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleCopy}\\n                className=\\\"px-3 py-1.5 text-xs font-semibold bg-white hover:bg-neutral-100 active:scale-95 text-neutral-700 rounded-lg transition-all border border-neutral-300 flex items-center gap-1.5 cursor-pointer\\\"\\n              >\\n                {copied ? (\\n                  <>\\n                    <Check className=\\\"w-3.5 h-3.5 text-[#71AC16]\\\" />\\n                    <span>Copied!</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <Copy className=\\\"w-3.5 h-3.5 text-neutral-500\\\" />\\n                    <span>Copy</span>\\n                  </>\\n                )}\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/auth/common/OtpNotificationBanner.tsx\", \"toolAction\":\"Updating OtpNotificationBanner for light theme\", \"toolSummary\":\"Update OtpNotificationBanner.tsx\"}"
