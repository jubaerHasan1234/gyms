    content: "import React, { Suspense } from \"react\";\nimport type { Metadata } from \"next\";\nimport { AuthLayout } from \"@/components/auth/common/AuthLayout\";\nimport { LoginCard } from \"@/components/auth/login/LoginCard\";\nimport { Loader2 } from \"lucide-react\";\n\nexport const metadata: Metadata = {\n  title: \"Member Sign In | Kratos Fitness\",\n  description:\n    \"Log in to your Kratos Fitness account to access your customized high-performance workouts, gym schedule, and club privileges.\",\n};\n\nfunction LoadingFallback() {\n  return (\n    <div className=\"w-full bg-[#121417]/90 rounded-3xl p-12 flex flex-col items-center justify-center text-neutral-400 min-h-[400px]\">\n      <Loader2 className=\"w-8 h-8 text-[#71AC16] animate-spin mb-3\" />\n      <p className=\"text-sm\">Loading member portal...</p>\n    </div>\n  );\n}\n\nexport default function LoginPage() {\n  return (\n    <AuthLayout\n      heroHeadline=\"POWER YOUR POTENTIAL\"\n      heroTagline=\"Step back into the arena. Continue your championship progress with tailored coaching, workout logs, and club amenities.\"\n      heroBadge=\"KRATOS MEMBER ACCESS\"\n    >\n      <Suspense fallback={<LoadingFallback />}>\n        <LoginCard />\n      </Suspense>\n    </AuthLayout>\n  );\n}\n"
    num_lines: 35
    num_bytes: 1209
  }
