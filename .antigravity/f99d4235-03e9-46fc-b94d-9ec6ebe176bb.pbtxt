    end_line: 227
    content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Search, MapPin, X } from \'lucide-react\';\nimport { BrandLogoIcon } from \'./SpecialtyIcons\';\n\ninterface HeaderNavProps {\n  onOpenLocations: () => void;\n  onOpenRegi: () => void;\n  onSelectSpecialty: (title: string) => void;\n  onOpenShop: () => void;\n}\n\nconst searchableItems = [\n  { title: \'Ground running\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Yoga Assistance\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Personal Trainer\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Downtown Flagship Gym\', type: \'Location\', target: \'location\' },\n  { title: \'Performance Gear & Apparel\', type: \'Shop\', target: \'shop\' },\n  { title: \'7-Day Free Pass\', type: \'Membership\', target: \'regi\' },\n  { title: \'Powerlifting Lever Belt\', type: \'Gear\', target: \'shop\' },\n  { title: \'Creapure Monohydrate\', type: \'Supplements\', target: \'shop\' },\n];\n\nexport const HeaderNav: React.FC<HeaderNavProps> = ({\n  onOpenLocations,\n  onOpenRegi,\n  onSelectSpecialty,\n  onOpenShop,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [searchOpen, setSearchOpen] = useState(false);\n  const [mobileSearchActive, setMobileSearchActive] = useState(false);\n  const searchContainerRef = useRef<HTMLDivElement>(null);\n\n  const filteredResults = searchQuery.trim()\n    ? searchableItems.filter((item) =>\n        item.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        item.type.toLowerCase().includes(searchQuery.toLowerCase())\n      )\n    : [];\n\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (\n        searchContainerRef.current &&\n        !searchContainerRef.current.contains(e.target as Node)\n      ) {\n        setSearchOpen(false);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleResultClick = (item: (typeof searchableItems)[0]) => {\n    setSearchQuery(\'\');\n    setSearchOpen(false);\n    setMobileSearchActive(false);\n\n    if (item.target === \'specialty\') {\n      onSelectSpecialty(item.title);\n    } else if (item.target === \'location\') {\n      onOpenLocations();\n    } else if (item.target === \'shop\') {\n      onOpenShop();\n    } else if (item.target === \'regi\') {\n      onOpenRegi();\n    }\n  };\n\n  return (\n    <header className=\"relative z-30 w-full flex items-center justify-between gap-2 sm:gap-4 select-none\">\n      {/* 1. Left Brand Icon Button */}\n      <button\n        type=\"button\"\n        onClick={() => {\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\n        }}\n        className=\"flex items-center justify-center w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-[#71AC16] text-white shadow-md hover:scale-105 active:scale-95 transition-all shrink-0 cursor-pointer\"\n        aria-label=\"Kratos Fitness Home\"\n        title=\"Kratos Fitness\"\n      >\n        <BrandLogoIcon className=\"w-6 h-6 sm:w-7 sm:h-7\" />\n      </button>\n\n      {/* 2. Center Pill Navbar (Desktop & Tablet) */}\n      <nav className=\"hidden md:flex items-center gap-4 lg:gap-6 bg-[#0c0d10]/95 border border-white/20 rounded-full px-5 py-2.5 text-white shadow-xl backdrop-blur-md\">\n        <a\n          href=\"#home\"\n          className=\"text-xs lg:text-sm font-semibold text-white/90 hover:text-white transition-colors cursor-pointer\"\n        >\n          Home\n        </a>\n\n        <button\n          type=\"button\"\n          onClick={onOpenLocations}\n          className=\"text-xs lg:text-sm font-semibold text-white/90 hover:text-[#71AC16] transition-colors flex items-center gap-1.5 cursor-pointer\"\n        >\n          <MapPin className=\"w-3.5 h-3.5 text-[#71AC16]\" />\n          Our gym location\n        </button>\n\n        <span className=\"text-white/40 font-light\" aria-hidden=\"true\">\n          |\n        </span>\n\n        {/* Search Bar Inside Pill */}\n        <div ref={searchContainerRef} className=\"relative\">\n          <div className=\"flex items-center gap-2 bg-white/10 hover:bg-white/15 focus-within:bg-white/20 focus-within:ring-1 focus-within:ring-[#71AC16] rounded-full px-3.5 py-1.5 transition-all\">\n            <input\n              type=\"search\"\n              value={searchQuery}\n              onChange={(e) => {\n                setSearchQuery(e.target.value);\n                setSearchOpen(true);\n              }}\n              onFocus={() => setSearchOpen(true)}\n              className=\"bg-transparent outline-none placeholder:text-white/60 text-xs lg:text-sm text-white w-24 md:w-36 lg:w-44\"\n              placeholder=\"Search\"\n            />\n            {searchQuery ? (\n              <button\n                type=\"button\"\n                onClick={() => setSearchQuery(\'\')}\n                className=\"text-white/70 hover:text-white p-0.5\"\n              >\n                <X className=\"w-3.5 h-3.5\" />\n              </button>\n            ) : (\n              <Search className=\"w-3.5 h-3.5 text-white/90\" />\n            )}\n          </div>\n\n          {/* Quick Search Dropdown */}\n          {searchOpen && filteredResults.length > 0 && (\n            <div className=\"absolute top-full left-0 mt-2 w-64 bg-[#14171c] border border-white/20 rounded-2xl shadow-2xl overflow-hidden py-1 z-50 animate-fadeIn\">\n              <div className=\"px-3 py-1.5 text-[10px] uppercase font-bold text-neutral-400 border-b border-white/10\">\n                Quick Results\n              </div>\n              {filteredResults.map((item, idx) => (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => handleResultClick(item)}\n                  className=\"w-full text-left px-3 py-2 text-xs flex items-center justify-between hover:bg-white/10 transition-colors\"\n                >\n                  <span className=\"text-white font-medium truncate\">{item.title}</span>\n                  <span className=\"text-[10px] text-[#71AC16] uppercase font-bold shrink-0 ml-2\">\n                    {item.type}\n                  </span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </nav>\n\n      {/* 2b. Mobile Action Pill (Search + Location triggers for small screens) */}\n      <div className=\"flex md:hidden items-center gap-2\">\n        <button\n          type=\"button\"\n          onClick={() => setMobileSearchActive(!mobileSearchActive)}\n          className=\"flex items-center gap-1.5 bg-[#0c0d10]/95 border border-white/20 rounded-full px-3.5 py-2 text-white text-xs font-semibold\"\n          aria-label=\"Search\"\n        >\n          <Search className=\"w-3.5 h-3.5 text-[#71AC16]\" />\n          <span className=\"hidden sm:inline\">Search</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={onOpenLocations}\n          className=\"flex items-center gap-1.5 bg-[#0c0d10]/95 border border-white/20 rounded-full px-3 py-2 text-white text-xs\"\n          title=\"Locations\"\n        >\n          <MapPin className=\"w-3.5 h-3.5 text-[#71AC16]\" />\n        </button>\n      </div>\n\n      {/* 3. Right Action Button (\"REGI\") */}\n      <button\n        type=\"button\"\n        onClick={onOpenRegi}\n        className=\"bg-[#71AC16] hover:bg-[#629712] active:scale-95 text-white font-extrabold tracking-wider px-6 sm:px-9 py-2.5 sm:py-3 rounded-full shadow-lg shadow-[#71AC16]/20 transition-all uppercase text-xs sm:text-sm cursor-pointer shrink-0\"\n      >\n        REGI\n      </button>\n\n      {/* Mobile Search Overlay Bar */}\n      {mobileSearchActive && (\n        <div className=\"absolute top-14 left-0 right-0 p-2 bg-[#12151a] border border-white/20 rounded-2xl shadow-2xl flex flex-col gap-2 md:hidden z-50\">\n          <div className=\"flex items-center gap-2 px-3 py-1.5 bg-white/10 rounded-xl\">\n            <Search className=\"w-4 h-4 text-[#71AC16] shrink-0\" />\n            <input\n              type=\"search\"\n              autoFocus\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search classes, locations, trainers...\"\n              className=\"w-full bg-transparent text-white text-xs outline-none\"\n            />\n            <button\n              onClick={() => setMobileSearchActive(false)}\n              className=\"text-neutral-400 hover:text-white p-1\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n          {filteredResults.length > 0 && (\n            <div className=\"flex flex-col gap-1 max-h-48 overflow-y-auto\">\n              {filteredResults.map((item, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => handleResultClick(item)}\n                  className=\"px-3 py-2 text-left text-xs text-white hover:bg-white/10 rounded-lg flex items-center justify-between\"\n                >\n                  <span>{item.title}</span>\n                  <span className=\"text-[10px] text-[#71AC16] font-bold\">{item.type}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n    </header>\n  );\n};\n"
    raw_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Search, MapPin, X } from \'lucide-react\';\nimport { BrandLogoIcon } from \'./SpecialtyIcons\';\n\ninterface HeaderNavProps {\n  onOpenLocations: () => void;\n  onOpenRegi: () => void;\n  onSelectSpecialty: (title: string) => void;\n  onOpenShop: () => void;\n}\n\nconst searchableItems = [\n  { title: \'Ground running\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Yoga Assistance\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Personal Trainer\', type: \'Specialty\', target: \'specialty\' },\n  { title: \'Downtown Flagship Gym\', type: \'Location\', target: \'location\' },\n  { title: \'Performance Gear & Apparel\', type: \'Shop\', target: \'shop\' },\n  { title: \'7-Day Free Pass\', type: \'Membership\', target: \'regi\' },\n  { title: \'Powerlifting Lever Belt\', type: \'Gear\', target: \'shop\' },\n  { title: \'Creapure Monohydrate\', type: \'Supplements\', target: \'shop\' },\n];\n\nexport const HeaderNav: React.FC<HeaderNavProps> = ({\n  onOpenLocations,\n  onOpenRegi,\n  onSelectSpecialty,\n  onOpenShop,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [searchOpen, setSearchOpen] = useState(false);\n  const [mobileSearchActive, setMobileSearchActive] = useState(false);\n  const searchContainerRef = useRef<HTMLDivElement>(null);\n\n  const filteredResults = searchQuery.trim()\n    ? searchableItems.filter((item) =>\n        item.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        item.type.toLowerCase().includes(searchQuery.toLowerCase())\n      )\n    : [];\n\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (\n        searchContainerRef.current &&\n        !searchContainerRef.current.contains(e.target as Node)\n      ) {\n        setSearchOpen(false);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleResultClick = (item: (typeof searchableItems)[0]) => {\n    setSearchQuery(\'\');\n    setSearchOpen(false);\n    setMobileSearchActive(false);\n\n    if (item.target === \'specialty\') {\n      onSelectSpecialty(item.title);\n    } else if (item.target === \'location\') {\n      onOpenLocations();\n    } else if (item.target === \'shop\') {\n      onOpenShop();\n    } else if (item.target === \'regi\') {\n      onOpenRegi();\n    }\n  };\n\n  return (\n    <header className=\"relative z-30 w-full flex items-center justify-between gap-2 sm:gap-4 select-none\">\n      {/* 1. Left Brand Icon Button */}\n      <button\n        type=\"button\"\n        onClick={() => {\n          window.scrollTo({ top: 0, behavior: \'smooth\' });\n        }}\n        className=\"flex items-center justify-center w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-[#71AC16] text-white shadow-md hover:scale-105 active:scale-95 transition-all shrink-0 cursor-pointer\"\n        aria-label=\"Kratos Fitness Home\"\n        title=\"Kratos Fitness\"\n      >\n        <BrandLogoIcon className=\"w-6 h-6 sm:w-7 sm:h-7\" />\n      </button>\n\n      {/* 2. Center Pill Navbar (Desktop & Tablet) */}\n      <nav className=\"hidden md:flex items-center gap-4 lg:gap-6 bg-[#0c0d10]/95 border border-white/20 rounded-full px-5 py-2.5 text-white shadow-xl backdrop-blur-md\">\n        <a\n          href=\"#home\"\n          className=\"text-xs lg:text-sm font-semibold text-white/90 hover:text-white transition-colors cursor-pointer\"\n        >\n          Home\n        </a>\n\n        <button\n          type=\"button\"\n          onClick={onOpenLocations}\n          className=\"text-xs lg:text-sm font-semibold text-white/90 hover:text-[#71AC16] transition-colors flex items-center gap-1.5 cursor-pointer\"\n        >\n          <MapPin className=\"w-3.5 h-3.5 text-[#71AC16]\" />\n          Our gym location\n        </button>\n\n        <span className=\"text-white/40 font-light\" aria-hidden=\"true\">\n          |\n        </span>\n\n        {/* Search Bar Inside Pill */}\n        <div ref={searchContainerRef} className=\"relative\">\n          <div className=\"flex items-center gap-2 bg-white/10 hover:bg-white/15 focus-within:bg-white/20 focus-within:ring-1 focus-within:ring-[#71AC16] rounded-full px-3.5 py-1.5 transition-all\">\n            <input\n              type=\"search\"\n              value={searchQuery}\n              onChange={(e) => {\n                setSearchQuery(e.target.value);\n                setSearchOpen(true);\n              }}\n              onFocus={() => setSearchOpen(true)}\n              className=\"bg-transparent outline-none placeholder:text-white/60 text-xs lg:text-sm text-white w-24 md:w-36 lg:w-44\"\n              placeholder=\"Search\"\n            />\n            {searchQuery ? (\n              <button\n                type=\"button\"\n                onClick={() => setSearchQuery(\'\')}\n                className=\"text-white/70 hover:text-white p-0.5\"\n              >\n                <X className=\"w-3.5 h-3.5\" />\n              </button>\n            ) : (\n              <Search className=\"w-3.5 h-3.5 text-white/90\" />\n            )}\n          </div>\n\n          {/* Quick Search Dropdown */}\n          {searchOpen && filteredResults.length > 0 && (\n            <div className=\"absolute top-full left-0 mt-2 w-64 bg-[#14171c] border border-white/20 rounded-2xl shadow-2xl overflow-hidden py-1 z-50 animate-fadeIn\">\n              <div className=\"px-3 py-1.5 text-[10px] uppercase font-bold text-neutral-400 border-b border-white/10\">\n                Quick Results\n              </div>\n              {filteredResults.map((item, idx) => (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => handleResultClick(item)}\n                  className=\"w-full text-left px-3 py-2 text-xs flex items-cen