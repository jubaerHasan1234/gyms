    start_line: 54
    end_line: 90
    content: "          <TrainLikeChampionSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* What Our Clients Are Saying Testimonials Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <ClientsSayingSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Subscribe to our Newsletter Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <NewsletterSection forcedViewport={viewportMode} />\n        </div>\n\n\n        {/* Quiet Brand Footer */}\n        <footer className=\"mt-4 pt-6 border-t border-slate-300/70 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-bold text-slate-800\">KRATOS FITNESS</span>\n            <span>\302\267</span>\n            <span>Power Your Potential</span>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <span className=\"text-slate-600\">Locations</span>\n            <span>\302\267</span>\n            <span className=\"text-slate-600\">Official Store</span>\n            <span>\302\267</span>\n            <span className=\"text-slate-600\">Free Trial Pass</span>\n          </div>\n          <div className=\"text-[11px] text-slate-400\">\n            \302\251 {new Date().getFullYear()} Kratos Athletic Club. All rights reserved.\n          </div>\n        </footer>\n      </main>\n    </div>\n  );\n}\n"
    raw_content: "import React, { useState } from \'react\';\nimport HeroSection from \'./components/HeroSection\';\nimport { ProductDropletsOverlay } from \'./components/ProductDropletsOverlay\';\nimport { OurProductsSection } from \'./components/OurProductsSection\';\nimport { TrainLikeChampionSection } from \'./components/TrainLikeChampionSection\';\nimport { ClientsSayingSection } from \'./components/ClientsSayingSection\';\nimport { NewsletterSection } from \'./components/NewsletterSection\';\nimport { ViewportSwitcher, ViewportMode } from \'./components/ViewportSwitcher\';\n\nexport default function App() {\n  const [viewportMode, setViewportMode] = useState<ViewportMode>(\'responsive\');\n\n  const getContainerWidthClass = () => {\n    switch (viewportMode) {\n      case \'desktop\':\n        return \'max-w-[1440px] shadow-2xl rounded-[32px] my-6 p-4 sm:p-6 lg:p-8 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'tablet\':\n        return \'max-w-[820px] shadow-2xl rounded-[28px] my-6 p-4 sm:p-6 bg-[#ffffff] ring-1 ring-black/10\';\n      case \'mobile\':\n        return \'max-w-[390px] shadow-2xl rounded-[24px] my-6 p-3 sm:p-4 bg-[#ffffff] ring-1 ring-black/10\';\n      default:\n        return \'w-full max-w-[1480px] p-3 sm:p-6 lg:p-8\';\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#ffffff] flex flex-col items-center\">\n      {/* 1. Device Viewport Simulator Bar for responsive verification */}\n      <ViewportSwitcher\n        currentMode={viewportMode}\n        onModeChange={(mode) => setViewportMode(mode)}\n      />\n\n      {/* 2. Main Canvas Container */}\n      <main\n        className={`w-full transition-all duration-300 mx-auto flex flex-col ${getContainerWidthClass()}`}\n      >\n        {/* Responsive Hero Section - seamless with website background, no shadow, no rounded card border */}\n        <div className=\"w-full overflow-hidden bg-white\">\n          <HeroSection />\n        </div>\n\n        {/* ProductDropletsOverlay component in App.tsx directly above Our Products Section */}\n        <div className=\"w-full relative bg-white select-none pointer-events-none\">\n          <ProductDropletsOverlay />\n        </div>\n\n        {/* Our Products Section directly joined together with zero gap */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <OurProductsSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Train Like a Champion (Expert Boxing Training) Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <TrainLikeChampionSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* What Our Clients Are Saying Testimonials Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <ClientsSayingSection forcedViewport={viewportMode} />\n        </div>\n\n        {/* Subscribe to our Newsletter Section */}\n        <div className=\"w-full bg-white m-0 p-0\">\n          <NewsletterSection forcedViewport={viewportMode} />\n        </div>\n\n\n        {/* Quiet Brand Footer */}\n        <footer className=\"mt-4 pt-6 border-t border-slate-300/70 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-bold text-slate-800\">KRATOS FITNESS</span>\n            <span>\302\267</span>\n            <span>Power Your Potential</span>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <span className=\"text-slate-600\">Locations</span>\n            <span>\302\267</span>\n            <span className=\"text-slate-600\">Official Store</span>\n            <span>\302\267</span>\n            <span className=\"text-slate-600\">Free Trial Pass</span>\n          </div>\n          <div className=\"text-[11px] text-slate-400\">\n            \302\251 {new Date().getFullYear()} Kratos Athletic Club. All rights reserved.\n          </div>\n        </footer>\n      </main>\n    </div>\n  );\n}\n"
    num_lines: 91
    num_bytes: 3826
  }
}
