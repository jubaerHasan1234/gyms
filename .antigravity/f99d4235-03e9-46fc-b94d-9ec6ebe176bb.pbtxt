    content: "        return \"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-8 md:gap-10 lg:gap-10 xl:gap-12\";\n    }\n  };\n\n  return (\n    <footer\n      className={`w-full bg-white text-neutral-900 select-text transition-all duration-200 ${className}`}\n      aria-label=\"Site Footer\"\n    >\n      {/* \n        1. TOP HORIZONTAL DIVIDER LINE\n        Exact clean hairline border matching the screenshot across the full container width\n      */}\n      <div className=\"w-full border-t border-neutral-300/80 mb-8 sm:mb-10 lg:mb-12\" />\n\n      <div className=\"w-full px-4 sm:px-6 md:px-8 lg:px-10 max-w-[1400px] mx-auto\">\n        {/* \n          2. MAIN 4-COLUMN FOOTER CONTENT\n          Matches screenshot:\n          [About]  [Quick Links]  [Our Service]  [Contact Info]\n        */}\n        <div className={getGridClasses()}>\n          {/* ========================================================\n              COLUMN 1: ABOUT\n              - Heading: About\n              - Paragraph: \"At MuscleForge, we believe in the power of dedication and hard work...\"\n              - Divider line\n              - \"Social Media: Fb In Tw\"\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">"
    raw_content: "import React, { useState } from \"react\";\nimport { ViewportMode } from \"./ViewportSwitcher\";\nimport {\n  Mail,\n  Phone,\n  MapPin,\n  Clock,\n  Copy,\n  Check,\n  ArrowUp,\n  X,\n  ExternalLink,\n  ShieldCheck,\n  Dumbbell,\n  Send,\n} from \"lucide-react\";\n\nexport interface FooterSectionProps {\n  forcedViewport?: ViewportMode;\n  className?: string;\n}\n\ninterface ServiceModalData {\n  title: string;\n  category: string;\n  description: string;\n  features: string[];\n  timing: string;\n  coach: string;\n}\n\nconst serviceDetails: Record<string, ServiceModalData> = {\n  \"Indoor gym\": {\n    title: \"Indoor Gymnasium & Heavy Strength Arena\",\n    category: \"Strength & Conditioning\",\n    description:\n      \"A climate-controlled training facility featuring Olympic lifting platforms, Eleiko calibrated plates, hammer strength plate-loaded machines, and dedicated hypertrophy zones designed for serious athletes.\",\n    features: [\n      \"Custom Rogue & Eleiko competition racks\",\n      \"Dumbbells spanning 5 lbs up to 150 lbs\",\n      \"Specialty bars: Safety Squat, Swiss, Trap, and Axle\",\n      \"Purified airflow & dedicated mobility area\",\n    ],\n    timing: \"5:00 AM \342\200\223 11:00 PM Daily\",\n    coach: \"Coach Marcus Vance (CSCS, USAW)\",\n  },\n  \"Outdoor gym\": {\n    title: \"Outdoor Performance Rig & Turf Arena\",\n    category: \"Functional Athleticism\",\n    description:\n      \"Open-air conditioning rig featuring sprint lanes, heavy sleds, farmer walk carries, climbing ropes, and strongman equipment for functional raw power under the open sky.\",\n    features: [\n      \"60-meter high-density sprint sled track\",\n      \"Atlas stones ranging 100 lbs to 300 lbs\",\n      \"Heavy battle ropes & suspension trainers\",\n      \"Weather-sealed outdoor pull-up rigs\",\n    ],\n    timing: \"6:00 AM \342\200\223 8:00 PM (Weather Permitting)\",\n    coach: \"Coach Elena Rostova (Track & Conditioning)\",\n  },\n  \"On ground gym\": {\n    title: \"On-Ground Combat & Functional Floor\",\n    category: \"Combat & Agility\",\n    description:\n      \"Shock-absorbing high-density matted ground surface tailored for calisthenics, grappling, boxing footwork, plyometrics, and mobility flows.\",\n    features: [\n      \"Heavy leather punching bags (100\342\200\223150 lbs)\",\n      \"High-density martial arts subfloor mats\",\n      \"Plyometric soft jump boxes & agility ladders\",\n      \"Kettlebell racks from 8kg to 48kg\",\n    ],\n    timing: \"5:00 AM \342\200\223 10:00 PM Daily\",\n    coach: \"Coach Tariq Brooks (Former Golden Gloves Champion)\",\n  },\n  \"Yoga class\": {\n    title: \"Restorative & Dynamic Athletic Yoga\",\n    category: \"Mobility & Recovery\",\n    description:\n      \"Specialized mobility sessions engineered for weightlifters and combat athletes to enhance hip, spine, and shoulder mobility, relieve fascia tension, and accelerate muscular recovery.\",\n    features: [\n      \"Hot Vinyasa and Yin recovery styles\",\n      \"Cork yoga blocks, straps & bolsters provided\",\n      \"Breathwork & nervous system down-regulation\",\n      \"Custom recovery mobility protocols\",\n    ],\n    timing: \"Morning: 6:30 AM \302\267 Evening: 6:30 PM\",\n    coach: \"Aria Chen (E-RYT 500 & Sports Physio)\",\n  },\n};\n\nexport const FooterSection: React.FC<FooterSectionProps> = ({\n  forcedViewport = \"responsive\",\n  className = \"\",\n}) => {\n  // State for modals & interactive handlers\n  const [activeModal, setActiveModal] = useState<\n    \"none\" | \"contact\" | \"privacy\" | \"location\" | \"service\"\n  >(\"none\");\n  const [selectedService, setSelectedService] = useState<ServiceModalData | null>(\n    null\n  );\n  const [copiedMail, setCopiedMail] = useState(false);\n  const [socialFeedback, setSocialFeedback] = useState<string | null>(null);\n\n  // Contact modal form state\n  const [contactForm, setContactForm] = useState({\n    name: \"\",\n    email: \"\",\n    message: \"\",\n  });\n  const [contactSent, setContactSent] = useState(false);\n\n  // Email copy handler\n  const handleCopyEmail = (e?: React.MouseEvent) => {\n    if (e) e.stopPropagation();\n    navigator.clipboard?.writeText(\"info@example.com\");\n    setCopiedMail(true);\n    setTimeout(() => setCopiedMail(false), 2200);\n  };\n\n  // Social click feedback\n  const handleSocialClick = (platformName: string, short: string) => {\n    setSocialFeedback(`${platformName} (${short})`);\n    setTimeout(() => setSocialFeedback(null), 2500);\n  };\n\n  // Scroll to top\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \"smooth\" });\n  };\n\n  // Service click handler\n  const handleOpenService = (serviceKey: string) => {\n    const detail = serviceDetails[serviceKey];\n    if (detail) {\n      setSelectedService(detail);\n      setActiveModal(\"service\");\n    }\n  };\n\n  // Contact form submission\n  const handleSendContact = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!contactForm.name || !contactForm.email) return;\n    setContactSent(true);\n    setTimeout(() => {\n      setContactSent(false);\n      setContactForm({ name: \"\", email: \"\", message: \"\" });\n      setActiveModal(\"none\");\n    }, 2000);\n  };\n\n  // Responsive grid styling helper based on forcedViewport or responsive CSS\n  const getGridClasses = () => {\n    switch (forcedViewport) {\n      case \"mobile\":\n        return \"grid grid-cols-1 gap-8\";\n      case \"tablet\":\n        return \"grid grid-cols-2 gap-8 md:gap-10\";\n      case \"desktop\":\n        return \"grid grid-cols-4 gap-8 lg:gap-10 xl:gap-12\";\n      default:\n        // Fluid responsive classes for all screen sizes:\n        // mobile: 1 column, tablet (sm/md): 2 columns, desktop (lg): 4 columns\n        return \"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-8 md:gap-10 lg:gap-10 xl:gap-12\";\n    }\n  };\n\n  return (\n    <footer\n      className={`w-full bg-white text-neutral-900 select-text transition-all duration-200 ${className}`}\n      aria-label=\"Site Footer\"\n    >\n      {/* \n        1. TOP HORIZONTAL DIVIDER LINE\n        Exact clean hairline border matching the screenshot across the full container width\n      */}\n      <div className=\"w-full border-t border-neutral-300/80 mb-8 sm:mb-10 lg:mb-12\" />\n\n      <div className=\"w-full px-4 sm:px-6 md:px-8 lg:px-10 max-w-[1400px] mx-auto\">\n        {/* \n          2. MAIN 4-COLUMN FOOTER CONTENT\n          Matches screenshot:\n          [About]  [Quick Links]  [Our Service]  [Contact Info]\n        */}\n        <div className={getGridClasses()}>\n          {/* ========================================================\n              COLUMN 1: ABOUT\n              - Heading: About\n              - Paragraph: \"At MuscleForge, we believe in the power of dedication and hard work...\"\n              - Divider line\n              - \"Social Media: Fb In Tw\"\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              About\n            </h3>\n\n            <p className=\"text-xs sm:text-[13px] md:text-sm text-neutral-600 leading-relaxed max-w-sm mb-4\">\n              At MuscleForge, we believe in the power of dedication and hard\n              work. Our mission is to provide you with the tools, resources, and\n              community you need to build the body of your dreams\n            </p>\n\n            {/* Subtle Divider under About paragraph matching the screenshot */}\n            <div className=\"w-36 sm:w-44 border-t border-neutral-300 my-2 sm:my-3\" />\n\n            {/* Social Media Line matching screenshot \"Social Media: Fb In Tw\" */}\n            <div className=\"mt-2 flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs sm:text-sm\">\n              <span className=\"font-semibold text-neutral-900 select-none\">\n                Social Media:\n              </span>\n\n              <div className=\"inline-flex items-center gap-2\">\n                {/* Facebook: Fb */}\n                <button\n                  type=\"button\"\n                  onClick={() => handleSocialClick(\"Facebook\", \"Fb\")}\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1.5 py-0.5 rounded transition-all hover:bg-neutral-100 active:scale-95 cursor-pointer\"\n                  title=\"Follow us on Facebook\"\n                  aria-label=\"Facebook\"\n                >\n                  Fb\n                </button>\n\n                {/* Instagram / LinkedIn: In */}\n                <button\n                  type=\"button\"\n                  onClick={() => handleSocialClick(\"Instagram\", \"In\")}\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1.5 py-0.5 rounded transition-all hover:bg-neutral-100 active:scale-95 cursor-pointer\"\n                  title=\"Follow us on Instagram & LinkedIn\"\n                  aria-label=\"Instagram\"\n                >\n                  In\n                </button>\n\n                {/* Twitter / X: Tw */}\n                <button\n                  type=\"button\"\n                  onClick={() => handleSocialClick(\"Twitter (X)\", \"Tw\")}\n                  className=\"font-bold text-neutral-900 hover:text-[#71AC16] px-1.5 py-0.5 rounded transition-all hover:bg-neutral-100 active:scale-95 cursor-pointer\"\n                  title=\"Follow us on Twitter / X\"\n                  aria-label=\"Twitter\"\n                >\n                  Tw\n                </button>\n              </div>\n            </div>\n\n            {/* Feedback toast when clicking social link */}\n            {socialFeedback && (\n              <p className=\"mt-2 text-[11px] text-[#71AC16] font-medium animate-fadeIn\">\n                Connecting to {socialFeedback}...\n              </p>\n            )}\n          </div>\n\n          {/* ========================================================\n              COLUMN 2: QUICK LINKS\n              - Heading: Quick Links\n              - Items:\n                \342\200\242 Home\n                \342\200\242 Our gym location\n                \342\200\242 Contact Us\n                \342\200\242 Privacy policy\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Quick Links\n            </h3>\n\n            <ul className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={scrollToTop}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Home\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveModal(\"location\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Our gym location\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveModal(\"contact\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Contact Us\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveModal(\"privacy\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Privacy policy\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* ========================================================\n              COLUMN 3: OUR SERVICE\n              - Heading: Our Service\n              - Items:\n                \342\200\242 Indoor gym\n                \342\200\242 Outdoor gym\n                \342\200\242 On ground gym\n                \342\200\242 Yoga class\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Our Service\n            </h3>\n\n            <ul className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenService(\"Indoor gym\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Indoor gym\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenService(\"Outdoor gym\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Outdoor gym\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenService(\"On ground gym\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  On ground gym\n                </button>\n              </li>\n\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={() => handleOpenService(\"Yoga class\")}\n                  className=\"hover:text-neutral-900 hover:translate-x-0.5 transition-all text-left cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#71AC16] rounded\"\n                >\n                  Yoga class\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* ========================================================\n              COLUMN 4: CONTACT INFO\n              - Heading: Contact Info\n              - Mail: info@example.com\n              - Call: +91 9876543210\n              - Location: New York, 235 Lane, 10001\n              - Time: Workout Hours: 5AM - 8PM\n             ======================================================== */}\n          <div className=\"flex flex-col\">\n            <h3 className=\"text-lg sm:text-xl font-bold tracking-tight text-neutral-900 mb-3 sm:mb-4\">\n              Contact Info\n            </h3>\n\n            <div className=\"flex flex-col space-y-2 sm:space-y-2.5 text-xs sm:text-[13px] md:text-sm text-neutral-600\">\n              {/* Mail */}\n              <div className=\"flex items-center flex-wrap gap-1.5 group\">\n                <span className=\"font-semibold text-neutral-900\">Mail:</span>\n                <a\n                  href=\"mailto:info@example.com\"\n                  className=\"hover:text-neutral-900 hover:underline transition-colors\"\n                >\n                  info@example.com\n                </a>\n                <button\n                  type=\"button\"\n                  onClick={handleCopyEmail}\n                  className=\"text-neutral-400 hover:text-neutral-900 transition-colors p-0.5 rounded cursor-pointer\"\n                  title=\"Copy email to clipboard\"\n                  aria-label=\"Copy email\"\n                >\n                  {copiedMail ? (\n                    <Check className=\"w-3.5 h-3.5 text-[#71AC16]\" />\n                  ) : (\n                    <Copy className=\"w-3.5 h-3.5\" />\n                  )}\n                </button>\n                {copiedMail && (\n                  <span className=\"text-[10px] text-[#71AC16] font-semibold\">\n                    Copied!\n                  </span>\n                )}\n              </div>\n\n              {/* Call */}\n              <div className=\"flex items-center flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900\">Call:</span>\n                <a\n                  href=\"tel:+919876543210\"\n                  className=\"hover:text-neutral-900 hover:underline transition-colors tabular-nums\"\n                >\n                  +91 9876543210\n                </a>\n              </div>\n\n              {/* Location */}\n              <div className=\"flex items-start flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900 shrink-0\">\n                  Location:\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveModal(\"location\")}\n                  className=\"text-left hover:text-neutral-900 hover:underline transition-colors cursor-pointer\"\n                >\n                  New York, 235 Lane, 10001\n                </button>\n              </div>\n\n              {/* Workout Hours Time */}\n              <div className=\"flex items-baseline flex-wrap gap-1.5\">\n                <span className=\"font-semibold text-neutral-900 shrink-0\">\n                  Time:\n                </span>\n                <span className=\"text-neutral-700\">\n                  Workout Hours: 5AM - 8PM\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* \n          3. CENTER DIVIDER LINE\n          Matches the exact centered divider from the user\'s reference screenshot\n        */}\n        <div className=\"mt-8 sm:mt-10 md:mt-12 mb-5 sm:mb-6 flex justify-center\">\n          <div className=\"w-40 sm:w-60 md:w-80 border-t border-neutral-300\" />\n        </div>\n\n        {/* \n          4. BOTTOM COPYRIGHT TEXT & QUICK TO-TOP\n          Matches screenshot:\n          \"websitename.com\302\2512024 all right reserve\"\n        */}\n        <div className=\"pb-8 sm:pb-10 flex flex-col sm:flex-row items-center justify-center relative text-center\">\n          <p className=\"text-xs sm:text-[13px] text-neutral-500 font-normal tracking-tight\">\n            websitename.com\302\2512024 all right reserve\n          </p>\n\n          {/* Quick Back to Top affordance at the bottom right */}\n          <button\n            type=\"button\"\n            onClick={scrollToTop}\n            className=\"mt-3 sm:mt-0 sm:absolute sm:right-0 inline-flex items-center gap-1 text-[11px] font-semibold text-neutral-400 hover:text-neutral-900 transition-colors p-1.5 rounded cursor-pointer\"\n            title=\"Scroll to top of page\"\n            aria-label=\"Back to top\"\n          >\n            <span>Top</span>\n            <ArrowUp className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* ========================================================\n          MODAL 1: CONTACT US\n         ======================================================== */}\n      {activeModal === \"contact\" && (\n        <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn\">\n          <div className=\"bg-white rounded-2xl max-w-md w-full p-6 sm:p-7 shadow-2xl relative border border-neutral-200 text-neutral-900\">\n            <button\n              onClick={() => setActiveModal(\"none\")}\n              className=\"absolute top-4 right-4 p-1.5 rounded-full text-neutral-400 hover:text-neutral-900 hover:bg-neutral-100 transition-colors cursor-pointer\"\n              aria-label=\"Close modal\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-2\">\n              <div className=\"w-8 h-8 rounded-full bg-[#71AC16]/15 text-[#71AC16] flex items-center justify-center\">\n                <Mail className=\"w-4 h-4\" />\n              </div>\n              <h4 className=\"text-lg font-bold\">Contact MuscleForge</h4>\n            </div>\n\n            <p className=\"text-xs text-neutral-600 mb-4\">\n              Have questions about memberships, personal training, or programs?\n              Send us a message and our team will get back to you within 24 hours.\n            </p>\n\n            {contactSent ? (\n              <div className=\"py-8 text-center flex flex-col items-center justify-center space-y-2\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center\">\n                  <Check className=\"w-6 h-6\" />\n                </div>\n                <h5 className=\"font-bold text-neutral-900\">Message Delivered!</h5>\n                <p className=\"text-xs text-neutral-600\">\n                  Thank you for reaching out. We will contact you shortly.\n                </p>\n              </div>\n            ) : (\n              <form onSubmit={handleSendContact} className=\"space-y-3\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-neutral-700 mb-1\">\n                    Your Name\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={contactForm.name}\n                    onChange={(e) =>\n                      setContactForm({ ...contactForm, name: e.target.value })\n                    }\n                    placeholder=\"Alex Morgan\"\n                    className=\"w-full px-3 py-2 text-xs rounded-lg border border-neutral-300 focus:border-black focus:ring-1 focus:ring-black outline-none\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-neutral-700 mb-1\">\n                    Email Address\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={contactForm.email}\n                    onChange={(e) =>\n                      setContactForm({ ...contactForm, email: e.target.value })\n                    }\n                    placeholder=\"alex@example.com\"\n                    className=\"w-full px-3 py-2 text-xs rounded-lg border border-neutral-300 focus:border-black focus:ring-1 focus:ring-black outline-none\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-neutral-700 mb-1\">\n                    Message (Optional)\n                  </label>\n                  <textarea\n                    rows={3}\n                    value={contactForm.message}\n                    onChange={(e) =>\n                      setContactForm({ ...contactForm, message: e.target.value })\n                    }\n                    placeholder=\"Tell us what you\'re looking for...\"\n                    className=\"w-full px-3 py-2 text-xs rounded-lg border border-neutral-300 focus:border-black focus:ring-1 focus:ring-black outline-none resize-none\"\n                  />\n                </div>\n\n                <div className=\"pt-2 flex items-center justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveModal(\"none\")}\n                    className=\"px-4 py-2 text-xs font-semibold text-neutral-600 hover:text-neutral-900 rounded-lg hover:bg-neutral-100 transition-colors\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2 text-xs font-bold text-white bg-black hover:bg-neutral-800 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer shadow-md\"\n                  >\n                    <span>Send Message</span>\n                    <Send className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </form>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================\n          MODAL 2: PRIVACY POLICY\n         ======================================================== */}\n      {activeModal === \"privacy\" && (\n        <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn\">\n          <div className=\"bg-white rounded-2xl max-w-lg w-full p-6 sm:p-7 shadow-2xl relative border border-neutral-200 text-neutral-900 max-h-[85vh] overflow-y-auto\">\n            <button\n              onClick={() => setActiveModal(\"none\")}\n              className=\"absolute top-4 right-4 p-1.5 rounded-full text-neutral-400 hover:text-neutral-900 hover:bg-neutral-100 transition-colors cursor-pointer\"\n              aria-label=\"Close modal\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-3\">\n              <div className=\"w-8 h-8 rounded-full bg-[#71AC16]/15 text-[#71AC16] flex items-center justify-center\">\n                <ShieldCheck className=\"w-4 h-4\" />\n              </div>\n              <h4 className=\"text-lg font-bold\">Privacy Policy</h4>\n            </div>\n\n            <div className=\"text-xs text-neutral-600 space-y-3 leading-relaxed\">\n              <p>\n                <strong>Effective Date:</strong> January 2025\n              </p>\n              <p>\n                At <strong>MuscleForge</strong>, your privacy is paramount. This\n                policy explains how we gather, utilize, and protect your personal\n                details when you visit our website, subscribe to our fitness\n                newsletter, or visit our facilities.\n              </p>\n              <h5 className=\"font-bold text-neutral-900 text-xs\">\n                1. Information We Collect\n              </h5>\n              <p>\n                We only collect information directly submitted by you\342\200\224such as\n                your name, email address, and workout preferences\342\200\224when you sign\n                up for trial passes, book personal training sessions, or join our\n                newsletter.\n              </p>\n              <h5 className=\"font-bold text-neutral-900 text-xs\">\n                2. Use of Information\n              </h5>\n              <p>\n                We use your information exclusively to deliver training updates,\n                manage gym memberships, provide customer support, and communicate\n                club schedules. We never sell or lease your personal information\n                to third parties.\n              </p>\n              <h5 className=\"font-bold text-neutral-900 text-xs\">\n                3. Data Security\n              </h5>\n              <p>\n                We employ industry-standard encryption protocols and secure\n                storage architectures to safeguard your data against\n                unauthorized access or alteration.\n              </p>\n              <h5 className=\"font-bold text-neutral-900 text-xs\">4. Contact</h5>\n              <p>\n                For questions regarding your data or to request data removal,\n                email our privacy compliance team at{\" \"}\n                <span className=\"font-medium text-neutral-900\">\n                  info@example.com\n                </span>\n                .\n              </p>\n            </div>\n\n            <div className=\"mt-5 pt-3 border-t border-neutral-200 flex justify-end\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveModal(\"none\")}\n                className=\"px-4 py-2 text-xs font-bold text-white bg-black hover:bg-neutral-800 rounded-lg transition-colors cursor-pointer\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================\n          MODAL 3: OUR GYM LOCATION\n         ======================================================== */}\n      {activeModal === \"location\" && (\n        <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn\">\n          <div className=\"bg-white rounded-2xl max-w-md w-full p-6 sm:p-7 shadow-2xl relative border border-neutral-200 text-neutral-900\">\n            <button\n              onClick={() => setActiveModal(\"none\")}\n              className=\"absolute top-4 right-4 p-1.5 rounded-full text-neutral-400 hover:text-neutral-900 hover:bg-neutral-100 transition-colors cursor-pointer\"\n              aria-label=\"Close modal\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-3\">\n              <div className=\"w-8 h-8 rounded-full bg-[#71AC16]/15 text-[#71AC16] flex items-center justify-center\">\n                <MapPin className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h4 className=\"text-lg font-bold\">Flagship Gym Location</h4>\n                <p className=\"text-xs text-neutral-500\">\n                  New York Athletic Headquarters\n                </p>\n              </div>\n            </div>\n\n            {/* Simulated Map Card */}\n            <div className=\"w-full h-36 rounded-xl bg-neutral-100 border border-neutral-300 relative overflow-hidden flex flex-col items-center justify-center p-4 my-3 text-center\">\n              <div className=\"absolute inset-0 opacity-15 bg-[radial-gradient(#71AC16_1px,transparent_1px)] [background-size:12px_12px]\" />\n              <div className=\"relative z-10 flex flex-col items-center\">\n                <div className=\"w-9 h-9 rounded-full bg-[#71AC16] text-white flex items-center justify-center shadow-lg mb-1.5\">\n                  <MapPin className=\"w-5 h-5\" />\n                </div>\n                <p className=\"text-xs font-bold text-neutral-900\">\n                  MuscleForge Athletic Club\n                </p>\n                <p className=\"text-[11px] text-neutral-600\">\n                  New York, 235 Lane, 10001\n                </p>\n              </div>\n            </div>\n\n            <div className=\"space-y-2 text-xs text-neutral-600 mb-4\">\n              <div className=\"flex items-center gap-2\">\n                <Clock className=\"w-3.5 h-3.5 text-[#71AC16] shrink-0\" />\n                <span>\n                  <strong>Workout Hours:</strong> 5:00 AM \342\200\223 8:00 PM Daily\n                </span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <Phone className=\"w-3.5 h-3.5 text-[#71AC16] shrink-0\" />\n                <span>\n                  <strong>Direct Line:</strong> +91 9876543210\n                </span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <Mail className=\"w-3.5 h-3.5 text-[#71AC16] shrink-0\" />\n                <span>\n                  <strong>Reception:</strong> info@example.com\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-neutral-200\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  window.open(\n                    \"https://maps.google.com/?q=New+York+10001\",\n                    \"_blank\"\n                  );\n                }}\n                className=\"px-4 py-2 text-xs font-semibold text-neutral-700 hover:text-black border border-neutral-300 rounded-lg flex items-center gap-1.5 hover:bg-neutral-50 transition-colors\"\n              >\n                <span>Google Maps</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setActiveModal(\"none\")}\n                className=\"px-4 py-2 text-xs font-bold text-white bg-black hover:bg-neutral-800 rounded-lg transition-colors cursor-pointer\"\n              >\n                Got It\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================\n          MODAL 4: SERVICE DETAILS\n         ======================================================== */}\n      {activeModal === \"service\" && selectedService && (\n        <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn\">\n          <div className=\"bg-white rounded-2xl max-w-md w-full p-6 sm:p-7 shadow-2xl relative border border-neutral-200 text-neutral-900\">\n            <button\n              onClick={() => setActiveModal(\"none\")}\n              className=\"absolute top-4 right-4 p-1.5 rounded-full text-neutral-400 hover:text-neutral-900 hover:bg-neutral-100 transition-colors cursor-pointer\"\n              aria-label=\"Close modal\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 mb-2\">\n              <div className=\"w-8 h-8 rounded-full bg-[#71AC16]/15 text-[#71AC16] flex items-center justify-center\">\n                <Dumbbell className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] font-bold uppercase tracking-wider text-[#71AC16]\">\n                  {selectedService.category}\n                </span>\n                <h4 className=\"text-base font-bold leading-tight\">\n                  {selectedService.title}\n                </h4>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-neutral-600 my-3 leading-relaxed\">\n              {selectedService.description}\n            </p>\n\n            <div className=\"bg-neutral-50 rounded-xl p-3 border border-neutral-200/80 mb-3 space-y-1.5\">\n              <p className=\"text-[11px] font-bold text-neutral-800 uppercase tracking-wider\">\n                Equipment & Highlights:\n              </p>\n              <ul className=\"text-xs text-neutral-600 space-y-1\">\n                {selectedService.features.map((feat, idx) => (\n                  <li key={idx} className=\"flex items-center gap-1.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#71AC16] shrink-0\" />\n                    <span>{feat}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            <div className=\"flex items-center justify-between text-xs text-neutral-500 pt-2 border-t border-neutral-200\">\n              <span>{selectedService.timing}</span>\n              <button\n                type=\"button\"\n                onClick={() => setActiveModal(\"contact\")}\n                className=\"px-3.5 py-1.5 font-bold text-white bg-black hover:bg-neutral-800 rounded-lg transition-colors cursor-pointer text-xs\"\n              >\n                Inquire Pass\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </footer>\n  );\n};\n\nexport default FooterSection;\n"
    num_lines: 826
    num_bytes: 34966
  }
}
