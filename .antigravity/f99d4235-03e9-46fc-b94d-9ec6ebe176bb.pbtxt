    end_line: 53
    content: "@import \"tailwindcss\";\n\nhtml {\n  scroll-behavior: smooth;\n  font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n}\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n\n  body {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, button, input, a {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n}\n\n/* Custom text stroke utilities for the Power Your Potential outline typography */\n.text-stroke-white {\n  -webkit-text-stroke: 2px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-sm {\n  -webkit-text-stroke: 1.25px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-thick {\n  -webkit-text-stroke: 3px rgba(255, 255, 255, 0.98);\n  color: transparent;\n}\n\n.font-tilt {\n  font-family: \'Satoshi\', sans-serif;\n}\n\n/* Glassmorphism subtle backdrop */\n.glass-pill {\n  background: rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.28);\n}\n\n.glass-pill:hover {\n  background: rgba(255, 255, 255, 0.22);\n  border-color: rgba(255, 255, 255, 0.5);\n}\n"
    raw_content: "@import \"tailwindcss\";\n\nhtml {\n  scroll-behavior: smooth;\n  font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n}\n\n@layer base {\n  *, ::before, ::after {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n\n  body {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, button, input, a {\n    font-family: \'Satoshi\', \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n}\n\n/* Custom text stroke utilities for the Power Your Potential outline typography */\n.text-stroke-white {\n  -webkit-text-stroke: 2px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-sm {\n  -webkit-text-stroke: 1.25px rgba(255, 255, 255, 0.95);\n  color: transparent;\n}\n\n.text-stroke-white-thick {\n  -webkit-text-stroke: 3px rgba(255, 255, 255, 0.98);\n  color: transparent;\n}\n\n.font-tilt {\n  font-family: \'Satoshi\', sans-serif;\n}\n\n/* Glassmorphism subtle backdrop */\n.glass-pill {\n  background: rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.28);\n}\n\n.glass-pill:hover {\n  background: rgba(255, 255, 255, 0.22);\n  border-color: rgba(255, 255, 255, 0.5);\n}\n"
